	quest.2BDEE0C216FF1411.title: "&6Pumpkin Valley"
	quest.2C85C0E959B0CB00.quest_desc: ["&fCraft a &eWallet&f and put it in the wallet slot of your inventory. Picked-up coins go straight in; better wallets hold more and can auto-convert."]
