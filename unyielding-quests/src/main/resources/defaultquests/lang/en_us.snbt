	quest.D241F3DF3A963772.quest_desc: [
		"&fTrainers wander the world and challenge you on sight. Gym leaders, Elite Four members and champions belong to a &eseries&f: &bKanto&f (Radical Red), &bSinnoh&f (BDSP) and &bBorrius&f (Unbound)."
		"&7Find a &eTrainer Association&f NPC (or use a Trainer Card) to pick your series. Only trainers of your current series spawn, in order: beat the leaders to unlock the next ones."
		"&7Each series below is its own path. Do them in any order."
	]
	quest.D241F3DF3A963772.quest_subtitle: "&7NPC trainers, gym leaders, the Elite Four and champions"
	quest.D241F3DF3A963772.title: "&eThe Trainer League"
