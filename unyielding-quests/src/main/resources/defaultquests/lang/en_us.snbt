	quest.DB4FC0C631557382.title: "&bWarp Scrolls"
	quest.DBA5B681D9137E1B.quest_desc: ["&fDefeat &eBruno&f of the Kanto Elite Four. The Elite Four use full teams of strong Fighting-type Pokémon."]
