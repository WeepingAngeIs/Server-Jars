	quest.DBC3484400AC51C7.title: "&4Behind the Scenes"
	quest.DC2E54C367157DF0.quest_desc: ["&fWild Pokémon can attack you in the open and your own Pokémon fight back. With a &ePoké Staff&f you can order your sent-out Pokémon: attack a target, use a move, hold position."]
	quest.DC2E54C367157DF0.quest_subtitle: "&7Fight or Flight: command your Pokémon outside battle"
	quest.DC2E54C367157DF0.title: "&cPoké Staff"
