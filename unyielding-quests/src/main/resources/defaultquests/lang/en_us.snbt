	quest.4D4A343E9683147D.quest_desc: [
		"&fYou began your journey as a fragile traveler, clutching a fragile Bestiary and fleeing at the distant roar of wings."
		""
		"&fYou have slain the gorgon, outsmarted the cyclops, navigated siren waters, conquered the desert worms, felled wild sky beasts, excavated the ancient underground broods, hatched your own wyrmling, and forged the legendary &6Dragonsteel&f upon dragon breath."
		""
		"&dThe skies, the earth, and the icy deep are yours to command. You stand as the undisputed Master of Ice and Fire!&f"
	]
	quest.4D4A343E9683147D.quest_subtitle: "&7Conqueror of myths, sovereign of dragons"
	quest.4D4A343E9683147D.title: "&6★ Ruler of Ice and Fire"
