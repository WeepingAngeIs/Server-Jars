	quest.4A6CD6E673195717.quest_subtitle: "&7Obtain any one z-ring style"
	quest.4A6CD6E673195717.title: "&eZ-Ring Styles"
	quest.4A7EF0B740CAB888.quest_desc: [
		"&fTerastallization activates a Pokémon's &bTera Type&f during battle, changing how its typing and same-type attacks interact."
		""
		"&fThe required path teaches the Tera Orb, verifies a real Terastallization, and then asks you to change a Pokémon's Tera Type."
	]
	quest.4A7EF0B740CAB888.quest_subtitle: "&7Activate a Pokémon's Tera Type and reshape its battle typing"
	quest.4A7EF0B740CAB888.title: "&b✦ Terastallization"
	quest.4B06D351390ED20E.quest_desc: [
		"&fCatch &dTornadus&f to add this rare Pokémon to your legendary field record."
