	quest.4F395F4C9FCB4315.quest_desc: [
		"&fSpectral cutlasses born from the nether gloom:"
		""
		"• &7Wraithfang:&f Cutlass granting spectral leaps, haste, and damage immunity on right-click."
		"• &5Wraithmaw:&f Corrupted form born when &5The Devourer&f consumes a dropped Wraithfang, raining down ghostly cutlass barrages."
	]
	quest.4F395F4C9FCB4315.quest_subtitle: "&7Spectral leaps and raining ethereal cutlass barrages"
	quest.4F395F4C9FCB4315.title: "&7Wraith Armaments"
	quest.4F5E0E16CB39278E.quest_desc: [
