	quest.D4DCCD7F11AA2ECA.title: "&6Tier 6: Even Further Beyond"
	quest.DB4FC0C631557382.quest_desc: ["&fA &eWarp Scroll&f teleports you to any waystone once, a &eReturn Scroll&f to the last one you used, a &eBound Scroll&f to one specific waystone you bound it to."]
