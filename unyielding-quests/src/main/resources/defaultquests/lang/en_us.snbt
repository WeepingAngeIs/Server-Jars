	quest.009DCACDEAA9D39E.quest_desc: [
		"&fThe final and most perilous dungeon is the &eGold Dungeon&f. It manifests as a massive spherical island encased in Golden Oak roots and surrounded by golden clouds, built from fiery &cHellfire Stone&f."
		""
		"&fWithin its scorching chambers dwell swarms of &cFire Minions&f that hurl searing fireballs."
		""
		"&ePreparation:&f Wear high-defense armor and pack ample healing supplies, as the master of this realm commands the power of the celestial sun itself."
	]
	quest.009DCACDEAA9D39E.quest_subtitle: "&7Gold Dungeon Floating in Golden Oaks"
	quest.009DCACDEAA9D39E.title: "&eThe Blazing Sun Sphere"
	quest.00A98426FE461D72.quest_desc: [
		"&fThe &9Alpha Yeti&f is an enormous, territorial beast guarding the central chamber of the Yeti Cave."
		""
		"&bTactics:&f"
		"&f• The Alpha Yeti charges and throws players across the cavern."
		"&f• When it enters a furious rampage, it hurls explosive &eIce Bombs&f in all directions and causes giant stalactites of ice to rain down from the ceiling."
		"&f• Once its rampage ends, it tires out and collapses briefly—rush in to deal heavy melee damage!"
		""
		"&aAcquiring Alpha Yeti Fur dispels the deadly blizzard&f guarding the towering Glacier beyond!"
	]
	quest.00A98426FE461D72.quest_subtitle: "&7Rage of the frost caverns"
	quest.00A98426FE461D72.title: "&9The Abominable Chieftain: Alpha Yeti"
	quest.00AC201D587D1DFB.quest_desc: [
		"&fA terrifying scythe feeding upon soul energy. Rips the souls from defeated enemies to heal the wielder and power dark spell arts."
	]
	quest.00AC201D587D1DFB.quest_subtitle: "&7Soul-reaping scythe harvesting ethereal vitality"
	quest.00AC201D587D1DFB.title: "&3Soulrender"
	quest.00B0294F99E1022F.quest_desc: [
		"&fObtain &eany one type z-crystal from set i&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.00B0294F99E1022F.quest_subtitle: "&7Obtain any one type z-crystal from set i"
	quest.00B0294F99E1022F.title: "&eType Z-Crystals I"
	quest.00CBE38FB3360E49.quest_desc: [
		"&fCatch &dPoipole&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.00CBE38FB3360E49.quest_subtitle: "&7Catch Poipole"
	quest.00CBE38FB3360E49.title: "&dPoipole"
	quest.00CDEBDE1E21F380.quest_desc: [
		"&fMedium Relics focus on stacking combat procs and elemental bonuses. This category also includes the jeweled figurines displayed beside them."
		""
		"&7Acknowledge this guide to unlock the Medium and Figurine collections. Their quests may be completed in any order."
	]
	quest.00CDEBDE1E21F380.quest_subtitle: "&7Mid-tier procs and jeweled figurines"
	quest.00CDEBDE1E21F380.title: "&bMedium Relics and Figurines"
	quest.022125ECEA5E6B4D.quest_desc: [
		"&fEmbedded rarely within the Gloomslate and Sculk Stone walls are nodes of &6Crystallized Amber&f."
		""
		"&fThese golden translucent blocks encapsulate prehistoric organic material. Hover over the item in your inventory to see what ancient surprise lies trapped within the resin!"
	]
	quest.022125ECEA5E6B4D.quest_subtitle: "&7Gems encapsulating forgotten organisms"
	quest.022125ECEA5E6B4D.title: "&6Preserved in Time"
	quest.02D8CA978E55F061.quest_desc: [
		"&fSuperior Relics create powerful area and zone effects that support allies and control demanding encounters."
		""
		"&7Acknowledge this guide to unlock the Superior collection. The four relic quests may then be completed in any order."
	]
	quest.02D8CA978E55F061.quest_subtitle: "&7Apex area and zone effects for difficult battles"
	quest.02D8CA978E55F061.title: "&6Superior Relics"
	quest.036D7606E6EE538B.quest_desc: [
		"&fCarry the colossal &eGiant's Pickaxe&f back down into the depths of the Troll Caves."
		""
		"&fNormal pickaxes cannot scratch the &8Giant Obsidian Vault&f, but the Giant's Pickaxe shatters it with ease!"
		""
		"&aResting inside the vault is the Lamp of Cinders&f, an artifact infused with eternal flame capable of incinerating the supernatural brambles blocking the Final Plateau."
	]
	quest.036D7606E6EE538B.quest_subtitle: "&7Breaking the unbreakable giant obsidian"
	quest.036D7606E6EE538B.title: "&6The Vault of Cinders"
	quest.0385EF57ACAB8BE9.quest_desc: [
		"&fNot every wilderness encounter needs to begin with an aggressive Tackle."
		""
		"&ePoké Bait&f can be placed or tossed onto the ground to attract wild Pokémon to specific spots, keeping nervous species from fleeing while you position yourself for capture."
		""
		"&ePoké Snacks&f pacify aggressive predators and satisfy wild Pokémon. Feeding your owned party Pokémon snacks steadily increases their &bFriendship (Happiness)&f, crucial for evolutions like Eevee, Riolu, and Togepi!"
	]
	quest.0385EF57ACAB8BE9.quest_subtitle: "&7Luring, Calming, and Friending"
	quest.0385EF57ACAB8BE9.title: "&eWild Etiquette: Baits and Snacks"
	quest.0406591847628E21.quest_desc: [
		"&fCatch &dRegirock&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0406591847628E21.quest_subtitle: "&7Catch Regirock"
	quest.0406591847628E21.title: "&dRegirock"
	quest.0445EAC212EC2BAA.quest_desc: [
		"&fRaise a Pokémon to &5Dynamax Level 10&f."
		""
		"&fThis marks mastery of the Dynamax Candy progression before the branch moves into Gigantamax preparation."
	]
	quest.0445EAC212EC2BAA.quest_subtitle: "&7Train one Pokémon all the way to Dynamax Level 10"
	quest.0445EAC212EC2BAA.title: "&5Maxed Dynamax Level"
	quest.048D4F2D0874F3FD.quest_desc: [
		"&fHigh-yield agriculture demands fertile earth. By combining organic refuse, soil, and biological waste, you can formulate &eOrganic Compost&f."
		""
		"&fWhen placed in warm conditions with access to water and air, compost slowly ferments into &eRich Soil&f. Farmland tilled from Rich Soil does not require water hydration and actively accelerates crop maturity cycles."
		""
		"&aTip:&f Mushrooms also thrive on un-tilled Rich Soil even under high light levels, forming a self-sustaining mushroom colony."
	]
	quest.048D4F2D0874F3FD.quest_subtitle: "&7Turning kitchen scraps into bountiful harvests"
	quest.048D4F2D0874F3FD.title: "&eEnriching the Soil"
	quest.0493EB4A4EF38FCE.quest_desc: [
		"&fIn a &bSmithing Table&f, combine a &dRunic Tablet&f (template), a &eNetherite Longsword&f (base), and a &bDiamond&f (addition) to forge an unidentified &dRunic Longsword&f."
		""
		"&fClick the resulting blade in your inventory to unveil its randomly rolled &bRunic Power&f! Runic weapons permanently roll an innate mystic power from the runic power pool while retaining their weapon type and implicit trait."
		""
		"&a✦ Tip:&f Runic weapons can be repaired in an anvil using &eNetherite Ingots&f."
	]
	quest.0493EB4A4EF38FCE.quest_subtitle: "&7Infused with runic runes and mystic enchantments"
	quest.0493EB4A4EF38FCE.title: "&dRunic Imbuing"
	quest.04AB2E12457E52BD.quest_desc: [
		"&fCatch &dWalking Wake&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.04AB2E12457E52BD.quest_subtitle: "&7Catch Walking Wake"
	quest.04AB2E12457E52BD.title: "&dWalking Wake"
	quest.04C8284ED0930BE5.quest_desc: [
		"&fCatch &dPheromosa&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.04C8284ED0930BE5.quest_subtitle: "&7Catch Pheromosa"
	quest.04C8284ED0930BE5.title: "&dPheromosa"
	quest.04EA46E634FE7A4D.quest_desc: [
		"&fFasten Seeker Tentacles onto a reinforced handle to assemble the lethal &eTentacle Spike&f whip."
		""
		"&fWhip weapons feature extended strike reach, allowing you to lash enemies from well beyond their retaliation range while dragging lighter targets off balance."
	]
	quest.04EA46E634FE7A4D.quest_subtitle: "&7Lacerating reach of the void"
	quest.04EA46E634FE7A4D.title: "&3The Abyssal Lash"
	quest.04F33F021A6F94EA.quest_desc: [
		"&fExtracted directly from the chest of the slain Warden, the &dHeart of the Deep&f pulses with resonant acoustic energy."
		""
		"&fWhen held in your inventory, it emits an audible heartbeat that intensifies near ancient structures, serving as an acoustic compass in subterranean caverns."
		""
		"&aCrucial:&f This artifact is the catalyst needed to ignite the dormant gateway at the center of the Ancient City, and later serves to forge the devastating &bSonorous Staff&f."
	]
	quest.04F33F021A6F94EA.quest_subtitle: "&7Recover the Warden's resonant heart"
	quest.04F33F021A6F94EA.title: "&dHeart of the Deep"
	quest.04F759D9CFE44B45.quest_desc: [
		"&fScattered across the Overworld lie ancient &eStarlight Portal Ruins&f, identifiable by dark voidstone pillars entwined with withered creepers."
		""
		"&fResting at each site is &cThe Gatekeeper&f—a solitary cosmic warrior seated in perpetual vigil. When approached, the Gatekeeper rises to challenge prospective travelers in fierce duel, casting meteor barrages and evasive dashes."
		""
		"&aOvercome the Gatekeeper in honorable combat&f to claim the &eOrb of Prophecy&f, the mystical ignition key required to awaken the gateway."
	]
	quest.04F759D9CFE44B45.quest_subtitle: "&7Confronting The Gatekeeper"
	quest.04F759D9CFE44B45.title: "&eThe Guardian of Ruins"
	quest.05A1345C164645D7.quest_desc: [
		"&fFound buried within the shimmering crystalline passages of the Glittering Cave in Kalos:"
		""
		"&e• Jaw Fossil&f: The bone-crushing mandible of &bTyrunt&f, a miniature tyrannosaur featuring Strong Jaw that evolves into the thunderous tyrant king, &cTyrantrum&f."
		"&e• Sail Fossil&f: The radiant dorsal sail of &bAmaura&f, an arctic sauropod carrying Refrigerate that evolves into &bAurorus&f, capable of summoning atmospheric diamond dust!"
		""
		"&aRoyalty and elegance preserved across the epochs.&f"
	]
	quest.05A1345C164645D7.quest_subtitle: "&7Jaw and Sail Fossils"
	quest.05A1345C164645D7.title: "&6Kalos Prehistorics: Tyrant and Aurora"
	quest.05AAEB7B168BFD49.quest_subtitle: "Obtain 1 of every standard poke ball"
	quest.05AAEB7B168BFD49.title: "&cPoke balls"
	quest.0630586914122A00.quest_desc: [
		"&fTwo legendary forge-born armaments of blazing heat:"
		""
		"• &cFlamewind:&f Whirls spinning fire tornadoes on right-click that engulf targets in searing vortices."
		"• &cHearthflame:&f Greathammer that tethers foes with molten chains and detonates in fiery shockwaves."
		""
		"&aDiscovery:&f Find them in nether bastions or offer Contained Remnants to a &bBlast Furnace&f or &bFurnace&f!"
	]
	quest.0630586914122A00.quest_subtitle: "&7Fiery twin relics of cyclone and volcanic anvil"
	quest.0630586914122A00.title: "&cForge and Firestorm"
	quest.06700B7C160392F4.quest_desc: [
		"&fTerastallize a Pokémon in battle."
		""
		"&fThis verifies that you can actually use the battle phenomenon rather than simply owning the enabling item."
	]
	quest.06700B7C160392F4.quest_subtitle: "&7Activate any Pokémon's Tera Type in battle"
	quest.06700B7C160392F4.title: "&b★ Terastallize"
	quest.07171B589E7DF3D1.quest_desc: [
		"&fThe &bBridging System&r allows for beautiful river crossings. "
		""
		"&fPlace your bridge blocks, then use &bPliers&r to toggle between &7Log&r, &dRope&r, or &8Stone&r styles. Don't forget to add &7Piers&r for structural support in deep water!"
	]
	quest.07171B589E7DF3D1.quest_subtitle: "&7Build and style a bridge span"
	quest.07171B589E7DF3D1.title: "&eCrossing the Gap&r"
	quest.079EBF22B54691CF.quest_desc: [
		"&fComplete every type-registration trial to finish this mastery chapter."
	]
	quest.079EBF22B54691CF.quest_subtitle: "&7All 18 type trials completed"
	quest.079EBF22B54691CF.title: "&6Complete Type Mastery&r"
	quest.080F3AFCE5562A92.quest_desc: [
		"&fObtain &eany one mega accessory style&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.080F3AFCE5562A92.quest_subtitle: "&7Obtain any one mega accessory style"
	quest.080F3AFCE5562A92.title: "&dMega Accessory Styles"
	quest.0822C7DF09D3EF31.quest_desc: [
		"&fA golden chalice relic etched with divine prayer runes."
		""
		"&fProc effect: Casting healing spells has a chance to proc extra &aHealing Power&f, supercharging follow-up restorative spells."
		""
		"&fA staple for dedicated Clerics and Paladins keeping party members alive during raid-style encounters."
	]
	quest.0822C7DF09D3EF31.quest_subtitle: "&aGrace Divine"
	quest.0822C7DF09D3EF31.title: "&bMedium Mender's Relic"
	quest.082A67FE075F15CD.quest_desc: [
		"&cCrucial Harvesting Rule:&f Before stripping all the bones from a fresh dragon carcass, you can harvest its elemental blood!"
		""
		"&bRight-click the corpse with an Empty Glass Bottle&f to bottle &cFire Dragon Blood&f (or Ice/Lightning Dragon Blood depending on the species). Each bottle drawn reduces the remaining meat, so balance your harvest carefully."
		""
		"&fDragon Blood is an extraordinary reagent used to enchant dragonbone weapons and fuel the endgame &eDragon Forge&f."
	]
	quest.082A67FE075F15CD.quest_subtitle: "&7Bottling the essence of destruction"
	quest.082A67FE075F15CD.title: "&4Extracting Dragon Blood"
	quest.084AC8C3494D9FCE.quest_desc: [
		"&fBronze Dungeons generate inside the rocky flanks of massive floating islands, identified by prominent entrances carved from &6Carved Stone&f."
		""
		"&fInside lies an extensive multi-room subterranean maze filled with deadly threats:"
		"&c• Sentries:&f Floating spherical automatons that detonate or charge when disturbed."
		"&4• Mimics:&f Deceptive wooden chests that sprout fangs and strike whenever unsuspecting adventurers attempt to open them!"
	]
	quest.084AC8C3494D9FCE.quest_subtitle: "&7Bronze Dungeon Beneath the Cliffs"
	quest.084AC8C3494D9FCE.title: "&6Labyrinth of the Depths"
	quest.084EF4BFFB9CDAF1.quest_desc: [
		"&fIn traditional Minecraft, upgrading a storage chest meant breaking it, scattering hundreds of items across the floor, crafting the new box, and reorganizing everything."
		""
		"&eTier Upgrade items eliminate that nightmare entirely&f."
		""
		"&fSimply hold a &eBasic to Iron Tier Upgrade&f (or respective tier) and &bright-click directly on any placed chest or barrel in the world&f. The block instantly transforms, expanding its slots and upgrade sockets on the spot with zero item loss!"
	]
	quest.084EF4BFFB9CDAF1.quest_subtitle: "&7Upgrading capacity without breaking containers"
	quest.084EF4BFFB9CDAF1.title: "&eLive Refitting"
	quest.084F575AE6E61118.quest_desc: [
		"&fWild Moas cannot be tamed with saddles—they are too wild to be broken. To obtain a loyal mount, you must hatch one from an egg."
		""
		"&fCraft an &6Incubator&f from Holystone and Ambrosium Torches. Fueled by &eAmbrosium Torches&f placed in the lower chamber, the Incubator generates constant radiant heat to safely hatch fragile Moa Eggs."
	]
	quest.084F575AE6E61118.quest_subtitle: "&7Artificial Hatchery for Legendary Avian Steeds"
	quest.084F575AE6E61118.title: "&6Warming the Clutch"
	quest.084F8BA7B3FF879D.quest_desc: [
		"&fSlain dragons provide scales for durable &eDragonscale Armor&f with high armor and toughness."
		"&fDragonscale Armor reduces damage from fire, ice and lightning dragons regardless of the scales' color; the color is a visual choice rather than an elemental lock."
	]
	quest.084F8BA7B3FF879D.quest_subtitle: "&7Armor that withstands dragon fire"
	quest.084F8BA7B3FF879D.title: "&4Impenetrable Dragonscales"
	quest.084FBE217E663557.quest_desc: [
		"&fEach dragon egg type requires a distinct elemental environment to hatch:"
		""
		"&c• Fire Dragon Egg:&f Place the egg upon a block of &eNetherrack&f and set it on fire. Keep the flames burning continuously."
		"&b• Ice Dragon Egg:&f Submerge the egg inside water completely surrounded by &eIce Blocks&f until the water freezes."
		"&e• Lightning Dragon Egg:&f Place the egg outdoors uncovered in the open air during active &eRain or a Thunderstorm&f."
		""
		"&fThe egg will begin to rock and crack for several minutes before bursting open into a newborn baby wyrmling! Right-click it with a &eDragon Command Staff&f to tame and bond with it."
	]
	quest.084FBE217E663557.quest_subtitle: "&7Awakening life from elemental fury"
	quest.084FBE217E663557.title: "&6The Primordial Incubation"
	quest.0862088B6D24901F.quest_desc: [
		"&fRegister &e30 Dark-type Pokémon&r&f in your Pokédex."
		""
		"&7Dual-type Pokémon count when Dark is one of their types."
	]
	quest.0862088B6D24901F.quest_subtitle: "&7Register 30 Dark-type Pokémon"
	quest.0862088B6D24901F.title: "&6Dark Mastery&r"
	quest.08789CCC97F22DEC.quest_desc: [
		"&fThe ocean depths are filled with aquatic ingredients that can be turned into soothing maritime delicacies through &bOcean's Delight&f."
		""
		"&eCooked Stuffed Squid&f restores &b8 hunger points&f and bestows the soothing &eComfort&f effect for &b1 minute&f."
		""
		"&bComfort Mechanic:&f While Comfort is active, your body slowly regenerates natural health regardless of your hunger level, keeping you healthy even under continuous physical exertion."
	]
	quest.08789CCC97F22DEC.quest_subtitle: "&7Maritime cuisine and constant comfort"
	quest.08789CCC97F22DEC.title: "&3Catch of the Deep: Stuffed Squid"
	quest.088E7A40CD462E29.quest_desc: [
		"&fObtain &eany one johto mega stone&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.088E7A40CD462E29.quest_subtitle: "&7Obtain any one johto mega stone"
	quest.088E7A40CD462E29.title: "&dJohto Mega Stones"
	quest.0893281244B7CFA7.quest_desc: [
		"&eChipped&r provides incredible variety but requires specific &6Workbenches&r for each material type."
		""
		"&fStart with the &6Carpenter's Table&r. It handles every type of wood in the game, providing hundreds of carved, paneled, and mosaic options."
	]
	quest.0893281244B7CFA7.quest_subtitle: "&7Explore decorative wood variants"
	quest.0893281244B7CFA7.title: "&eThe Woodshop&r"
	quest.089BC7BDD97A8D7B.quest_desc: [
		"&fTowering high above the frozen glacier stands the breathtaking &dAurora Palace&f, crafted entirely from color-shifting Aurora Blocks."
		""
		"&fAscend through its vertical spiral corridors, dodging Ice Golems and Snow Guardians. Mine a sample of shimmering &dAurora Blocks&f as proof of your ascent."
		""
		"&7At the pinnacle chamber of the palace waits the frozen sovereign of the realm."
	]
	quest.089BC7BDD97A8D7B.quest_subtitle: "&7Glistening spires above the glacier"
	quest.089BC7BDD97A8D7B.title: "&dPalace of the Aurora"
	quest.08CD8D2639C885F6.quest_desc: [
		"&fJade displays information for whatever you are looking at. It should be a box at the top of your screen. You can toggle it on and off with &eNumpad 1&f."
	]
	quest.08CD8D2639C885F6.title: "&aJade Tooltips"
	quest.08DD03721B905401.quest_desc: [
		"&fObtain &eany one hoenn mega stone&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.08DD03721B905401.quest_subtitle: "&7Obtain any one hoenn mega stone"
	quest.08DD03721B905401.title: "&dHoenn Mega Stones"
	quest.08E85D1F88CAA384.quest_desc: [
		"&3Sculk Grime&f generates along cavern floors and lake basins, acting like a damp, clinging silt."
		""
		"&fDigging it up yields &eGrime Balls&f, which can be packed and fired into smooth, water-resistant &bSculk Grime Bricks&f for atmospheric base construction."
	]
	quest.08E85D1F88CAA384.quest_subtitle: "&7Harvesting sculk grime and pressing bricks"
	quest.08E85D1F88CAA384.title: "&3Viscous Sediment"
	quest.08EB8D026A5EB5F1.quest_desc: [
		"&fObtain a &aHealing Machine&f, place it at your base and interact with it to recover your party between trips."
		"&fUse &bEMI&f for its recipe."
	]
	quest.08EB8D026A5EB5F1.quest_subtitle: "&7Reliable recovery turns a shelter into a trainer base"
	quest.08EB8D026A5EB5F1.title: "&aBuild a Healing Machine"
	quest.09228F22135492FC.quest_desc: [
		"&fCatch &dXurkitree&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.09228F22135492FC.quest_subtitle: "&7Catch Xurkitree"
	quest.09228F22135492FC.title: "&dXurkitree"
	quest.094086209A925680.quest_desc: [
		"&fObtain &eany one mega meteorite ore&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.094086209A925680.quest_subtitle: "&7Obtain any one mega meteorite ore"
	quest.094086209A925680.title: "&dMega Geology"
	quest.09A8815C101DF5AC.quest_desc: [
		"&fTo begin your journey into the &2Twilight Forest&f, you must construct a magical gateway."
		""
		"&b1.&f Dig a &e2x2 pool of water&f in the ground (4 water blocks)."
		"&b2.&f Surround the pool completely with &e12 flowers, mushrooms, or plants&f."
		"&b3.&f Toss a &bDiamond&f into the pool."
		""
		"&aLightning will strike the pool, transforming the water into a shimmering portal.&f Jump in to enter a mystical dimension trapped in perpetual twilight!"
		""
		"&bPokémon Field Notes"
		"&fThe forest habitats can support &ePhantump&f. The &eSnowy Forest&f is included in the habitat tags for &eAlolan Vulpix&f, while Enchanted Forest and Firefly Forest support a &eClefairy&f habitat entry."
		"&fThese entries require &esuitable natural ground and skylight 8-15&f. Search open areas; a biome match alone does not guarantee an encounter under a dark canopy."
		"&7These are ordinary species and regional forms with matching habitats, not special Twilight-only skins. Follow the dimension's boss progression before exploring protected biomes."
	]
	quest.09A8815C101DF5AC.quest_subtitle: "&7Step into the eternal twilight"
	quest.09A8815C101DF5AC.title: "&2The Twilight Realm"
	quest.09BC70328F30BD0F.quest_desc: [
		"&fPeriodically, violent celestial storms rack the upper atmosphere, raining blazing &eAethersent Meteors&f across the landscape."
		""
		"&fTrack the impact trails and dig into the resulting craters to uncover &eRaw Aethersent&f. This miraculous cosmic mineral can be smelted into ingots that command gravity and cosmic trajectory."
		""
		"&bAethersent Arrows pierce continuously through lines of enemies without stopping."
	]
	quest.09BC70328F30BD0F.quest_subtitle: "&7Celestial gifts from the heavens"
	quest.09BC70328F30BD0F.title: "&dShower of Falling Stars"
	quest.09D2D4D56EEFC3B5.quest_desc: [
		"&fObtain &eany one type z-crystal from set ii&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.09D2D4D56EEFC3B5.quest_subtitle: "&7Obtain any one type z-crystal from set ii"
	quest.09D2D4D56EEFC3B5.title: "&eType Z-Crystals II"
	quest.09F7EE3D3C9F6256.quest_desc: [
		"&fA virulent katana dripping with ancient plague. Slices spread debilitating poison and decaying sickness across entire clusters of enemies."
	]
	quest.09F7EE3D3C9F6256.quest_subtitle: "&7Plague-bearing blade spreading contagious toxins"
	quest.09F7EE3D3C9F6256.title: "&2Toxic Longsword"
	quest.0A424AAE253FAB67.quest_desc: [
		"&fCrafted using sculk components, &fLite Blocks&f and &fBordered Lite Blocks&f provide clean, modern, and constant light level 15 illumination."
		""
		"&fThey generate no ambient noise or particles, ensuring safe lighting in environments where acoustic stealth is paramount."
	]
	quest.0A424AAE253FAB67.quest_subtitle: "&7Illuminate the dark without noise"
	quest.0A424AAE253FAB67.title: "&fLite Blocks"
	quest.0A96725CEF7660AB.quest_desc: [
		"&fObtain a &5Power Spot&f."
		""
		"&fPower Spots represent the special battle environment associated with Dynamax and provide the field-side step before testing the transformation."
	]
	quest.0A96725CEF7660AB.quest_subtitle: "&7Establish the field condition associated with Dynamax"
	quest.0A96725CEF7660AB.title: "&5Power Spot"
	quest.0AB96CF3FA9EE843.quest_desc: [
		"&fCatch &dGenesect&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0AB96CF3FA9EE843.quest_subtitle: "&7Catch Genesect"
	quest.0AB96CF3FA9EE843.title: "&dGenesect"
	quest.0AD22A138885AD39.quest_desc: [
		"&fThe installed &eCobblemon Pots&f integration adds berry and apricorn crop recipes. Collect an &eOran Berry, Leppa Berry, or Red Apricorn Seed&f to explore a useful example."
		"&fFind that item's Botany Pots recipe in EMI, add its accepted soil and plant it. Choose recovery berries for supplies or apricorns for Poké Ball crafting."
		"&7This task collects planting material, not a recorded pot harvest. You can keep a normal berry orchard alongside the pots."
	]
	quest.0AD22A138885AD39.quest_subtitle: "&7Cobblemon Pots adds useful trainer crops."
	quest.0AD22A138885AD39.title: "&eBerries and Apricorns"
	quest.0AED153E105F2773.quest_desc: [
		"&fAn impenetrable fortress seal imbued with ancient titan magic."
		""
		"&fActive ability: Projects a protective aura granting heavy &9Defense&f and continuous &aHealth Regeneration&f to everyone inside."
		""
		"&fForms an unyielding safe zone that can save an entire party from wipe-out mechanics."
	]
	quest.0AED153E105F2773.quest_subtitle: "&9Sanctuary of Iron and Life"
	quest.0AED153E105F2773.title: "&6Superior Bastion Standard"
	quest.0B1F9163CE9FF57F.quest_desc: [
		"&fDeep within the labyrinthine corridors of the Ancient Temple dwells the terrifying &4Stalker&f (also occasionally awoken by smashing Ancient Vases)."
		""
		"&fThe Stalker possesses formidable armor defense, rapid gap-closing movement, and merciless melee strikes."
		""
		"&fSlaying the Stalker yields the precious &bSoul Crystal&f—the ultimate acoustic focus required to craft the Sonorous Staff, Soul Elytra, and endgame alloys."
	]
	quest.0B1F9163CE9FF57F.quest_subtitle: "&7Slaying the Stalker for its Soul Crystal"
	quest.0B1F9163CE9FF57F.title: "&4The Temple Lurker"
	quest.0B2E15BFBEB6EB67.quest_desc: [
		"&fNether ingredients create deeply restorative survival rations capable of resisting environmental hazards."
		""
		"&eStrider Stew&f restores &b8 hunger points&f and grants &bFire Resistance for 40 seconds&f alongside &b1 minute of Nourishment&f."
		""
		"&cWarning:&f 40 seconds of Fire Resistance is a short emergency buffer to clamber out of lava falls—it is &lnot&r a permanent bath ticket!"
		""
		"&fFor everyday travel, dishes like the &eNether Burger&f offer massive hunger restoration (12 points) with great saturation."
	]
	quest.0B2E15BFBEB6EB67.quest_subtitle: "&7Surviving the fires below"
	quest.0B2E15BFBEB6EB67.title: "&4Volcanic Stews: Strider Stew"
	quest.0B56A2B3D55A2D2B.quest_desc: [
		"&fFew disasters sting worse than dying in the deep void or a distant dimension and watching hours of hard-won loot vanish into oblivion."
		""
		"&fSlotting the &dEverlasting Upgrade&f into your backpack makes it truly indestructible:"
		"&f• Will never despawn when dropped as an item entity."
		"&f• Cannot be destroyed by explosions, lightning, or fire."
		"&f• Immune to falling into the void."
		""
		"&aPair this with your highest tier backpack for complete peace of mind on extreme expeditions.&f"
	]
	quest.0B56A2B3D55A2D2B.quest_subtitle: "&7A backpack that refuses to be lost"
	quest.0B56A2B3D55A2D2B.title: "&dBound Beyond Death"
	quest.0B5706115B7EFA01.quest_desc: [
		"&fObtain a &dKeystone&f. It is the central Trainer-side catalyst used by Mega Evolution equipment."
		""
		"&fWith the Keystone secured, the next step is placing that power into a usable Mega accessory."
	]
	quest.0B5706115B7EFA01.quest_subtitle: "&7The Trainer-side catalyst at the heart of Mega Evolution"
	quest.0B5706115B7EFA01.title: "&dKeystone"
	quest.0B5DB05680190520.quest_desc: [
		"&fReaching &eDiamond&f tier represents the peak of standard craftable weaponry. Diamond weapons deliver heavy offensive stats, rugged durability, and peak scaling for implicit abilities."
		""
		"&fCrafting your first &eDiamond Longsword&f unlocks the wider spectrum of diamond weapon forms across the armory. Master your preferred blade before seeking subterranean alloy upgrades."
	]
	quest.0B5DB05680190520.quest_subtitle: "&7Enduring brilliance and cutting force"
	quest.0B5DB05680190520.title: "&fDiamond Standard"
	quest.0BB8F013D772059E.quest_desc: [
		"&fA lead-weighted iron pendant blessed by dwarven smiths."
		""
		"&fPassively elevates your &bMelee Critical Strike Damage&f multiplier."
		""
		"&fWhile it does not boost your crit rate, every strike that does confirm a critical hit lands with crushing, armor-cleaving force."
	]
	quest.0BB8F013D772059E.quest_subtitle: "&bHeavy Carnage"
	quest.0BB8F013D772059E.title: "&fLesser Melee Critical Damage"
	quest.0BD78F0D52A0C68C.quest_desc: [
		"&fPushing the Tainted Relic to &bLevel 8&f inside the Runic Forge triggers an ominous apotheosis: the sword transforms into &4Harbinger&f."
		""
		"&fAn apocalyptic weapon of pure abyssal wrath, crushing enemy defenses and draining their life essence."
	]
	quest.0BD78F0D52A0C68C.quest_subtitle: "&7Fully awakened at Level 8 — An apocalyptic calamity"
	quest.0BD78F0D52A0C68C.title: "&4★ Harbinger"
	quest.0C0124A5249E9D39.quest_desc: [
		"&fPlace an &eAgronomic Sourcelink&f near growing crops or trees and a &eSource Jar&f nearby. The link produces Source from natural growth and sends it to jars within five blocks."
		"&fKeep the crops within fifteen blocks of the link. Magical plants can improve production, but ordinary crops are a useful starting point."
		"&cBonemeal growth does not generate Source for this link.&f Allow the plants to grow naturally."
	]
	quest.0C0124A5249E9D39.quest_subtitle: "&7Let growing plants power your workshop."
	quest.0C0124A5249E9D39.title: "&aSource from Your Garden"
	quest.0C09DE2068F64857.quest_desc: [
		"&fUse a &eZ-Move&f in battle."
		""
		"&fThis proves the complete system works: Trainer equipment, a compatible crystal, a compatible move and the battle action itself."
	]
	quest.0C09DE2068F64857.quest_subtitle: "&7Trigger Z-Power in an actual battle"
	quest.0C09DE2068F64857.title: "&e★ Unleash a Z-Move"
	quest.0C11EDEC44D240C1.quest_desc: [
		"&fThe &6Macaw's Suite&r introduces complex 3D models for structural building. "
		""
		"&fYou will need two primary tools: the &bRoofing Hammer&r (to shape slopes and gutters) and the &bPliers&r (to connect and style bridge segments)."
	]
	quest.0C11EDEC44D240C1.quest_subtitle: "&7Prepare the tools used by Macaw's building sets"
	quest.0C11EDEC44D240C1.title: "&eThe Engineer's Tools&r"
	quest.0C28F6772E276F16.quest_desc: [
		"&fCatch &dDiancie&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0C28F6772E276F16.quest_subtitle: "&7Catch Diancie"
	quest.0C28F6772E276F16.title: "&dDiancie"
	quest.0C881E3E588A7098.quest_desc: [
		"&fCatch &dZygarde&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0C881E3E588A7098.quest_subtitle: "&7Catch Zygarde"
	quest.0C881E3E588A7098.title: "&dZygarde"
	quest.0CC82D42835D8A32.quest_desc: [
		"&fThis pack uses &bOpen Parties and Claims&f. Press &eM &fto open your map and right click an area to &dclaim selected &farea."
		"&fUse the command &b/oparties create &fto create a party then &b/oparties member invite player &fto trust someone into your claim."
	]
	quest.0CC82D42835D8A32.quest_subtitle: "&7Protect builds and share access deliberately"
	quest.0CC82D42835D8A32.title: "&aProtect Your Base"
	quest.0D173E474E34977A.quest_desc: [
		"&fA verdant rapier overgrown with wild briars. On strike, wraps enemies in suffocating thorn vines that bleed and root them in place."
	]
	quest.0D173E474E34977A.quest_subtitle: "&7Briar-entangled rapier rooting enemies in place"
	quest.0D173E474E34977A.title: "&2Bramblethorn"
	quest.0D3B74540DC83417.quest_desc: [
		"&fHidden in secret treasure chests inside the Ancient Temple lies the rarest blueprint in the realm: the &5Warden Upgrade Smithing Template&f."
		""
		"&fThis template allows you to transcend Netherite gear, binding Reinforced Echo Shards to forge Warden-tier armor and weapons."
		""
		"&aDuplication:&f Place the template in a crafting table surrounded by &b7 Diamonds&f and a block of &8Gloomslate&f to duplicate it."
	]
	quest.0D3B74540DC83417.quest_subtitle: "&7Unearthing the Warden Upgrade Smithing Template"
	quest.0D3B74540DC83417.title: "&5The Monarch's Blueprint"
	quest.0D469558DB184F25.quest_desc: [
		"&fCatch &dDeoxys&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0D469558DB184F25.quest_subtitle: "&7Catch Deoxys"
	quest.0D469558DB184F25.title: "&dDeoxys"
	quest.0D58D3F30EF397C3.quest_desc: [
		"&fYou have explored every dimension of Pokémon equipment: from EV training power belts and breeding lineage knots, to endurance bulwarks, choice locks, weather rocks, and status orbs."
		""
		"&6The Final Trial:&f"
		"&fEquip your team with their ideal competitive battle gear, enter the arena, and &adefeat 25 Pokémon in battle&f to prove that your tactical preparations are unmatched!"
		""
		"&dReward:&f Claim the ultimate &dMaster Ball&f and Rare Candies for completing the Battle Gear compendium!"
	]
	quest.0D58D3F30EF397C3.quest_subtitle: "&7The Ultimate Convergence of Strategy and Gear"
	quest.0D58D3F30EF397C3.title: "&6Master Tactician: The Battle Champion"
	quest.0D7B1E99CF2AB524.quest_desc: [
		"&fCatch &dKoraidon&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0D7B1E99CF2AB524.quest_subtitle: "&7Catch Koraidon"
	quest.0D7B1E99CF2AB524.title: "&dKoraidon"
	quest.0D95A59FD3783777.quest_desc: [
		"&fWith the &4Hydra&f, &cUr-Ghast&f, and &bSnow Queen&f all vanquished, the elemental locks sealing the central &eTwilight Highlands&f finally crumble!"
		""
		"&fThe highlands are an ancient, mist-shrouded plateau biome home to trolls underground and giants above the clouds."
		""
		"&aYou stand on the threshold of the Twilight Forest's endgame.&f Prepare for the final ascent!"
	]
	quest.0D95A59FD3783777.quest_subtitle: "&7The three great trials fulfilled"
	quest.0D95A59FD3783777.title: "&eThe Highlands: Path to the Summit"
	quest.0DD320459D623036.quest_desc: [
		"&fCatch &dPalkia&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0DD320459D623036.quest_subtitle: "&7Catch Palkia"
	quest.0DD320459D623036.title: "&dPalkia"
	quest.0DDD246AAF717A3B.quest_desc: [
		"&fPresss &eM &fto open the full map. Press &e. &fto create a waypoint and right click the waypoint to delete it. You can use &eNumpad 7 &fto manage all your waypoints."
	]
	quest.0DDD246AAF717A3B.quest_subtitle: "See everywhere you've been before."
	quest.0DDD246AAF717A3B.title: "&aXaero's Maps and Waypoints"
	quest.0E0BE7B65178FF48.quest_desc: [
		"&fThe &bFreezer&f is crafted from Holystone, Skyroot Planks, and an &bIcestone&f core."
		""
		"&fUsing Icestone as its cooling fuel, this workstation flash-freezes volatile matter:"
		"&b• Solidification:&f Freezes water buckets into Ice, lava buckets into Obsidian, and Cold Aerclouds into buoyant Blue Aerclouds."
		"&d• Cryogenic Relics:&f Freezes Iron and Golden rings or pendants into &bIce Rings&f and &bIce Pendants&f, granting cryogenic travel abilities."
	]
	quest.0E0BE7B65178FF48.quest_subtitle: "&7Sub-Zero Thermal Processing"
	quest.0E0BE7B65178FF48.title: "&bGlacial Preservation"
	quest.0E8844D9420AA2A7.quest_desc: [
		"&fCatch &dTerrakion&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0E8844D9420AA2A7.quest_subtitle: "&7Catch Terrakion"
	quest.0E8844D9420AA2A7.title: "&dTerrakion"
	quest.0E941D56199E5726.quest_desc: [
		"&fObtain &eany one tera shard from set i&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.0E941D56199E5726.quest_subtitle: "&7Obtain any one tera shard from set i"
	quest.0E941D56199E5726.title: "&bTera Shards I"
	quest.0EAC67BA382D4EB4.quest_desc: [
		"&fCatch &dKartana&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0EAC67BA382D4EB4.quest_subtitle: "&7Catch Kartana"
	quest.0EAC67BA382D4EB4.title: "&dKartana"
	quest.0EACEA20E8CE63C1.quest_desc: [
		"&fThe &6Altar&f (historically known as the Enchanter) is crafted by surrounding a &dZanite Gemstone&f with Holystone."
		""
		"&fFueled exclusively by &eAmbrosium Shards&f or &eAmbrosium Blocks&f, the Altar performs divine alchemy:"
		"&b• Transmutation:&f Enchants raw Aether materials into blessed forms—such as infusing Gravitite Ore into Enchanted Gravitite, turning Cold Aerclouds into Golden Aerclouds, or empowering Darts."
		"&a• Durability Repair:&f Placing damaged tools, weapons, or armor into the Altar will slowly restore their durability to mint condition without consuming anvil levels!"
	]
	quest.0EACEA20E8CE63C1.quest_subtitle: "&7Restoration and Transmutation"
	quest.0EACEA20E8CE63C1.title: "&6Divine Infusion"
	quest.0F27F2296DC2C9D0.quest_desc: [
		"&fThe &eSpear&f provides unmatched frontal reach, keeping creepers, ravagers, and aggressive monsters at safe distance."
		""
		"&fBoasts the &bArmor Piercing&f implicit, bypassing a flat portion of enemy armor values on every strike."
	]
	quest.0F27F2296DC2C9D0.quest_subtitle: "&7Superior reach that skewers straight through armor"
	quest.0F27F2296DC2C9D0.title: "&fDiamond Spear"
	quest.0FADA38CB4F7AAA0.quest_desc: [
		"&fNormal vanilla maps fail to chart the supernatural enchantments of the Twilight Forest."
		""
		"&fTo navigate the realm, craft a &bMagic Map Focus&f by combining a &eRaven Feather&f (from ravens in the canopy), &eGlowstone Dust&f, and &eTorchberries&f (found hanging from hollow roots)."
		""
		"&aSurround the focus with 8 Paper&f to craft a &bMagic Map&f. This map reveals biomes, progression landmarks, and boss dungeon icons across the realm."
	]
	quest.0FADA38CB4F7AAA0.quest_subtitle: "&7Unraveling the labyrinthine forest"
	quest.0FADA38CB4F7AAA0.title: "&bCartography of the Canopy"
	quest.0FDED4DECACEE987.quest_desc: [
		"&eMalarite&f is an abundant subterranean mineral found embedded in grimstone and nightfall mud deposits deep beneath the surface."
		""
		"&fTools forged from Malarite boast exceptional durability and heavy impact force, making them excellent workhorse implements for spelunking."
		""
		"&bSave a healthy reserve of Malarite&f, as it acts as the binding structural agent when creating advanced alloys in the Alloy Furnace."
	]
	quest.0FDED4DECACEE987.quest_subtitle: "&7Sturdy stone-veined metal"
	quest.0FDED4DECACEE987.title: "&6Malarite Strata"
	quest.0FF6564D2DD6ED73.quest_desc: [
		"&fCatch &dLugia&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.0FF6564D2DD6ED73.quest_subtitle: "&7Catch Lugia"
	quest.0FF6564D2DD6ED73.title: "&dLugia"
	quest.10034EE483CD76D4.quest_desc: [
		"&fTake an &eEye of Void&f into the End to locate a &eRuined Citadel&f. Secure your route across the islands before entering the structure."
		"&fWork through the citadel to its guardian. Save room to move during the fight, and do not bring irreplaceable travel equipment without a recovery plan."
		"&aDefeat the boss to complete this milestone.&f"
	]
	quest.10034EE483CD76D4.quest_subtitle: "&7Ruined Citadel"
	quest.10034EE483CD76D4.title: "&bEnder Guardian"
	quest.105C7F4792F28AAE.quest_desc: [
		"&fAs expeditions stretch deeper into hazardous lands, a standard leather pouch quickly runs out of room."
		""
		"&fUpgrading your backpack increases both &einternal inventory slots&f and &bupgrade module sockets&f:"
		"&f• &6Copper Backpack&f: 45 slots, 1 upgrade slot"
		"&f• &fIron Backpack&f: 54 slots, 2 upgrade slots"
		"&f• &eGold Backpack&f: 81 slots, 3 upgrade slots"
		"&f• &bDiamond Backpack&f: 108 slots, 5 upgrade slots"
		""
		"&aYou can upgrade backpacks directly in a crafting table without losing any items stored inside!&f"
	]
	quest.105C7F4792F28AAE.quest_subtitle: "&7From modest pouch to armored vault"
	quest.105C7F4792F28AAE.title: "&fExpanding Horizons"
	quest.10E773B2BEB86625.quest_desc: [
		"&fLesser Relics provide straightforward passive bonuses, combat procs and useful active effects for an early relic loadout."
		""
		"&7Acknowledge this guide to unlock the Lesser collection. The relic quests may then be completed in any order."
	]
	quest.10E773B2BEB86625.quest_subtitle: "&7Early relics for basic combat bonuses and utility"
	quest.10E773B2BEB86625.title: "&7Lesser Relics"
	quest.1173C5880A6EB8C5.quest_desc: [
		"&fCatch &dMunkidori&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.1173C5880A6EB8C5.quest_subtitle: "&7Catch Munkidori"
	quest.1173C5880A6EB8C5.title: "&dMunkidori"
	quest.118DFF2016357228.quest_desc: [
		"&fBy processing standard metal jewelry inside the &bFreezer&f, you create chilled relics imbued with perennial frost."
		""
		"&fEquipping an &bIce Ring&f or &bIce Pendant&f in your Curios/Accessory slot freezes water and lava beneath your feet into temporary ice and obsidian paths as you walk!"
		""
		"&aThis allows effortless traversal across subterranean lava pools and perilous sky lakes without touching the deadly fluid."
	]
	quest.118DFF2016357228.quest_subtitle: "&7Striding Across Liquid Chasms"
	quest.118DFF2016357228.title: "&bFrostwalker Relics"
	quest.11CE5DD2B45ED1F0.quest_desc: [
		"&fA swirling dimensional vortex trapped inside a crystalline ring."
		""
		"&fProc effect: Continuous spellcasting triggers a transcendent &dSpell Trance&f, providing immense Spell Haste and Spell Power."
		""
		"&fAllows mages to enter an uninterrupted state of catastrophic rapid casting against boss encounters."
	]
	quest.11CE5DD2B45ED1F0.quest_subtitle: "&dThe Sorcerer's Ascendance"
	quest.11CE5DD2B45ED1F0.title: "&dGreater Arcane Trance Relic"
	quest.11E4E583B04304D1.quest_desc: [
		"&fBy fusing materials from both the Overworld and The Otherside, you create the highest-tier catalyst in the mod:"
		""
		"&eRecipe:&f"
		"&b• 4 Warden Carapace&f"
		"&b• 4 Phantom Membrane&f"
		"&b• 1 Echo Shard&f"
		""
		"&fThe resulting &dReinforced Echo Shard&f is completely fireproof and ready to feed the smithing table."
	]
	quest.11E4E583B04304D1.quest_subtitle: "&7Create an endgame smithing catalyst"
	quest.11E4E583B04304D1.title: "&dReinforced Echo Shards"
	quest.11FC03CFE52989BD.quest_desc: [
		"&fAn &eEye of Flame&f points toward the &eBurning Arena&f in the Nether. Explore the arena and obtain its summoning materials before attempting Ignis."
		"&fThe &eBurning Ashes&f and &eAltar of Fire&f are part of this encounter. Prepare first, then use the ashes at the altar when you are ready."
		"&aDefeat the boss to complete this milestone.&f"
	]
	quest.11FC03CFE52989BD.quest_subtitle: "&7Burning Arena"
	quest.11FC03CFE52989BD.title: "&bIgnis"
	quest.123237D6F35400B2.quest_desc: [
		"&fRegister &e30 Dragon-type Pokémon&r&f in your Pokédex."
		""
		"&7Dual-type Pokémon count when Dragon is one of their types."
	]
	quest.123237D6F35400B2.quest_subtitle: "&7Register 30 Dragon-type Pokémon"
	quest.123237D6F35400B2.title: "&6Dragon Mastery&r"
	quest.129B4413E9EDD432.quest_desc: [
		"&fObtain &eany one z-power foundation item&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.129B4413E9EDD432.quest_subtitle: "&7Obtain any one z-power foundation item"
	quest.129B4413E9EDD432.title: "&eZ-Power Foundations"
	quest.12E10B9D5AEE3EB5.quest_desc: [
		"&fCatch &dEternatus&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.12E10B9D5AEE3EB5.quest_subtitle: "&7Catch Eternatus"
	quest.12E10B9D5AEE3EB5.title: "&dEternatus"
	quest.134833B34E0D8FAB.quest_desc: [
		"&fCatch &dShaymin&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.134833B34E0D8FAB.quest_subtitle: "&7Catch Shaymin"
	quest.134833B34E0D8FAB.title: "&dShaymin"
	quest.1380412C3F2A31FB.quest_desc: [
		"&fThe ecosystem of the Aether obeys entirely different natural laws than the Overworld."
		""
		"&fBy crafting a &dBook of Lore&f from &eSkyroot Planks&f and &eAmbrosium Shards&f, you gain access to an invaluable field guide. &bRight-click&f while holding the book and place any Aether item inside to read its history, mechanical properties, and hidden uses."
		""
		"&aKeep it close whenever you encounter an unfamiliar relic or alien blossom."
	]
	quest.1380412C3F2A31FB.quest_subtitle: "&7An Encyclopedia of Floating Wonders"
	quest.1380412C3F2A31FB.title: "&dCodex of the Skies"
	quest.13B51A50E7129A4F.quest_desc: [
		"&fNow that the Lich's curse is lifted, the &6Twilight Swamp&f is safe from suffocating blindness."
		""
		"&fSearch the swamp for hollow mounds leading down into the subterranean &eLabyrinth&f. The corridors are carved from reinforced Mazestone that is nearly unbreakable without specialized tools."
		""
		"&fNavigate past Minotaurs and traps to find food caches containing nutritious &eMaze Wafers&f, and look for secret vault rooms hiding the legendary &bMazebreaker Pickaxe&f!"
	]
	quest.13B51A50E7129A4F.quest_subtitle: "&7Delve into the Mazestone catacombs"
	quest.13B51A50E7129A4F.title: "&6Subterranean Mazes of the Swamp"
	quest.13F9F1EAF3806D6C.quest_desc: [
		"&fForged in molten basalt, this jagged blade melts armor and ignites targets in boiling liquid stone."
	]
	quest.13F9F1EAF3806D6C.quest_subtitle: "&7Jagged blade dripping with boiling magma"
	quest.13F9F1EAF3806D6C.title: "&cMolten Edge"
	quest.14296C07F26B4776.quest_desc: [
		"&fA polished prism that refracts magical energy into all elemental hues."
		""
		"&fProc effect: Dealing spell damage has a chance to proc universal &dSpell Power&f across all spell schools."
		""
		"&fThe premiere general-purpose caster trinket for any aspiring wizard or battlemage."
	]
	quest.14296C07F26B4776.quest_subtitle: "&dUniversal Spell Might"
	quest.14296C07F26B4776.title: "&bMedium Archmage's Relic"
	quest.142C3FE860E7A113.quest_desc: [
		"&fA dense obsidian plate carved with protective guardian faces."
		""
		"&fProc effect: When your health drops below a perilous threshold, procs an immense surge of &9Armor and Damage Resistance&f."
		""
		"&fBuys you precious seconds to drink potions, combat roll to safety, or receive healing."
	]
	quest.142C3FE860E7A113.quest_subtitle: "&9Emergency Shielding"
	quest.142C3FE860E7A113.title: "&dGreater Bulwark of Desperation"
	quest.14868FE456381E19.quest_desc: [
		"&fUpon defeat, the Lich drops one of four legendary magical scepters:"
		""
		"&d• Scepter of Twilight:&f Rapidly discharges concentrated magic missiles (recharged with Ender Pearls)."
		"&d• Scepter of Life Draining:&f Channels a beam that siphons health and replenishes your hunger (recharged with Fermented Spider Eyes)."
		"&d• Zombie Scepter:&f Summons powerful armored zombie minions with temporary strength (recharged with Potions of Strength)."
		"&d• Shield Scepter:&f Surrounds the caster in protective shields that deflect physical damage."
		""
		"&7All four staves are invaluable utility weapons for the three progression branches ahead."
	]
	quest.14868FE456381E19.quest_subtitle: "&7Arcane weaponry dropped by the Lich"
	quest.14868FE456381E19.title: "&5Sorcerous Staves of the Spire"
	quest.14B4668EFE1908C6.quest_desc: [
		"&fA pure pearl cross carved with sacred purification symbols."
		""
		"&fPerk mechanic: Your healing spells automatically &acleanse negative status effects&f (poison, wither, slowness, weakness) from targets."
		""
		"&fAn indispensable tool for dungeon parties facing debuff-heavy bosses and wither skeletons."
	]
	quest.14B4668EFE1908C6.quest_subtitle: "&aCleanse the Afflicted"
	quest.14B4668EFE1908C6.title: "&dGreater Perk: Purifying Wave"
	quest.152F47F86DACFC75.quest_desc: [
		"&fFar beneath the bedrock and deepslate strata lies a forgotten realm twisted by ancient acoustic horrors."
		""
		"&fTo begin your journey into &bThe Otherside&f, you must venture deep into the &3Deep Dark&f biome below Y=0. Prepare yourself with &ewool blocks&f to muffle vibrations, sneak to evade &3Sculk Sensors&f, and search for the monumental ruins of an &eAncient City&f."
		""
		"&cBe warned:&f Silence is your only true shield. Disturbing the sculk will summon an unspeakable nightmare."
		""
		"&bPokémon Field Notes"
		"&fTry the &eEchoing Forest&f for &eShroomish&f. In the waters of the Deeplands, Echoing Forest and Blooming Caverns, &eChinchou&f can appear submerged or through fishing."
		"&fThe &eDeeplands&f has a nighttime &eGastly&f entry. &eNoibat&f has entries across the four Otherside biomes, including Overcast Columns."
		"&7Ground encounters still need suitable natural Otherside blocks. Time-specific entries follow the game's clock even when the dimension looks dark."
	]
	quest.152F47F86DACFC75.quest_subtitle: "&7Find the Ancient City gateway"
	quest.152F47F86DACFC75.title: "&3The Otherside"
	quest.159DF9475EF5BB55.quest_desc: [
		"&fThe rare botanical trophies harvested from the Lunar Monstrosity allow you to assemble exotic boss-tier armaments."
		""
		"&fThe &eMoonring Greatsword&f unleashes devastating wide-arc cleaves that bleed toxic energy into stricken foes. Pair it with the &eChain of Souls&f for unparalleled area-denial combat."
	]
	quest.159DF9475EF5BB55.quest_subtitle: "&7Weapons forged of thorn and bone"
	quest.159DF9475EF5BB55.title: "&5Arsenal of the Eclipse"
	quest.15F368D4BAD00A31.quest_desc: [
		"&fObtain &eany one sinnoh or unova mega stone&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.15F368D4BAD00A31.quest_subtitle: "&7Obtain any one sinnoh or unova mega stone"
	quest.15F368D4BAD00A31.title: "&dSinnoh and Unova Mega Stones"
	quest.1625FF5CBF3FBEC0.title: "Reward references"
	quest.1657F87087476BB8.quest_desc: [
		"&fAn attuned amethyst disk that resonates on high magical frequencies."
		""
		"&fProc mechanic: Casting offensive spells has a chance to proc a brief surge of &bSpell Critical Strike Chance&f."
		""
		"&fPairs exceptionally well with multi-hit or channeled spells like Magic Missiles to trigger rapid chains of critical magic hits."
	]
	quest.1657F87087476BB8.quest_subtitle: "&bOverwhelming Spark"
	quest.1657F87087476BB8.title: "&fLesser Spellcrit Sigil"
	quest.1665DDC0097DA4B7.quest_desc: [
		"&fWhat do you do with duplicate or unneeded Unique Weapons found across your travels? You feed them to the furnace!"
		""
		"&fSmelting any &eUnique Weapon&f in a furnace or blast furnace yields an &eEmpowered Remnant&f. This dense magical slag forms the essential catalyst for crafting socketable &dRunefused&f and &4Netherfused&f gems."
		""
		"&aNever discard surplus relics&f; their residual power can be reshaped into custom sockets for your primary armaments."
	]
	quest.1665DDC0097DA4B7.quest_subtitle: "&7Smelt surplus uniques into raw mystic catalyst"
	quest.1665DDC0097DA4B7.title: "&eEmpowered Remnants"
	quest.168960D9CD2F9DC4.quest_desc: [
		"&fThe default keys are &eF4&f for the voice menu and hold &eCaps Lock &ffor push to talk."
	]
	quest.168960D9CD2F9DC4.quest_subtitle: "&7Proximity chat with optional private groups"
	quest.168960D9CD2F9DC4.title: "&dSimple Voice Chat"
	quest.16C19717D5591AF1.quest_desc: [
		"&fThe Silver Dungeon is a grand classical temple constructed from pristine &fAngelic Stone&f and &eLight Angelic Stone&f, resting majestically upon flat cloud banks."
		""
		"&fWandering its marbled colonnades are honorable &fValkyries&f. These warrior maidens are initially peaceful, but will defend their sanctum with righteous fury if provoked."
	]
	quest.16C19717D5591AF1.quest_subtitle: "&7The Parthenon Resting on White Clouds"
	quest.16C19717D5591AF1.title: "&fPalace of the Valkyries"
	quest.16C1DCB8CA968F17.quest_desc: [
		"&fA &eContained Remnant&f is an enigmatic soul vessel crafted from three Empowered Remnants. When held in your inventory, it slowly incubates over time until it hatches into a random Unique Weapon!"
		""
		"&aDeterministic Awakening:&f You can force a specific unique weapon to emerge by right-clicking the remnant onto specific thematic blocks! For example:"
		"• &bIron Block:&f Mjolnir"
		"• &bSoul Fire:&f Slumbering Lichblade"
		"• &bBlast Furnace:&f Flamewind"
		"• &bCrying Obsidian:&f Watching Warglaive"
		"• &bEnd Portal Frame:&f Caelestis"
	]
	quest.16C1DCB8CA968F17.quest_subtitle: "&7Incubate in inventory or offer to thematic blocks"
	quest.16C1DCB8CA968F17.title: "&eContained Remnant"
	quest.17579892204F63CD.quest_desc: [
		"&fForging the complete suite of &5Unrealium Equipment&f establishes you as the supreme sovereign of the Starlight Dimension."
		""
		"&fUnrealium arms possess monumental durability, immense attack damage, and unmatched defensive toughness that surpasses standard Netherite."
		""
		"&aCongratulations on conquering all trials of Eternal Starlight! Wear your armor with pride under the celestial firmament."
	]
	quest.17579892204F63CD.quest_subtitle: "&7Peerless armor and arms of Unrealium"
	quest.17579892204F63CD.title: "&dMaster of the Stars"
	quest.1801DCF4D12712B5.quest_desc: [
		"&fRegister &e30 Electric-type Pokémon&r&f in your Pokédex."
		""
		"&7Dual-type Pokémon count when Electric is one of their types."
	]
	quest.1801DCF4D12712B5.quest_subtitle: "&7Register 30 Electric-type Pokémon"
	quest.1801DCF4D12712B5.title: "&6Electric Mastery&r"
	quest.186AB527793C5FF1.quest_desc: [
		"&fCatch &dRegidrago&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.186AB527793C5FF1.quest_subtitle: "&7Catch Regidrago"
	quest.186AB527793C5FF1.title: "&dRegidrago"
	quest.18D137D7A321A47C.quest_desc: [
		"&fWith the &6Bronze Dungeon Key&f in hand, unlock the Bronze Treasure Chest in the boss chamber to claim legendary artifacts:"
		""
		"&b• Sentry Boots:&f Heavy boots that nullify fall damage and grant knockback resistance."
		"&d• Cloud Staff:&f Summons miniature cloud minions that seek out and assault hostile mobs."
		"&e• Valkyrie Lance:&f An elongated weapon granting extended melee reach."
		"&6• Hammer of Kingbdogz:&f Unleashes explosive golden projectiles on swinging!"
	]
	quest.18D137D7A321A47C.quest_subtitle: "&7Spoils of the Bronze Dungeon"
	quest.18D137D7A321A47C.title: "&6Labyrinth Vault"
	quest.18E7F01AC09590E8.quest_desc: [
		"&fThe shimmering scales carved from the Naga can be crafted into a &2Naga Scale Tunic&f and &2Naga Scale Leggings&f."
		""
		"&aBoth pieces craft pre-enchanted with Fire Protection III and Protection III&f, providing exceptional survival value in the fiery hazards awaiting deeper in the forest."
	]
	quest.18E7F01AC09590E8.quest_subtitle: "&7Inherent fiery resilience"
	quest.18E7F01AC09590E8.title: "&2Serpent's Carapace"
	quest.19120BBB35270624.quest_desc: [
		"&fNot all chests can sit directly adjacent to one another. Tom's Storage provides two elegant solutions for bridging distances:"
		""
		"&f• &7Storage Trims&f: Inexpensive decorative wooden blocks that act as conductive inventory bridges. Run trims under floors or along walls to connect separated chest clusters."
		"&f• &bInventory Cables and Connectors&f: Run thin cables across your base. Place an &bInventory Cable Connector&f directly against distant chests to join them to the main network without physical proximity."
		""
		"&aFramed cables and trims can even be disguised with custom block textures!&f"
	]
	quest.19120BBB35270624.quest_subtitle: "&7Wiring distant chests and bridging gaps"
	quest.19120BBB35270624.title: "&7Conduits and Architecture"
	quest.19413BC39592104B.quest_desc: [
		"&fCatch &dSpectrier&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.19413BC39592104B.quest_subtitle: "&7Catch Spectrier"
	quest.19413BC39592104B.title: "&dSpectrier"
	quest.19AC5F807C33115B.quest_desc: [
		"&fUse an &eEye of Mech&f to search for an &eAncient Factory&f. Bring a &eNether Star&f for the dormant Harbinger's activation."
		"&fThe enclosed factory leaves limited room to improvise. Clear a route, heal and inspect the chamber before waking the boss."
		"&aDefeat the boss to complete this milestone.&f"
	]
	quest.19AC5F807C33115B.quest_subtitle: "&7Ancient Factory"
	quest.19AC5F807C33115B.title: "&bThe Harbinger"
	quest.19B1FC8DDF14322B.quest_desc: [
		"&fCreate one &eLesser Elemental Focus&f: Air, Earth, Fire or Water. Equip it in the appropriate accessory slot and compare its tooltip with the spells you use."
		"&fA lesser focus strengthens and discounts its own elemental school, but weakens spells from other elemental schools. This is a specialization choice, not an upgrade every spellcaster must make."
		"&aOnly one listed focus is required.&f More advanced foci remain optional goals."
	]
	quest.19B1FC8DDF14322B.quest_subtitle: "&7Ars Elemental rewards specialization."
	quest.19B1FC8DDF14322B.title: "&aChoose an Element"
	quest.19C9FB8B8F89A5EB.quest_desc: [
		"&fWeaving Aethersent into garments grants ethereal agility. The &eAethersent Cape&f and &eAethersent Hood&f deflect incoming projectiles and cushion dangerous impacts."
		""
		"&aDefensive Golems:&f Placing an Aethersent block topped with a carved pumpkin allows you to construct loyal &dAethersent Golems&f that guard your base and intercept falling meteors!"
	]
	quest.19C9FB8B8F89A5EB.quest_subtitle: "&7Hoods, capes, and celestial protectors"
	quest.19C9FB8B8F89A5EB.title: "&dThe Astral Ward"
	quest.19D2B4E63F3B4C58.quest_desc: [
		"&ePasture Block&f: Place down a pasture block and select Pokémon from your PC boxes. They will roam freely in the designated surrounding perimeter, sleeping, grazing, and interacting with their environment."
	]
	quest.19D2B4E63F3B4C58.quest_subtitle: "&7Building Living Ecosystems"
	quest.19D2B4E63F3B4C58.title: "&aPasture blocks"
	quest.19DE2CE7DB41868D.quest_desc: [
		"&fEver had an automated cobble generator or farm overflow because it had no shut-off mechanism?"
		""
		"&fThe &cLevel Emitter&f monitors total stock quantities across your network:"
		"&f• Set a target item and quantity threshold (e.g. 1,000 Iron Ingots)."
		"&f• Emits a redstone signal when inventory count drops below or rises above that number."
		"&f• Connect the redstone signal to automatic farms or smelters to run production only when stocks run low!"
		""
		"&aPair with &eItem Filters&f for advanced polymorphic or tag-based conditional automation.&f"
	]
	quest.19DE2CE7DB41868D.quest_subtitle: "&7Triggering redstone signals based on inventory thresholds"
	quest.19DE2CE7DB41868D.title: "&cStock Sentry"
	quest.19F77DA6A834BB94.quest_desc: [
		"&fCatch &dRegisteel&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.19F77DA6A834BB94.quest_subtitle: "&7Catch Registeel"
	quest.19F77DA6A834BB94.title: "&dRegisteel"
	quest.1A0B43E16D923FF8.quest_desc: [
		"&fAn electric broadsword crackling with static. Swings build electrostatic potential that arcs between adjacent foes."
	]
	quest.1A0B43E16D923FF8.quest_subtitle: "&7Electrostatic blade discharging arcing bolts"
	quest.1A0B43E16D923FF8.title: "&eStorm's Edge"
	quest.1A1088B822793120.quest_desc: [
		"&fMacaw's Roofs allows you to create realistic, sloped roofing. No more stair-block roofs! "
		""
		"&fUse the &bRoofing Hammer&r on a placed roof block to toggle its shape (corners, steepness, etc.) and add &6Gutters&r to manage rain aesthetically."
	]
	quest.1A1088B822793120.quest_subtitle: "&7Build with sloped roof pieces"
	quest.1A1088B822793120.title: "&eRaising the Roof&r"
	quest.1A2A73ED562B0F79.quest_desc: [
		"&fA black dagger pendant engraved with predatory glyphs."
		""
		"&fPerk mechanic: Executing a combat roll substantially buffs the &cdamage of your next strike&f within a brief window."
		""
		"&fEncourages an aggressive dodge-and-strike playstyle where you roll behind an enemy and instantly decapitate them."
	]
	quest.1A2A73ED562B0F79.quest_subtitle: "&cMomentum Execution"
	quest.1A2A73ED562B0F79.title: "&dGreater Perk: Shadow Strike"
	quest.1A3D1FA7BC8960A9.quest_desc: [
		"&fAn ancient heart-shaped talisman carved from crystallized life essence."
		""
		"&fPassively grants a substantial multiplier to all &aHealing Taken&f from all sources."
		""
		"&fMakes healing potions, regen effects, life-steal strikes, and ally heal spells significantly more effective on you."
	]
	quest.1A3D1FA7BC8960A9.quest_subtitle: "&aUnbroken Life Fountain"
	quest.1A3D1FA7BC8960A9.title: "&dGreater Relic of Rejuvenation"
	quest.1A5F65B1942F6EFC.quest_desc: [
		"&fCatch &dGiratina&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.1A5F65B1942F6EFC.quest_subtitle: "&7Catch Giratina"
	quest.1A5F65B1942F6EFC.title: "&dGiratina"
	quest.1AAD7F31B7D111D6.quest_desc: [
		"&fRegister &e80 Normal-type Pokémon&r&f in your Pokédex."
		""
		"&7Dual-type Pokémon count when Normal is one of their types."
	]
	quest.1AAD7F31B7D111D6.quest_subtitle: "&7Register 80 Normal-type Pokémon"
	quest.1AAD7F31B7D111D6.title: "&6Normal Mastery&r"
	quest.1AE59537E999E743.quest_desc: [
		"&fBy fusing &cFiery Blood&f with standard Iron Ingots in a crafting table, you produce incandescent &cFiery Ingots&f."
		""
		"&aFiery equipment possesses innate blaze enchantments:&f"
		"&f• &cFiery Sword:&f Ignites victims for extended fire damage on hit."
		"&f• &cFiery Armor:&f Sets attackers ablaze whenever they strike you in melee combat."
		"&f• &cFiery Pickaxe:&f Inherent Auto-Smelt capability on all mined ores!"
	]
	quest.1AE59537E999E743.quest_subtitle: "&7Forging with the blood of the Hydra"
	quest.1AE59537E999E743.title: "&cMolten Armaments: Fiery Gear"
	quest.1C80317FA3B1799D.quest_desc: [
		"&fFar beneath the bedrock and deepslate strata lies a forgotten realm twisted by ancient acoustic horrors."
		""
		"&fTo begin your journey into &bThe Otherside&f, you must venture deep into the &3Deep Dark&f biome below Y=0. Prepare yourself with &ewool blocks&f to muffle vibrations, sneak to evade &3Sculk Sensors&f, and search for the monumental ruins of an &eAncient City&f."
		""
		"&cBe warned:&f Silence is your only true shield. Disturbing the sculk will summon an unspeakable nightmare."
	]
	quest.1C80317FA3B1799D.quest_subtitle: "&7Descending into the subterranean unknown"
	quest.1C80317FA3B1799D.title: "&bEchoes from the Deep"
	quest.1CB98BF97E078968.quest_desc: [
		"&fRaise a Pokémon to level 20 through battles or experience items as a longer-term training goal."
		"&fOpen &bCatching and Team Training&f for moves, experience sharing and team roles. This milestone is not required to finish First Steps."
	]
	quest.1CB98BF97E078968.quest_subtitle: "&7Finish the opening stretch with a dependable team member"
	quest.1CB98BF97E078968.title: "&eOptional: Train to Level 20"
	quest.1CD381801239CE49.quest_desc: [
		"&fCatch &dKubfu&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.1CD381801239CE49.quest_subtitle: "&7Catch Kubfu"
	quest.1CD381801239CE49.title: "&dKubfu"
	quest.1DC9D08D28793332.quest_desc: [
		"&fAt the center of every Ancient City stands a towering portal frame carved from unbreakable &8Reinforced Deepslate&f."
		""
		"&fTo activate the portal:"
		"&b1.&f Clear away any creeping &3Sculk Veins&f clinging to the inner edges of the frame."
		"&b2.&f Right-click the frame while holding the &dHeart of the Deep&f."
		""
		"&fThe center will burst open into a shimmering teal dimensional rift. Step forward into &5The Otherside&f!"
	]
	quest.1DC9D08D28793332.quest_subtitle: "&7Step across the threshold into The Otherside"
	quest.1DC9D08D28793332.title: "&5The Gateway Beneath Bedrock"
	quest.1DFAEBBB2B4B66BB.quest_desc: [
		"&fScattered across the Aether are three tiers of ancient Dungeons: &6Bronze&f, &fSilver&f, and &eGold&f."
		""
		"&cThe Law of the Sanctuaries:&f The masonry of every dungeon (Carved, Angelic, and Hellfire Stone) is completely &cimmune to mining, explosions, and block breaking&f!"
		""
		"&fYou cannot tunnel into treasure rooms or bypass traps. The dungeon remains completely sealed until you confront and vanquish the ruling Boss at the heart of the lair."
		""
		"&aOnly slaying the dungeon guardian will unlock the doors and surrender the Treasure Key!"
	]
	quest.1DFAEBBB2B4B66BB.quest_subtitle: "&7Rules of Ancient Dungeon Delving"
	quest.1DFAEBBB2B4B66BB.title: "&cThe Unbreakable Sanctuaries"
	quest.1E26D18B43DB83CE.quest_desc: [
		"&fCatch &dGuzzlord&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.1E26D18B43DB83CE.quest_subtitle: "&7Catch Guzzlord"
	quest.1E26D18B43DB83CE.title: "&dGuzzlord"
	quest.1EBA1B81110B285B.quest_desc: [
		"&fGreater Relics introduce stronger perks, defensive reactions, healing effects, crowd control and battle trances that can define an entire build."
		""
		"&7Acknowledge this guide to unlock the Greater collection. The relic quests may then be completed in any order."
	]
	quest.1EBA1B81110B285B.quest_subtitle: "&7Build-defining perks, reactions and battle trances"
	quest.1EBA1B81110B285B.title: "&dGreater Relics"
	quest.1EC8E1C9251842AC.quest_desc: [
		"&fA towering two-handed claymore imbued with runic magic. Unrolls a random Runic Power upon right-clicking after smithing."
		""
		"&fPairing runic powers like &bFaultline&f or &bStoneskin&f with the claymore's huge base damage creates an unstoppable juggernaut."
	]
	quest.1EC8E1C9251842AC.quest_subtitle: "&7Two-handed runic steel with rolled magical warding"
	quest.1EC8E1C9251842AC.title: "&dRunic Claymore"
	quest.1ECEA271020F4C13.quest_desc: [
		"&fCatch one wild Pokemon with a Poke Ball."
	]
	quest.1ECEA271020F4C13.quest_subtitle: "&7Weaken a target, choose a ball, grow the team"
	quest.1ECEA271020F4C13.title: "&aMake Your First Catch"
	quest.1EE861A7C5B0AE75.quest_desc: [
		"&fA nimble, rapid-thrusting blade favored by duelists. Low single-hit damage is compensated by lightning-fast recovery."
		""
		"&fRapiers inherently &bignore armor&f on hits, turning iron golems and armored players into remarkably soft targets."
	]
	quest.1EE861A7C5B0AE75.quest_subtitle: "&7Rapid fencing foil that punches through armor"
	quest.1EE861A7C5B0AE75.title: "&fDiamond Rapier"
	quest.1F1304D936BF3AE7.quest_desc: [
		"&fRaw Resonarium crystals are too brittle to be hammered directly into armor on their own."
		""
		"&fBy fusing &b4 Resonarium Crystals&f with &a4 Turtle Scutes&f in a crafting table, you form flexible, shock-absorbing &eResonarium Plates&f ready for smithing."
	]
	quest.1F1304D936BF3AE7.quest_subtitle: "&7Prepare the crystal for smithing"
	quest.1F1304D936BF3AE7.title: "&bResonarium Plates"
	quest.1F41238044280EE6.quest_desc: [
		"&fObtain &eany one signature z-crystal from set i&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.1F41238044280EE6.quest_subtitle: "&7Obtain any one signature z-crystal from set i"
	quest.1F41238044280EE6.title: "&eSignature Z-Crystals I"
	quest.1F66912B1C7BD4A1.quest_desc: [
		"&fCraft a &eGlassblower&f from Chipped to turn ordinary glass into clear, framed, patterned and tinted architectural variants."
		"&7The Glassblower itself is the required task item."
	]
	quest.1F66912B1C7BD4A1.quest_subtitle: "&7Create decorative glass variants"
	quest.1F66912B1C7BD4A1.title: "&eVitreous Art&r"
	quest.1FD581E6DF447814.quest_desc: [
		"&fCompact three-pronged parrying daggers. Extremely short reach is balanced by blistering attack rate."
		""
		"&fPossesses the &bBackstab&f implicit: attacks dealt directly to an enemy's back inflict massive bonus damage."
	]
	quest.1FD581E6DF447814.quest_subtitle: "&7Blisteringly fast parrying prongs with lethal backstabs"
	quest.1FD581E6DF447814.title: "&fDiamond Sai"
	quest.1FE8544B23B4D004.quest_desc: [
		"&fObtain &eany one alola or paldea mega stone&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.1FE8544B23B4D004.quest_subtitle: "&7Obtain any one alola or paldea mega stone"
	quest.1FE8544B23B4D004.title: "&dModern Mega Stones"
	quest.1FF49B7889463E85.quest_desc: [
		"&fBy fusing materials from both the Overworld and The Otherside, you create the highest-tier catalyst in the mod:"
		""
		"&eRecipe:&f"
		"&b• 4 Warden Carapace&f"
		"&b• 4 Phantom Membrane&f"
		"&b• 1 Echo Shard&f"
		""
		"&fThe resulting &dReinforced Echo Shard&f is completely fireproof and ready to feed the smithing table."
	]
	quest.1FF49B7889463E85.quest_subtitle: "&7Forging the Reinforced Echo Shard"
	quest.1FF49B7889463E85.title: "&dTransmuted Resonance"
	quest.205461898477FD1A.quest_desc: [
		"&cWatch your step!&f Swarming through dark crevices are &3Sculk Leeches&f—tiny parasitic pests that leap toward travelers, inflicting damage while draining vitality."
		""
		"&fHigher up along cavern ceilings skitter immense &8Sculk Centipedes&f, capable of climbing inverted surfaces to drop on unobservant explorers from above."
		""
		"&fBoth creatures drop generous quantities of &eSoul Dust&f upon extermination."
	]
	quest.205461898477FD1A.quest_subtitle: "&7Clear the leeches and centipedes"
	quest.205461898477FD1A.title: "&3Sculk Pests"
	quest.207B5EE734C7A5CA.quest_desc: [
		"&fAt the summit of the colossal &eLich Tower&f awaits the &dTwilight Lich&f, a powerful undead sorcerer."
		""
		"&bThe Battle:&f"
		"&ePhase 1 (Shields):&f The Lich is enveloped in five invulnerable glowing shields. Normal attacks bounce off! You must &bdeflect its projectile ender pearls&f back at him using your weapon to shatter his shields."
		"&ePhase 2 (Clones):&f The Lich summons illusory shadow clones firing homing bolts. Kill the clones quickly with single hits."
		"&ePhase 3 (Melee):&f Once vulnerable, the Lich draws a golden sword and charges in direct combat."
		""
		"&aDefeating the Lich disperses the dark mists&f locking the Swamp, Dark Forest, and Snow biomes!"
	]
	quest.207B5EE734C7A5CA.quest_subtitle: "&7Shatter the spectral shields"
	quest.207B5EE734C7A5CA.title: "&dThe Wizard of the Spire: Twilight Lich"
	quest.207B6045D661ECA7.quest_desc: [
		"&fA razor-sharp talisman crafted from honed predatory fangs."
		""
		"&fPassively increases your &bMelee Critical Strike Chance&f by a flat percentage."
		""
		"&fSynergizes exceptionally well with high-attack-speed weapons like daggers, dual swords, or berserker weapon flurries to trigger critical strikes with regularity."
	]
	quest.207B6045D661ECA7.quest_subtitle: "&bPrecision Bladecraft"
	quest.207B6045D661ECA7.title: "&fLesser Melee Critical Chance"
	quest.208E181680A25BA0.quest_desc: [
		"&fCatch &dZarude&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.208E181680A25BA0.quest_subtitle: "&7Catch Zarude"
	quest.208E181680A25BA0.title: "&dZarude"
	quest.20F15CC12DFDCA97.quest_desc: [
		"&fCatch &dRaikou&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.20F15CC12DFDCA97.quest_subtitle: "&7Catch Raikou"
	quest.20F15CC12DFDCA97.title: "&dRaikou"
	quest.214FFCC0DDF22FCE.quest_desc: [
		"&fCatch &dRayquaza&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.214FFCC0DDF22FCE.quest_subtitle: "&7Catch Rayquaza"
	quest.214FFCC0DDF22FCE.title: "&dRayquaza"
	quest.21D5E7976145DB0E.quest_desc: [
		"&fFlocks of metallic &6Stymphalian Birds&f congregate in swampy lowlands. Never engage them alone on open ground: they coordinate volleys of razor-sharp bronze feathers that pierce armor like ballista bolts."
		""
		"&aTactical Advice:&f Use a sturdy shield to deflect incoming feather barrages before returning fire with high-power archery."
		""
		"&fHarvest their bronze &eStymphalian Bird Feathers&f to craft deadly piercing &eStymphalian Arrows&f and the swift &eStymphalian Bird Dagger&f."
	]
	quest.21D5E7976145DB0E.quest_subtitle: "&7Death falling like a rain of arrows"
	quest.21D5E7976145DB0E.title: "&6Bronze Wings: Stymphalian Birds"
	quest.21F9E6F229B85AE1.quest_desc: [
		"&fObtain a &bStellar Tera Shard&f."
		""
		"&fStellar is treated separately from the ordinary eighteen-type shard collection because it represents a distinct Tera specialization."
	]
	quest.21F9E6F229B85AE1.quest_subtitle: "&7The special nineteenth Tera alignment"
	quest.21F9E6F229B85AE1.title: "&bStellar Tera Shard"
	quest.2203EDEA4B6D8709.quest_desc: [
		"&fWhen you have tens of thousands of cobblestone, dirt, or mob drops, traditional slot inventories become unmanageable."
		""
		"&eLimited Barrels&f act as high-density storage drawers:"
		"&f• Available in &b1, 2, 3, or 4 item configurations&f."
		"&f• Displays the stored item icon and exact count directly on the front face."
		"&f• &bLeft-Click&f: Pull a single item (or hold shift for a stack)."
		"&f• &bRight-Click&f: Insert matching held items. Double right-click dumps all matching items from your inventory!"
		""
		"&aLock item types with the Storage Tool to maintain organized slots even when empty.&f"
	]
	quest.2203EDEA4B6D8709.quest_subtitle: "&7Mass single-item storage with front readouts"
	quest.2203EDEA4B6D8709.title: "&6Bulk Drawers: Limited Barrels"
	quest.220BC58941783FA4.quest_desc: [
		"&fBeyond craftable weapons lie the &dUnique Weapons&f: legendary artifacts with bespoke model artwork, lore, and active abilities."
		""
		"&fUnique weapons can be acquired via:"
		"• &bStructure Chests:&f Injected into dungeon, fortress, and end city loot with per-player pity."
		"• &bBoss Drops:&f Wither (5%) and Ender Dragon (50%) drop unawakened uniques."
		"• &bContained Remnants:&f Incubating remnants or offering them to thematic blocks."
		""
		"&fNatural unique drops begin at &bAwakening Level 0&f. Take them to the &dRunic Forge&f with Runic Tablets to awaken their true statistics!"
	]
	quest.220BC58941783FA4.quest_subtitle: "&7Peerless relics of ancient warriors and dark entities"
	quest.220BC58941783FA4.title: "&d✦ Unique Weapons of Legend"
	quest.22218643CBC2274B.quest_desc: [
		"&fUse &bEMI&f to search recipes and item uses. Click the search bar at the bottom of your inventory to start searching. Then click on an item to get its recipe. You can also right click an item to see its uses."
	]
	quest.22218643CBC2274B.quest_subtitle: "&7Search the item index before searching the internet"
	quest.22218643CBC2274B.title: "&bEMI: Recipes and Uses"
	quest.2252F9C43BF99927.quest_desc: [
		"&fChange the Tera Type of a Pokémon."
		""
		"&fTera Shards are the resource side of the system. The optional shard collections below cover the complete ordinary type spectrum without forcing every color into the required path."
	]
	quest.2252F9C43BF99927.quest_subtitle: "&7Use Tera Shards to rewrite a Pokémon's Tera specialization"
	quest.2252F9C43BF99927.title: "&bChange the Tera Type"
	quest.227DE54A4FF6497C.quest_desc: [
		"&fCatch &dIron Leaves&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.227DE54A4FF6497C.quest_subtitle: "&7Catch Iron Leaves"
	quest.227DE54A4FF6497C.title: "&dIron Leaves"
	quest.235A0234EB7DBAC6.quest_desc: [
		"&fContinuing the awakening of the Righteous Relic to &bLevel 8&f at the Runic Forge unlocks the legendary blade &6Sunfire&f."
		""
		"&fRadiates blinding daylight, incinerating undead foes on contact while showering the wielder in solar convalescence."
	]
	quest.235A0234EB7DBAC6.quest_subtitle: "&7Fully awakened at Level 8 — Incandescent solar justice"
	quest.235A0234EB7DBAC6.title: "&6★ Sunfire"
	quest.23788FBE4002B35A.quest_desc: [
		"&fYou have journeyed across perilous realms and uncovered the full legacy of &eRelics (RPG Series)&f."
		""
		"&fFrom modest &7Lesser trinkets&f that preserved your life in early caves, through versatile &bMedium procs&f and &eJewel Figurines&f, to build-defining &dGreater perks&f and devastating party-wide &6Superior zones&f..."
		""
		"&fYour collection represents the absolute apex of RPG combat prowess."
		"&aWield your relics wisely, adapt your trinket loadouts to each encounter, and let no dungeon stand in your way!"
	]
	quest.23788FBE4002B35A.quest_subtitle: "&eThe Zenith of Artifact Mastery"
	quest.23788FBE4002B35A.title: "&6★ Master of Relics ★"
	quest.23E831D64F47162A.quest_desc: [
		"&fCraft a &eBotanist's Workbench&f from Chipped to create decorative foliage and other natural details."
		"&7Use it to soften walls, gardens and pathways with varied plant textures."
	]
	quest.23E831D64F47162A.quest_subtitle: "&7Work with leaves, vines and natural detail"
	quest.23E831D64F47162A.title: "&eNaturalist's Detail&r"
	quest.24077C47B78C4543.quest_desc: [
		"&fFollow an &eEye of Desert&f to a &eCursed Pyramid&f. Explore its rooms for the &eNecklace of the Desert&f needed to awaken the Ancient Remnant."
		"&fPrepare before interacting with the dormant boss. Keep your movement space clear; the large arena does not make standing still safe."
		"&aDefeat the boss to complete this milestone.&f"
	]
	quest.24077C47B78C4543.quest_subtitle: "&7Cursed Pyramid"
	quest.24077C47B78C4543.title: "&bAncient Remnant"
	quest.240EF96D61EA04BD.quest_desc: [
		"&fPress &eX &fto quick stack your items to nearby containers. There are also buttons in your inventory that do this."
	]
	quest.240EF96D61EA04BD.title: "&eInventory Shortcuts"
	quest.24AB05C1536FA9A7.quest_desc: [
		"&fArmaments steeped in midnight shadows:"
		""
		"• &5Gloampiercer:&f Throwing spear summoning shadow clone barrages that stain terrain with grasping Gloam tendrils."
		"• &5Enigma:&f Shrouded blade phasing through defenses and disorienting targets."
		""
		"&fGloampiercer is forged when &5The Devourer&f consumes a dropped &eWickpiercer&f!"
	]
	quest.24AB05C1536FA9A7.quest_subtitle: "&7Shadow spear and elusive enigma blade"
	quest.24AB05C1536FA9A7.title: "&5Shadow and Gloam"
	quest.24D3E35D8A388D56.quest_desc: [
		"&fRecovered from the heart of the Golem Forge, the &eAlloy Furnace&f is the ultimate technological workstation of Eternal Starlight."
		""
		"&fUnlike primitive furnaces, the Alloy Furnace accepts multi-ingredient recipes and requires an active &bCoolant / Refrigerant&f (such as &eGlacite&f, packed ice, or cryo-blocks) in addition to fuel."
		""
		"&aThis foundry is the exclusive machine capable of compounding the endgame alloy: Unrealium!"
	]
	quest.24D3E35D8A388D56.quest_subtitle: "&7Advanced metallurgical smelting"
	quest.24D3E35D8A388D56.title: "&6The Master Foundry"
	quest.24D59FD5FCEB2FD0.quest_desc: [
		"&fPresenting your 10 Victory Medals to the &dValkyrie Queen&f initiates an intense aerial duel in the throne room."
		""
		"&bCombat Tactics:&f"
		"&fThe Queen flies with incredible speed, teleports behind you, and calls down thunderbolts. When she takes to the air, shoot her with darts or arrows to ground her, then engage in furious swordplay when she descends."
		""
		"&fMaintain high mobility and keep healing snacks ready. Defeating her grants the &fSilver Dungeon Key&f!"
	]
	quest.24D59FD5FCEB2FD0.quest_subtitle: "&7Boss: The Valkyrie Queen"
	quest.24D59FD5FCEB2FD0.title: "&dJudgment from Above"
	quest.24EE6A6BD23E4346.quest_desc: [
		"&fCatch &dOgerpon&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.24EE6A6BD23E4346.quest_subtitle: "&7Catch Ogerpon"
	quest.24EE6A6BD23E4346.title: "&dOgerpon"
	quest.2504BD72CC89F438.quest_desc: [
		"&fTwilight brewing introduces drinks that project powerful defensive aura fields around your character for &b1 minute&f:"
		""
		"• &eGlacier Ice Tea&f: Grants &bFrozen Range&f, continually chilling and freezing nearby enemies while granting personal immunity to Frosty."
		"• &eTorchberry Juice&f: Grants &bFire Range&f, setting nearby hostile mobs on fire while preventing you from being ignited."
		"• &ePhytochemical Juice&f: Grants &bPoison Range&f, afflicting surrounding enemies with poison while granting personal poison immunity."
	]
	quest.2504BD72CC89F438.quest_subtitle: "&7Projecting elemental ranges"
	quest.2504BD72CC89F438.title: "&2Aura Infusions: Choose Your Element"
	quest.255B1F2EE573D24A.quest_desc: [
		"&fLiving hive relics buzzing with territorial fury:"
		""
		"• &6Hiveheart:&f Sai daggers summoning swarming stingers to tear into your quarry."
		"• &6Waxweaver:&f Sticky comb-blades coating targets in restrictive honey wax."
		""
		"&fAcquire both to command the hive's full combative wrath."
	]
	quest.255B1F2EE573D24A.quest_subtitle: "&7Stinging sai and waxen blades of the swarm"
	quest.255B1F2EE573D24A.title: "&6The Living Swarm"
	quest.25AE07A032C6311E.quest_desc: [
		"&fCatch &dCobalion&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.25AE07A032C6311E.quest_subtitle: "&7Catch Cobalion"
	quest.25AE07A032C6311E.title: "&dCobalion"
	quest.2669D82702A5BCB0.quest_desc: [
		"&fRecord &e20 legendary or mythical Pokémon&f across these expedition chapters."
		"&7Each completed capture updates this milestone automatically."
	]
	quest.2669D82702A5BCB0.quest_subtitle: "&7Document twenty rare encounters"
	quest.2669D82702A5BCB0.title: "&6Legendary Field Record: 20"
	quest.266CC0C0F634DE27.quest_desc: [
		"&fCatch &dSilvally&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.266CC0C0F634DE27.quest_subtitle: "&7Catch Silvally"
	quest.266CC0C0F634DE27.title: "&dSilvally"
	quest.266E094FED1A6D9E.quest_desc: [
		"&fObtain &eany one tera shard from set ii&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.266E094FED1A6D9E.quest_subtitle: "&7Obtain any one tera shard from set ii"
	quest.266E094FED1A6D9E.title: "&bTera Shards II"
	quest.2670E31F1B8FD5DF.quest_desc: [
		"&fObtain a &eLocate Structure&f ritual tablet and an &eRitual Brazier&f. The ritual searches for a nearby structure according to the augment ingredients you supply."
		"&fRead the notebook's ritual instructions and look up the Locate Structure recipes to choose a destination. A successful search produces a &eBound Wayfinder&f pointing to the result, with its distance shown in the same dimension."
		"&7An ordinary crafted Wayfinder is unbound. This quest detects your ritual equipment; actually finding the destination is your next expedition."
	]
	quest.2670E31F1B8FD5DF.quest_subtitle: "&7An exploration ritual from Ars Additions."
	quest.2670E31F1B8FD5DF.title: "&aFind a Structure"
	quest.2689D6EF3930B24B.quest_desc: [
		"&fCatch &dZapdos&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.2689D6EF3930B24B.quest_subtitle: "&7Catch Zapdos"
	quest.2689D6EF3930B24B.title: "&dZapdos"
	quest.269FB4C22095B0EA.quest_desc: [
		"&fA radiant golden relic containing bottled starlight and angel tears."
		""
		"&fActive ability: Consecrates the earth into a holy recovery zone where all &aHealing Taken is massively amplified&f."
		""
		"&fTurns minor healing spells and passive regeneration into full health restorations."
	]
	quest.269FB4C22095B0EA.quest_subtitle: "&aHallowed Ground of Recovery"
	quest.269FB4C22095B0EA.title: "&6Superior Consecrated Zone"
	quest.2710D5D8491842F4.quest_desc: [
		"&fIn pockets where chilly subterranean winds settle over stagnant waters, rare &bIce Lilies&f bloom."
		""
		"&fThese crystalline flowers freeze nearby water sources into ice and drop &eLily Flowers&f when gently harvested. They are prized by collectors and alchemists alike."
	]
	quest.2710D5D8491842F4.quest_subtitle: "&7Collect flowers from the frozen waters"
	quest.2710D5D8491842F4.title: "&bIce Lilies"
	quest.2725BE8A50EE98AB.quest_desc: [
		"&fAcquire a &bMoa Egg&f from wild Moa nests or dungeon vaults. Moa breeds possess varying mid-air jumping stamina:"
		"&9• Blue Moa:&f 3 consecutive mid-air jumps."
		"&f• White Moa:&f 4 consecutive mid-air jumps."
		"&8• Black Moa:&f An astonishing 8 consecutive mid-air jumps!"
		""
		"&aOnce hatched, feed the baby Moa several &dAechor Petals&f until it matures into a majestic adult. Equip it with a saddle to ride the stratospheric winds across entire island chains!"
	]
	quest.2725BE8A50EE98AB.quest_subtitle: "&7Rearing and Saddling a Celestial Mount"
	quest.2725BE8A50EE98AB.title: "&bWings of Companionship"
	quest.2726C637C64CA9D1.quest_desc: [
		"&fTransforming the Decaying Relic into polearm form produces the &bMagispear&f. It can be thrown like an arcane javelin, skewering enemies at great distance and returning on command."
	]
	quest.2726C637C64CA9D1.quest_subtitle: "&7Throwable arcane javelin evolved from the decaying relic"
	quest.2726C637C64CA9D1.title: "&bMagispear"
	quest.272AEFA5C4FBDA29.quest_desc: [
		"&fSurface roosts only hold adolescent dragons. The true ancient titans—Stage 4 and 5—never nest above ground. They sleep buried deep in subterranean caverns."
		""
		"&bThe Dragon Seeker:&f Craft this divination tool using dragon bones and precious metals. Right-clicking it resonates with the deep earth, emitting clicks that increase in frequency as you approach a sleeping dragon cave."
		""
		"&cBeware:&f Mining straight into a dragon cave without scouting can drop you into a sea of lava or right into the mouth of a slumbering mother dragon."
	]
	quest.272AEFA5C4FBDA29.quest_subtitle: "&7Listening for the heartbeat in the deep stone"
	quest.272AEFA5C4FBDA29.title: "&eThe Dragon Seeker"
	quest.273BD0A8BFD1E89A.quest_desc: [
		"&fEvery seasoned adventurer inevitably faces the same ruthless adversary: &ca catastrophic mountain of disorganized chests&f."
		""
		"&fThis chapter brings together three world-class logistical frameworks to solve storage forever:"
		""
		"&e• Sophisticated Backpacks&f: Wearable, modular storage packed with automated upgrades, magnetism, fluid tanks, and emergency survival tools."
		"&e• Sophisticated Storage&f: High-density modular chests, bulk limited barrels (drawers), in-world upgrading, and centralized controller networks."
		"&e• Tom's Simple Storage Mod&f: Unified terminal indexing, wireless cross-dimensional access, and seamless JEI crafting tables that pull from your entire base."
		""
		"&aFollow each branch at your own pace, or combine them together to create the ultimate automated storage network.&f"
		""
		"&fChoose the section that solves your current problem: &ePortable Storage&f for travel, &eBase Containers&f for capacity, or an &eItem Network&f for convenient access."
		"&fBackpack modules sit below the portable-storage branch. They are grouped separately from the bag upgrades so you can find the function you need."
	]
	quest.273BD0A8BFD1E89A.quest_subtitle: "&7Conquering clutter across space and dimensions"
	quest.273BD0A8BFD1E89A.title: "&fThe Art of Organization"
	quest.27419A96A0A9C168.quest_desc: [
		"&fObtain a &ePC&f and place it at your base. Use it to move Pokemon between your party and storage boxes."
	]
	quest.27419A96A0A9C168.quest_subtitle: "&7Manage the Pokemon that do not fit in the active party"
	quest.27419A96A0A9C168.title: "&bBuild a PC"
	quest.2756E905EE2FB66C.quest_desc: [
		"&fObtain &eany one trainer mega accessory&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.2756E905EE2FB66C.quest_subtitle: "&7Obtain any one trainer mega accessory"
	quest.2756E905EE2FB66C.title: "&dTrainer Mega Accessories"
	quest.27685AF09C590E38.quest_desc: [
		"&fA brutal war-axe built to carve through hordes. Trading defensive deflection for raw butchery, greataxes deliver hefty sweeping damage."
		""
		"&fCarries the &bLaceration&f implicit: hits inflict deep bleeding wounds that sap enemy health over time."
	]
	quest.27685AF09C590E38.quest_subtitle: "&7Broad cleaving axe that opens grievous wounds"
	quest.27685AF09C590E38.title: "&fDiamond Greataxe"
	quest.2768AC8DF62C1265.quest_desc: [
		"&fIn this world, &6Twilight Forest&f integrates with &bLootr&f!"
		""
		"&eBoss chests and dungeon containers are instanced per player.&f"
		""
		"&a• No need to fight over boss loot&f when adventuring together."
		"&a• Each player who opens a boss chest&f generates their own unique reward roll."
		"&a• Dungeons remain fully lootable&f for subsequent explorers."
		""
		"&7Cooperate freely with friends without worrying about stolen trophies or gear!"
	]
	quest.2768AC8DF62C1265.quest_subtitle: "&7Individual dungeon loot for every adventurer"
	quest.2768AC8DF62C1265.title: "&6Shared Spoils: Twilight Lootr"
	quest.27771B7FB818DA9F.quest_desc: [
		"&fNavigating the outer End is treacherous, especially when besieged by Shulker levitation volleys. &bEnd's Delight&f provides culinary solutions to void hazards."
		""
		"&eChorus Flower Tea&f immediately &bpurges the Levitation effect&f upon consumption, allowing you to regain control over your trajectory before floating into open space."
		""
		"&cWarning:&f While cancelling Levitation stops upward drift, it does &lnot&r prevent gravity from doing its work! Ensure you have an Elytra, water bucket, or slow falling before drinking mid-air."
	]
	quest.27771B7FB818DA9F.quest_subtitle: "&7Countering the shulker's curse"
	quest.27771B7FB818DA9F.title: "&5Void Confections: Chorus Flower Tea"
	quest.277A8287F1735165.quest_desc: [
		"&fEquip an archaeological &eBrush&f and search for &bSuspicious Sand&f and &bSuspicious Gravel&f inside ocean ruins, desert pyramids, warm ocean reefs, and forgotten trail ruins."
		""
		"&fBrushing these blocks uncovers &eAncient Pottery Sherds&f and &eFossilized Remains."
	]
	quest.277A8287F1735165.quest_subtitle: "&7Excavating Prehistoric History"
	quest.277A8287F1735165.title: "&dWhispers in the Sediment"
	quest.277A8291BA8504B6.quest_desc: [
		"&fFollow your Seeking Eye to the colossal elevated hedge maze known as the &eCursed Garden&f. At its center sleeps the &cLunar Monstrosity&f."
		""
		"&cThe Fiery Key:&f The Lunar Monstrosity is completely impervious to all standard attacks until it is &cset on fire&f! Bring flint and steel, fire charges, or Thermal Springstone weapons to light it up and strip its bark armor."
		""
		"&fBeware its toxic spore clouds, burrowing charges, and sweeping thorn vines. Slaying it rewards &eTenacious Petals&f and &eTangled Skulls&f."
	]
	quest.277A8291BA8504B6.quest_subtitle: "&7The slumbering terror of the labyrinth"
	quest.277A8291BA8504B6.title: "&2The Cursed Garden"
	quest.277D3A6286DBF26D.quest_desc: [
		"&fFolded steel honed to a razor apex. The &eKatana&f is exceptionally quick and rewards surgical combat timing."
		""
		"&fIts implicit trait gives strikes a chance to trigger &bCritical Edge&f, dealing catastrophic double damage on hit."
	]
	quest.277D3A6286DBF26D.quest_subtitle: "&7Precision curved steel with double-damage criticals"
	quest.277D3A6286DBF26D.title: "&fDiamond Katana"
	quest.27A9B9481DFD9E37.quest_desc: [
		"&fForged in ancient debris and coated in dense netherite plating, the &5Netherite Backpack&f represents the zenith of personal transport."
		""
		"&fBoasting a colossal &e120 item slots&f and &e7 upgrade sockets&f, this titan will comfortably hold the spoils of entire Nether or End expeditions."
		""
		"&cBest of all, netherite equipment floats on lava and is completely immune to fire and cactus destruction.&f"
	]
	quest.27A9B9481DFD9E37.quest_subtitle: "&7120 slots of fireproof invulnerability"
	quest.27A9B9481DFD9E37.title: "&5The Netherite Strongbox"
	quest.27BE43AE2374EED9.quest_desc: [
		"&fThe &aCrafting Terminal&f is one of the most transformative quality-of-life upgrades in Minecraft modding."
		""
		"&bWhy It Changes Everything&f:"
		"&f• Combines the full storage search interface with a built-in 3x3 crafting grid."
		"&f• Full &eJEI / REI integration&f: Click the &b[+] recipe transfer button&f in JEI, and the terminal pulls the required ingredients directly from your connected chests straight into the crafting grid!"
		"&f• Items left in the crafting grid stay preserved when you close the GUI."
		""
		"&aCraft complex multi-tier recipes in seconds without rummaging for intermediate components.&f"
	]
	quest.27BE43AE2374EED9.quest_subtitle: "&7Direct JEI crafting pulling from your whole warehouse"
	quest.27BE43AE2374EED9.title: "&aIntegrated Workshop"
	quest.27BE6FDF4A31C2D9.quest_desc: [
		"&fSurrounding the Final Plateau lies the &cThornlands&f, choked with dense, venomous green thorns that inflict extreme damage and poison upon touch."
		""
		"&bHow to Pass:&f"
		"&f• Hold the &6Lamp of Cinders&f in your hand and right-click to unleash waves of magical cinder flame."
		"&f• The green thorns burst into burning brown thorns and crumble into harmless ash."
		""
		"&aCarve your way up the mountain slopes&f to emerge onto the Final Plateau!"
	]
	quest.27BE6FDF4A31C2D9.quest_subtitle: "&7Carving a path through the lethal briars"
	quest.27BE6FDF4A31C2D9.title: "&cBurning the Brambles: The Thornlands"
	quest.27C5A9F9B51CEEB1.quest_desc: [
		"&fYou do not need to keep every storage container physically touching the Controller."
		""
		"&f• &eStorage Link&f: Place on any distant container and link it back to your Controller using a &6Storage Tool&f to include it in the network wirelessly."
		"&f• &bStorage I/O and Input/Output Blocks&f: Dedicated conduit faces that connect to external item pipes, hoppers, or conveyors without cluttering your main storage wall."
		""
		"&aUse Storage Links to hide noisy bulk barrel vaults beneath your base floor while keeping your sorting wall clean.&f"
	]
	quest.27C5A9F9B51CEEB1.quest_subtitle: "&7Extending networks and automating hopper interfaces"
	quest.27C5A9F9B51CEEB1.title: "&6Wireless Ties and I/O Ports"
	quest.27C5EF8B72295EBC.quest_desc: [
		"&fReturn to the Highlands surface and locate a patch of fertile &eUberous Soil&f. Plant your &aMagic Beans&f in the soil."
		""
		"&aA monstrous beanstalk erupts into the heavens&f, piercing through the sky to reach a solid cloud layer!"
		""
		"&fAtop the clouds sits the &fCloud Cottage&f inhabited by Giant Miners and Giant Warriors. Slay the Giant Miners to claim their gargantuan &eGiant's Pickaxe&f—capable of breaking a 4x4x4 block volume in a single swing!"
	]
	quest.27C5EF8B72295EBC.quest_subtitle: "&7Ascend the colossal beanstalk"
	quest.27C5EF8B72295EBC.title: "&fCloud Cottage of the Giants"
	quest.27CF316B316A34F5.quest_desc: [
		"&fYour first milestone in the dimension's linear progression is the &aNaga&f, dwelling within an overgrown stone &eNaga Courtyard&f."
		""
		"&bTactics:&f"
		"&f• The Naga moves rapidly, slithering across the courtyard to trample walls and players."
		"&f• As you strike the serpent, its segments detach and shrink."
		"&f• Aim for its head for maximum vulnerability, and use ranged weapons when it loops around."
		""
		"&aDefeating the Naga earns Naga Scales, its trophy, and breaks the force-field shielding the Lich Tower!&f"
	]
	quest.27CF316B316A34F5.quest_subtitle: "&7The first guardian of the forest progression"
	quest.27CF316B316A34F5.title: "&aThe Serpent of the Courtyard: Naga"
	quest.27CF57E17FDDC52B.quest_desc: [
		"&fWelcome to the martial arts of &eSimply Swords&f! Vanilla combat revolves almost entirely around the humble sword and axe, but an entire arsenal of specialized armaments awaits discovery."
		""
		"&fEvery weapon class in this mod features distinct tradeoffs between &battack damage&f, &bswing speed&f, &battack reach&f, and innate &eImplicit Abilities&f. Whether you prefer swift dual-wielding, crushing armor to dust, or skewering foes from afar, there is a steel discipline forged just for you."
		""
		"&a✦ Tip:&f Check your keybinds under &bOptions → Controls&f. Certain active abilities can be bound to dedicated &eWeapon Ability&f keys for seamless dual-wielding control!"
	]
	quest.27CF57E17FDDC52B.quest_subtitle: "&7A grand armory awaits beyond standard blades"
	quest.27CF57E17FDDC52B.title: "&f⚔ An Expanded Arsenal"
	quest.27DE26C5FDF6BE9E.quest_desc: [
		"&fThe third progression path leads into the frozen &bSnowy Forest&f, where icy blizzards freeze unwary travelers."
		""
		"&fLook for square snowy caverns built into the hillside. Inside dwell packs of Yetis and aggressive Winter Wolves. Slay standard Yetis to harvest &bArctic Fur&f, which crafts into thermal armor."
		""
		"&7At the heart of the cavern dwells the clan chieftain—the colossal Alpha Yeti."
		""
		"&aPokémon habitat note:&f the Snowy Forest is mapped to Alolan Vulpix habitat. Its entry still requires natural ground and skylight 8-15; finding the biome is only one condition."
	]
	quest.27DE26C5FDF6BE9E.quest_subtitle: "&7Braving the sub-zero blizzards"
	quest.27DE26C5FDF6BE9E.title: "&bThe Frozen Depths: Yeti Cave"
	quest.27E436BA7C55E0DA.quest_desc: [
		"&fThe vibrant pale-blue foliage of the Aether grows atop &eSkyroot Trees&f, the foundational timber of the entire dimension."
		""
		"&fSkyroot wood acts as the native equivalent to Overworld oak, providing planks, sticks, crafting benches, and tool handles."
		""
		"&aFell a few Skyroot trees to secure the building blocks of your skyborne outpost."
		""
		"&aWhile gathering Skyroot:&f look for Pidgey and Caterpie around naturally generated trees in Skyroot Forest and Woodland. These entries need skylight 8-15; Caterpie also checks for nearby leaves."
	]
	quest.27E436BA7C55E0DA.quest_subtitle: "&7Lumber of the Celestial Canopy"
	quest.27E436BA7C55E0DA.title: "&eThe Skyroot Harvest"
	quest.27E4B384F973D966.quest_desc: [
		"&fThe heart of nearly every advanced kitchen relies on four fundamental crops: &eCabbage&f, &eOnions&f, &eTomatoes&f, and &eRice&f."
		""
		"&bRice&f thrives uniquely in waterlogged soil: plant it directly in shallow water pads to cultivate tall stalks. Cabbages, onions, and tomatoes thrive on standard tilled soil."
		""
		"&fConsult &bEMI&f to explore the extensive seasoning and ingredient roles these four staples fulfill across multiple culinary addons."
	]
	quest.27E4B384F973D966.quest_subtitle: "&7Four staples of the pantry"
	quest.27E4B384F973D966.title: "&eAgricultural Foundations"
	quest.27E898CE534ECB57.quest_desc: [
		"&fWelcome to &dEternal Starlight&f, a mystical dimension suspended under an eternal celestial canopy where the sun never rises and the night sky blazes with cosmic wonder."
		""
		"&fWithin this realm lie bizarre ecosystems, luminous flora, primordial beasts, and long-abandoned astral technologies waiting to be awakened."
		""
		"&bThe Starlight Story&f (or &eThe Glimmering Tablet&f) records ancient knowledge of the dimension. Consult your questbook and the stars as you venture into the unknown."
		""
		"&aPrepare yourself with durable gear, reliable food, and an adventurous heart before taking your first steps toward the portal ruins."
		""
		"&bPokémon Field Notes"
		"&fLook for &eMurkrow&f in the Starlight Forest under low skylight, &eTrapinch&f in the Crystallized Desert under high skylight, and &eGrimer&f on natural ground in the Dark Swamp."
		"&fThe &eStarlight Permafrost Forest&f includes &eAlolan Vulpix&f. In the &eShimmer River&f, fishing beneath open sky can also find &eDratini&f as a rare encounter."
		"&7These are examples, not guaranteed spawns. The local biome, terrain, skylight and fishing conditions matter; the region's appearance alone is not enough."
	]
	quest.27E898CE534ECB57.quest_subtitle: "&7A realm bathed in perpetual twilight"
	quest.27E898CE534ECB57.title: "&dThe Starlit Firmament"
	quest.27F4531A178A7876.quest_desc: [
		"&fA lethal assassin dagger. Striking enemies siphons their soul, granting Haste and marking them. On right-click, blink across distances to blind and execute the marked victim."
	]
	quest.27F4531A178A7876.quest_subtitle: "&7Assassination blade blinking to marked souls"
	quest.27F4531A178A7876.title: "&3Soulstealer"
	quest.27F471182BF02D4E.quest_desc: [
		"&fWelcome to &bThe Aether&f, a mythical floating archipelago suspended in the stratosphere."
		""
		"&fTo bridge the mortal world with this celestial realm, construct a standard vertical frame of &eGlowstone&f (4 blocks wide, 5 blocks tall), identical in proportions to a Nether Portal."
		""
		"&fOnce the portal frame stands complete, activate it by emptying a &bWater Bucket&f into the interior. The water will coalesce into a shimmering dimensional gateway."
		""
		"&eNote:&f Normal fire and flint will not activate this portal—only pure water can open the path upward."
		""
		"&bPokémon Field Notes"
		"&fSkyroot forests and woodlands have &ePidgey&f and &eCaterpie&f spawn entries. Search natural tree cover with good skylight; Caterpie also needs nearby leaves. &eButterfree&f has a daytime entry in Aether biomes."
		"&fThe &eSkyroot Woodland&f also has a &eClefairy&f entry. &eWartortle&f is a rarer possibility across the four Skyroot biomes."
		"&7These are possible encounters, not guaranteed finds. Terrain, light and time conditions still apply."
	]
	quest.27F471182BF02D4E.quest_subtitle: "&7The Paradise Above the Clouds"
	quest.27F471182BF02D4E.title: "&bAscension to the Heavens"
	quest.27F9A184AF253D40.quest_desc: [
		"&fWith the Lich dead, the &8Dark Forest&f no longer inflicts pitch blindness on trespassers."
		""
		"&fSearch beneath the dense canopy to find the entrance to a massive underground &eGoblin Knight Stronghold&f. Slay Redcap Sappers, Kobolds, and Helmet Crabs to harvest &eArmor Shards&f."
		""
		"&eThe Trophy Pedestal:&f To access the boss sanctum, you must locate the central altar and sacrifice &aany boss trophy&f onto the pedestal to dissolve the magical shielding."
	]
	quest.27F9A184AF253D40.quest_subtitle: "&7Subterranean fortress beneath the dark canopy"
	quest.27F9A184AF253D40.title: "&8The Goblin Knight Stronghold"
	quest.27FB03A3C59190F0.quest_desc: [
		"&fFor monumental occasions and shared expeditions, cooking single bowls is not enough. The kitchen allows you to prepare large, placeable &eFeasts&f."
		""
		"&fPlace the &eRoast Chicken&f down on a tabletop or campfire setting. Players can approach with a &eBowl&f in hand and right-click to carve generous individual portions."
		""
		"&fFeasts provide multiple hearty servings, making them the ideal centerpiece for base encampments, multiplayer expeditions, or grand celebratory banquets."
	]
	quest.27FB03A3C59190F0.quest_subtitle: "&7Gather around the dining table"
	quest.27FB03A3C59190F0.title: "&eA Grand Feast: Roast Chicken"
	quest.27FFE0E0F21D66AD.quest_subtitle: "Claim a free origin change every 30 minutes"
	quest.27FFE0E0F21D66AD.title: "FREE ORIGIN CHANGE [beta only]"
	quest.28374A3978F99667.quest_desc: [
		"&fYou have explored the furthest reaches of the architectural arts."
		""
		"&fYour home is now a monument to design. From the &bchiseled foundations&r to the &cshingled peaks&r, every block is perfectly placed."
	]
	quest.28374A3978F99667.quest_subtitle: "&7Complete every building category"
	quest.28374A3978F99667.title: "&eWorld Renowned Designer&r"
	quest.283F41940E408544.quest_desc: [
		"&fUse the &eSeeking Eye&f locked onto the Golem Forge to track down this massive subterranean industrial complex."
		""
		"&cThe Boss Encounter:&f The &cStarlight Golem&f is invulnerable upon waking! Surrounding the arena are glowing power generators; you must sprint between them and &bdeactivate the generators&f to drop the golem's shield."
		""
		"&cWatch out:&f It sweeps the room with piercing laser beams, summons mechanical minions, and triggers devastating ground slams. Defeating it yields &eGolem Steel&f and its core foundry!"
	]
	quest.283F41940E408544.quest_subtitle: "&7Titan of brass, lasers, and steel"
	quest.283F41940E408544.title: "&cThe Golem Forge"
	quest.28BB50E4B22870F5.quest_desc: [
		"&fWhat sets Sophisticated Backpacks apart from ordinary packs is their modular upgrade system."
		""
		"&fEvery specialized module begins with an &eUpgrade Base&f. Once crafted and slotted into your pack's upgrade tab, a new configuration tab appears on the left edge of your backpack GUI."
		""
		"&bPro-Tip&f: Click on the upgrade tab icons inside the backpack GUI to adjust filters, whitelist/blacklist modes, target inventories, and trigger thresholds."
	]
	quest.28BB50E4B22870F5.quest_subtitle: "&7The foundation of all backpack abilities"
	quest.28BB50E4B22870F5.title: "&fModular Customization"
	quest.28EDD8412606BD47.quest_desc: [
		"&fUpgrading iron tools with Resonarium Plates creates &eResonarium Tools&f."
		""
		"&fThey possess mining speeds and attack statistics equivalent to diamond gear, with high natural durability and a brilliant luminescent blue aesthetic."
	]
	quest.28EDD8412606BD47.quest_subtitle: "&7Diamond-grade tools forged from resonant metal"
	quest.28EDD8412606BD47.title: "&3Acoustic Implements"
	quest.28F49481A0A04DC4.quest_desc: [
		"&fA warm ruby glass vial wrapped in blessed silver wires."
		""
		"&fActive ability: Triggers an instant burst of &aHealth Recovery&f on demand without needing to pause or drink a slow potion."
		""
		"&fKeep this bound to an accessible keybind to survive sudden close calls in deep caverns and boss fights."
	]
	quest.28F49481A0A04DC4.quest_subtitle: "&bEmergency Respite"
	quest.28F49481A0A04DC4.title: "&fLesser Relic of Vitality"
	quest.29089A6900844D62.quest_desc: [
		"&fCatch &dCalyrex&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.29089A6900844D62.quest_subtitle: "&7Catch Calyrex"
	quest.29089A6900844D62.title: "&dCalyrex"
	quest.293316B17A3362E9.quest_desc: [
		"&fA leviathan-scale greatsword carrying the crushing weight of oceanic trenches. Slams summon towering frost tides that drown enemy ranks."
	]
	quest.293316B17A3362E9.quest_subtitle: "&7Oceanic greatsword calling forth crushing frost tides"
	quest.293316B17A3362E9.title: "&bLivyatan"
	quest.297D850A6EEE879A.quest_desc: [
		"&fCatch &dVictini&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.297D850A6EEE879A.quest_subtitle: "&7Catch Victini"
	quest.297D850A6EEE879A.title: "&dVictini"
	quest.2991553802B50642.quest_desc: [
		"&fRegister &e40 Psychic-type Pokémon&r&f in your Pokédex."
		""
		"&7Dual-type Pokémon count when Psychic is one of their types."
	]
	quest.2991553802B50642.quest_subtitle: "&7Register 40 Psychic-type Pokémon"
	quest.2991553802B50642.title: "&6Psychic Mastery&r"
	quest.29A3B2E95D65A441.quest_desc: [
		"&fA fierce statuette glowing with an internal blood-red flame."
		""
		"&fResonates with berserker fury, physical weapon lethality, and incinerating pyromancy."
		""
		"&fThe figurine of choice for frontline warriors and aggressive battlemages hungry for blood and fire."
	]
	quest.29A3B2E95D65A441.quest_subtitle: "&cThe Crimson Idol of Wrath"
	quest.29A3B2E95D65A441.title: "&cRuby Jewel Figurine"
	quest.29B6F62DE601495A.quest_subtitle: "Obtain one of every ancient poke ball"
	quest.29B6F62DE601495A.title: "&cAncient Poke balls"
	quest.29DA5C9F6B369B48.quest_desc: [
		"&fAn electrifying glaive that channels thunder. On right-click, plants a spectral lightning rod into the ground."
		""
		"&fEvery melee strike you perform pulses shockwaves along the tether, pulling enemies toward the planted rod while ramping damage up to +80%!"
	]
	quest.29DA5C9F6B369B48.quest_subtitle: "&7Plants a tethered lightning rod that pulses on strike"
	quest.29DA5C9F6B369B48.title: "&bStormscale"
	quest.2A35B3A7A6FEBC05.quest_desc: [
		"&fThe dim, crystalline environment of Eternal Starlight demands specialized nutrition to withstand its unearthly afflictions."
		""
		"&eStarmina Noodle Soup&f restores &b14 hunger points&f, providing Nourishment and &bStarlight Blessing for 3 minutes&f. Starlight Blessing actively alleviates accumulated &cNumbness Damage&f, preventing your vitality from freezing over."
		""
		"&eStarfire Fried Egg&f grants &bStarfire Warmth II for 30 seconds&f, sharing regeneration with nearby companions while scorching nearby enemies with starfire."
	]
	quest.2A35B3A7A6FEBC05.quest_subtitle: "&7Curing the cold void of the starlight realm"
	quest.2A35B3A7A6FEBC05.title: "&9Starlight Sustenance and Numbness"
	quest.2A36B046603F2D40.quest_desc: [
		"&fA staff tipped with mirrored blades at both ends. Designed for continuous circular momentum."
		""
		"&fFeatures the &bMomentum&f implicit: consecutive successful hits temporarily accelerate your attack speed, stacking higher the longer you remain engaged."
	]
	quest.2A36B046603F2D40.quest_subtitle: "&7Double-ended staff building rapid attack speed"
	quest.2A36B046603F2D40.title: "&fDiamond Twinblade"
	quest.2ADD9D191B1517BE.quest_desc: [
		"&fCatch &dTapu Lele&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.2ADD9D191B1517BE.quest_subtitle: "&7Catch Tapu Lele"
	quest.2ADD9D191B1517BE.title: "&dTapu Lele"
	quest.2AEBD6E7DA23C8DC.quest_desc: [
		"&fFashioning tools from &eSkyroot Wood&f yields more than just a primitive starting set."
		""
		"&fAll &bSkyroot Tools&f possess a unique intrinsic enchantment: whenever they mine or harvest compatible Aether blocks and organisms, they grant &adouble drops&f!"
		""
		"&fCraft a &eSkyroot Pickaxe&f to begin quarrying the floating stone beneath your feet."
	]
	quest.2AEBD6E7DA23C8DC.quest_subtitle: "&7Doubled Yields from the High Winds"
	quest.2AEBD6E7DA23C8DC.title: "&6Tools of the Canopy"
	quest.2B1D57C1197A1991.quest_desc: [
		"&fThe gargantuan &8Dark Tower&f stands at the center of the Dark Forest. Inside is a vertical labyrinth of redstone mechanisms, vanishing blocks, Tower Golems, and Carminite Ghastlings."
		""
		"&fTo ascend between tower wings, you must explore side chambers to discover &bTower Keys&f to unlock reinforced doors."
		""
		"&7Prepare well: Bring plenty of arrows, blocks, and feather falling armor to navigate the perilous vertical shafts."
	]
	quest.2B1D57C1197A1991.quest_subtitle: "&7Climbing the automated carminite spire"
	quest.2B1D57C1197A1991.title: "&8Ascent of the Dark Tower"
	quest.2B872422E4238BCE.quest_desc: [
		"&fThe subterranean waters of The Otherside are prowled by ferocious &9Angler Fish&f that actively hunt anything that is not sculk."
		""
		"&fTake care when swimming near dark lakes! Sludge creatures also bubble up along muddy shores."
		""
		"&aTip:&f Slaying Angler Fish provides raw meat that can be cooked on a campfire or furnace into &eCooked Angler Fish&f, restoring significant hunger and saturation."
		""
		"&aA reason to bring a rod:&f Chinchou has fishing and submerged entries in the Deeplands, Echoing Forest and Blooming Caverns."
	]
	quest.2B872422E4238BCE.quest_subtitle: "&7Subterranean fishing and survival cooking"
	quest.2B872422E4238BCE.title: "&9Lurkers of the Stygian Lakes"
	quest.2B8ED2E16F71A6CE.quest_desc: [
		"&fReturning from an expedition usually means ten minutes of clicking items into storage bins. These upgrades automate base arrival entirely:"
		""
		"&f• &eDeposit Upgrade&f: Shift-right clicking your backpack onto any chest or storage block dumps all matching items inside instantly."
		"&f• &bRestock Upgrade&f: Shift-right clicking refills your hotbar with defined supplies (torches, food, arrows, building blocks) from the target container."
		""
		"&aOne tap to empty your spoils, one tap to resupply, and you are ready for the next adventure.&f"
	]
	quest.2B8ED2E16F71A6CE.quest_subtitle: "&7Deposit and restock with a single click"
	quest.2B8ED2E16F71A6CE.title: "&eInstant Offload"
	quest.2C4AF38F53BC8210.quest_desc: [
		"&fThe &dSculk Transmitter&f is one of the most powerful utility devices in the mod."
		""
		"&b• How to Link:&f Shift-right-click any chest, barrel, furnace, crafting station, or modded container to bind the transmitter to that exact block."
		"&b• Remote Access:&f Simply press your assigned Transmitter keybind (or right-click with it in hand) to open that container instantly from anywhere—even across dimensions!"
		""
		"&aCustomizable:&f Combine your transmitter with any of the 16 vanilla dyes to color-code your wireless channels."
	]
	quest.2C4AF38F53BC8210.quest_subtitle: "&7Remote access to containers across dimensions"
	quest.2C4AF38F53BC8210.title: "&dWireless Sub-Space Storage"
	quest.2C5BE7B3C35C158F.quest_desc: [
		"&fCoal does not exist naturally in the Aether. In its stead, you will find glistening veins of &eAmbrosium Ore&f."
		""
		"&fMining this ore yields &eAmbrosium Shards&f. These miraculous crystals serve three critical purposes:"
		"&71.&f They can be consumed directly by &bRight-clicking&f to restore a small amount of health."
		"&72.&f Combined with a Skyroot Stick, they create &6Ambrosium Torches&f—the only torches capable of shining reliably in the thin mountain air."
		"&73.&f They act as holy fuel for the sacred &bAltar&f."
	]
	quest.2C5BE7B3C35C158F.quest_subtitle: "&7Fuel, Sustenance, and Radiance"
	quest.2C5BE7B3C35C158F.title: "&eHeavenly Glow"
	quest.2CDDE2BF366CEFDF.quest_desc: [
		"&fThe slowest crushing weapon in the blacksmith's repertoire, the &eGreathammer&f delivers earth-shattering impacts that leave targets staggering."
		""
		"&fGreathammers feature the &bArmor Sunder&f implicit, shredding a percentage of an enemy's protection with every solid hit. Heavily armored knights melt under repeated concussions."
	]
	quest.2CDDE2BF366CEFDF.quest_subtitle: "&7Devastating blunt force that shatters armor plates"
	quest.2CDDE2BF366CEFDF.title: "&fDiamond Greathammer"
	quest.2CDEED93EBD3FBE9.quest_desc: [
		"&fCatch &dNecrozma&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.2CDEED93EBD3FBE9.quest_subtitle: "&7Catch Necrozma"
	quest.2CDEED93EBD3FBE9.title: "&dNecrozma"
	quest.2CE8DE01FA1BC458.quest_desc: [
		"&fRecovered from the crumbling sandstone hallways of Unova's Relic Castle:"
		""
		"&e• Cover Fossil&f: The heavy ribbed shell of &bTirtouga&f, a primordial sea turtle whose Solid Rock ability softens super-effective blows as it grows into Carracosta."
		"&e• Plume Fossil&f: The colorful plumage of &bArchen&f, the proto-bird ancestor blessed with ridiculous speed and offensive stats, offset only by its timid Defeatist nature, evolving into Archeops!"
		""
		"&aTwo masters of sea and sky from the ancient Unova continent.&f"
	]
	quest.2CE8DE01FA1BC458.quest_subtitle: "&7Cover and Plume Fossils"
	quest.2CE8DE01FA1BC458.title: "&6Unova Relics: Sea Shell and Feather"
	quest.2CEE71321D3D77C5.quest_desc: [
		"&fCatch &dRaging Bolt&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.2CEE71321D3D77C5.quest_subtitle: "&7Catch Raging Bolt"
	quest.2CEE71321D3D77C5.title: "&dRaging Bolt"
	quest.2D026A79B5F2A6BA.quest_desc: [
		"&fSend out your partner to challenge a wild Pokemon and win."
	]
	quest.2D026A79B5F2A6BA.quest_subtitle: "&7Learn turn to fight against a wild Pokemon"
	quest.2D026A79B5F2A6BA.title: "&cWin Your First Battle"
	quest.2D8B33B918AC19DC.quest_desc: [
		"&fCombining &eSea Serpent Scales&f and &eSea Serpent Fangs&f allows you to forge the majestic &bTide Trident&f and a full suit of &bTide Guardian Armor&f."
		""
		"&fTide Guardian Armor grants the wearer infinite &bWater Breathing&f, unimpeded underwater movement, and immense physical strength whenever submerged or fighting in the rain."
		""
		"&aWith the ocean conquered, you stand ready to face the supreme rulers of the atmosphere: the true dragons.&f"
	]
	quest.2D8B33B918AC19DC.quest_subtitle: "&7Commanding water, surge, and tempest"
	quest.2D8B33B918AC19DC.title: "&bWeapon of the Abyssal Depths"
	quest.2E1310613D3B46EE.quest_desc: [
		"&fObtain a &5Wishing Star&f."
		""
		"&fIt serves as the early material gate into the Dynamax equipment chain."
	]
	quest.2E1310613D3B46EE.quest_subtitle: "&7The first material step toward Dynamax equipment"
	quest.2E1310613D3B46EE.title: "&5Wishing Star"
	quest.2E9A445CE98356DA.quest_desc: [
		"&fForge a suite of equipment from &dZanite Gemstones&f. Zanite gear possesses a fascinating enchantment known as &binverse scaling&f:"
		""
		"&a• Zanite Tools:&f As the tool loses durability and takes damage, its mining speed increases dramatically, becoming blisteringly fast near breaking point!"
		"&9• Zanite Armor:&f The more damaged the armor becomes, the more physical protection and damage reduction it provides."
		""
		"&eRemember:&f You can always repair worn Zanite gear back to full health inside the &6Altar&f using Ambrosium."
	]
	quest.2E9A445CE98356DA.quest_subtitle: "&7Strength in Adversity"
	quest.2E9A445CE98356DA.title: "&5Brittle Brilliance"
	quest.2ED0A8BEBAE2A346.quest_desc: [
		"&fDuring intense combat or lengthy mining runs, keeping track of hunger and tool switching wastes precious time."
		""
		"&f• &aFeeding Upgrade&f: Automatically feeds you nutritious foods stored in your pack whenever your hunger bar dips."
		"&f• &bTool Swapper Upgrade&f: Detects the block you are looking at and automatically swaps the most effective tool from your backpack into your main hand!"
		""
		"&aNever break an axe on stone or starve mid-sprint again.&f"
	]
	quest.2ED0A8BEBAE2A346.quest_subtitle: "&7Auto-feeding and intelligent tool selection"
	quest.2ED0A8BEBAE2A346.title: "&aExpedition Caretaker"
	quest.2ED60875704E4D71.quest_desc: [
		"&fA volcanic greatsword pulled straight from the nether crust. Strikes build volcanic pressure, and holding right-click releases molten eruption waves."
	]
	quest.2ED60875704E4D71.quest_subtitle: "&7Volcanic greatsword releasing searing eruption waves"
	quest.2ED60875704E4D71.title: "&cBrimstone Claymore"
	quest.2ED6286B91BC2FE8.quest_desc: [
		"&fAn ever-burning broadsword. Striking targets ignites them with blazing embers and grants fire resistance to the wielder."
	]
	quest.2ED6286B91BC2FE8.quest_subtitle: "&7Living flame burning through enemy frontlines"
	quest.2ED6286B91BC2FE8.title: "&cEmberblade"
	quest.2EE738CA1FC821AB.quest_desc: [
		"&fObtain a usable &eZ-Crystal&f."
		""
		"&fGeneric crystals are aligned to move types, while signature crystals are tied to specific Pokémon, moves or special conditions."
	]
	quest.2EE738CA1FC821AB.quest_subtitle: "&7Acquire a usable crystal before testing the battle mechanic"
	quest.2EE738CA1FC821AB.title: "&eA Z-Crystal"
	quest.2F1FF5CF7BB39C0D.quest_desc: [
		"&fCatch &dLunala&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.2F1FF5CF7BB39C0D.quest_subtitle: "&7Catch Lunala"
	quest.2F1FF5CF7BB39C0D.title: "&dLunala"
	quest.2F637D0D87CDE090.quest_desc: [
		"&fMelmetal is included in the installed Pokemon data, but this pack currently has &cno confirmed survival acquisition route&f for it."
		"&fThis entry is a reference note. It does not require you to capture Melmetal and does not add legendary completion credit."
		"&7If a legitimate spawn, evolution or event route is added later, this entry can become a tracked collection goal."
	]
	quest.2F637D0D87CDE090.quest_subtitle: "&7Catch Melmetal"
	quest.2F637D0D87CDE090.title: "&cMelmetal: Availability Note"
	quest.2F696B9791E096DB.quest_desc: [
		"&fObtain &eany one kalos mega stone&r&f from this category."
		""
		"&7One example completes the lesson. The remaining variants are optional collectibles."
	]
	quest.2F696B9791E096DB.quest_subtitle: "&7Obtain any one kalos mega stone"
	quest.2F696B9791E096DB.title: "&dKalos Mega Stones"
	quest.3037620426AA71EB.quest_desc: [
		"&fTrolls inhabit forests, snowy mountains and deep ravines. Direct sunlight petrifies them, making daylight your safest weapon."
		"&fTheir leather makes armor whose projectile protection scales with the number of pieces worn. It does not pacify Trolls or grant petrification immunity."
	]
	quest.3037620426AA71EB.quest_subtitle: "&7Brute force from the mountain caves"
	quest.3037620426AA71EB.title: "&8Sunlight Petrification: Trolls"
	quest.30457F72B086EDB3.quest_desc: [
		"&fOpen the legendary Gold Treasure Chest to claim the absolute zenith of Aetherian artifacts:"
		""
		"&6• Phoenix Armor:&f Armor forged in solar fire that grants permanent &aimmunity to fire and lava&f, swimming speed through lava lakes, and ignites attackers!"
		"&c• Flaming Sword:&f Ignites targets with everlasting celestial flames."
		"&b• Shield of Repulsion:&f A wearable aegis that deflects all incoming arrows and hostile projectiles away from you!"
	]
	quest.30457F72B086EDB3.quest_subtitle: "&7Treasures of the Golden Chest"
	quest.30457F72B086EDB3.title: "&6Spoils of the Solar Core"
	quest.308C7634DEFAE10A.quest_desc: [
		"&fCatch &dPecharunt&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.308C7634DEFAE10A.quest_subtitle: "&7Catch Pecharunt"
	quest.308C7634DEFAE10A.title: "&dPecharunt"
	quest.30AC266E5CFFA130.quest_desc: [
		"&fBeware the crimson blossoms nestled in the grass: &cAechor Plants&f."
		""
		"&fWhen approached, they spit rapid volleys of debilitating poison needles that disorient and rapidly drain your health."
		""
		"&fDefeat them from range using darts or hit-and-run tactics to gather &dAechor Petals&f. These fragrant petals are the exclusive food source required to domesticate infant Moas!"
	]
	quest.30AC266E5CFFA130.quest_subtitle: "&7Deadly Flora of the Grasslands"
	quest.30AC266E5CFFA130.title: "&cToxic Bloom"
	quest.30C33937AB1A1857.quest_desc: [
		"&fCatch &dMarshadow&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.30C33937AB1A1857.quest_subtitle: "&7Catch Marshadow"
	quest.30C33937AB1A1857.title: "&dMarshadow"
	quest.30D4914B9727ADD5.quest_desc: [
		"&fA shadowy blade born in the Deep Dark. Infused with sculk frequencies, it silences enemies and blinds them with gloom."
	]
	quest.30D4914B9727ADD5.quest_subtitle: "&7Sculk-infused rapier piercing from darkness"
	quest.30D4914B9727ADD5.title: "&5Shadowsting"
	quest.30E77CD587673030.quest_desc: [
		"&fStandard iron buckets are ill-suited for the peculiar fluids of the Aether. Instead, carve a &bSkyroot Bucket&f from Skyroot Planks."
		""
		"&fSkyroot Buckets can transport water, milk from Flying Cows, lethal &cPoison&f collected from Aechor Plants, and miraculous &aRemedy&f."
		""
		"&eNote:&f Carrying water buckets with you is essential for emergency mobility and catching yourself during fatal falls."
	]
	quest.30E77CD587673030.quest_subtitle: "&7Wooden Vessels with Thermal Insulation"
	quest.30E77CD587673030.title: "&bLiquid of the Heavens"
	quest.30F083E4A9527B88.quest_desc: [
		"&fUse an &eEye of Curse&f to search for the &eFrosted Prison&f. This is a separate expedition from the other Overworld bosses."
		"&fExplore the prison and confront &eMaledictus&f after preparing your armor and healing. Watch the attack pattern before committing to long melee exchanges."
		"&aDefeat the boss to complete this milestone.&f"
	]
	quest.30F083E4A9527B88.quest_subtitle: "&7Frosted Prison"
	quest.30F083E4A9527B88.title: "&bMaledictus"
	quest.31146FCA3C52FDA6.quest_desc: [
		"&fCatch &dIron Boulder&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.31146FCA3C52FDA6.quest_subtitle: "&7Catch Iron Boulder"
	quest.31146FCA3C52FDA6.title: "&dIron Boulder"
	quest.31301D847DBFB626.quest_desc: [
		"&fCatch &dMeloetta&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.31301D847DBFB626.quest_subtitle: "&7Catch Meloetta"
	quest.31301D847DBFB626.title: "&dMeloetta"
	quest.315D99C9D47629CA.quest_desc: [
		"&fCatch &dZacian&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.315D99C9D47629CA.quest_subtitle: "&7Catch Zacian"
	quest.315D99C9D47629CA.title: "&dZacian"
	quest.31C98E76FBD5954A.quest_desc: [
		"&fCatch &dLandorus&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.31C98E76FBD5954A.quest_subtitle: "&7Catch Landorus"
	quest.31C98E76FBD5954A.title: "&dLandorus"
	quest.327D28BF5C813E8D.quest_desc: [
		"&fForging metals and gems into &dRings&f and &dPendants&f grants permanent passive enhancements when slotted into Curios/Accessories."
		""
		"&fZanite Rings and Pendants increase mining speed, while Golden variants boost durability resilience."
		""
		"&aCombine them with Freezer transmutations to craft specialized cryogenic jewelry for exploration."
	]
	quest.327D28BF5C813E8D.quest_subtitle: "&7Jewelry of Mining and Warding"
	quest.327D28BF5C813E8D.title: "&dAdornments of the Sky"
	quest.32EBD6899BE578C7.quest_desc: [
		"&fA glowing hearthstone pulsing with magma heat."
		""
		"&fProc effect: Landing fire spells has a chance to trigger an inferno proc, granting bonus &6Fire Spell Power&f."
		""
		"&fStacks your burning damage and turns subsequent fireballs into incinerating blasts."
	]
	quest.32EBD6899BE578C7.quest_subtitle: "&6Kindled Fury"
	quest.32EBD6899BE578C7.title: "&bMedium Pyromancer's Relic"
	quest.338870A212E52F6B.quest_desc: [
		"&fIn magical forests, miniature mushroom houses mark the hamlets of &dPixies&f. These tiny winged tricksters love nothing more than snatching items directly out of your hands!"
		""
		"&bCapturing a Pixie:&f Right-click a wild pixie with an &eEmpty Pixie Jar&f. Placed in your base, captured pixies periodically produce &ePixie Dust&f."
		""
		"&fPixie Dust can be consumed for emergency levitation and healing, brewed into mystical potions, or crafted into a &ePixie Wand&f to blast levitating burst charges at enemies."
	]
	quest.338870A212E52F6B.quest_subtitle: "&7Mischievous spirits of the enchanted groves"
	quest.338870A212E52F6B.title: "&dFaerie Glades and Pixie Jars"
	quest.33AB3C6510A3DF58.quest_desc: [
		"&fNot all legendary weapons are forged with solemn dignity; some are created purely for joyous, terrifying absurdity!"
		""
		"• &dChompolotl:&f An energetic axolotl-themed polearm that snaps aggressively at foes."
		"• &6Sword on a Stick:&f A literal iron sword strapped to a stick that can be hurled as an explosive spear."
		""
		"&aDiscovery:&f Offer a &eContained Remnant&f onto a &bTube Coral Block&f or test your luck in dungeon chests!"
	]
	quest.33AB3C6510A3DF58.quest_subtitle: "&7Chomping axolotls and literal swords on sticks"
	quest.33AB3C6510A3DF58.title: "&d★ Whimsical Armaments"
	quest.33D309E5040CFCC0.quest_desc: [
		"&fPerform a real &dMega Evolution&f in battle."
		""
		"&fThis is the required mechanical finish of the Mega branch. Owning the components is not enough—you must successfully activate the transformation."
	]
	quest.33D309E5040CFCC0.quest_subtitle: "&7Bring the Trainer item, Pokémon stone and battle action together"
	quest.33D309E5040CFCC0.title: "&d★ Mega Evolve"
	quest.34285CB18AF2317E.quest_desc: [
		"&fAcross frozen glacial wastelands, imposing dark stone structures known as &8Mausoleums&f generate locked behind cursed doors."
		""
		"&fIn the surrounding tundra, hunt &8Dread Liches&f to obtain a &eDread Key&f. Unlocking the gate reveals labyrinthine crypts filled with dread spawners, dread knights, dread scuttlers, and horrifying undead thralls."
		""
		"&fConquering the mausoleum grants broken dragon forge parts, rare dread artifacts, and dark dread shards."
	]
	quest.34285CB18AF2317E.quest_subtitle: "&7Citadel of the northern undead"
	quest.34285CB18AF2317E.title: "&8The Frozen Tomb: Dread Mausoleum"
	quest.3442A5DBF9EC3366.quest_desc: [
		"&fCatch &dCelesteela&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.3442A5DBF9EC3366.quest_subtitle: "&7Catch Celesteela"
	quest.3442A5DBF9EC3366.title: "&dCelesteela"
	quest.34F1E67EDF4CD09E.quest_desc: [
		"&fRegister &e50 Fire-type Pokémon&r&f in your Pokédex."
		""
		"&7Dual-type Pokémon count when Fire is one of their types."
	]
	quest.34F1E67EDF4CD09E.quest_subtitle: "&7Register 50 Fire-type Pokémon"
	quest.34F1E67EDF4CD09E.title: "&6Fire Mastery&r"
	quest.354DF0B8808A5668.quest_desc: [
		"&fThe ruler of the temple refuses to duel mere wanderers. You must prove your chivalry and martial prowess to her elite guard."
		""
		"&fChallenge the Valkyrie knights roaming the corridors. When defeated in honorable combat, each knight yields a &eVictory Medal&f."
		""
		"&aGather 10 Victory Medals to earn the right to summon and face the Valkyrie Queen in the throne chamber."
	]
	quest.354DF0B8808A5668.quest_subtitle: "&7Earning an Audience with the Queen"
	quest.354DF0B8808A5668.title: "&eTen Medals of Valor"
	quest.35914107DE7A9A3D.quest_desc: [
		"&fBlinding thrusts that completely disregard armor, coupled with innate runic spell triggers. Deadly in single combat."
	]
	quest.35914107DE7A9A3D.quest_subtitle: "&7Armor-piercing dueling blade rolled with runic speed"
	quest.35914107DE7A9A3D.title: "&dRunic Rapier"
	quest.35CEE133EBACDC43.quest_desc: [
		"&fA crystalline rapier forged from glacial ice. Each thrust inflicts deep freezing chill, slowing enemy movement and attack cadence to a crawl."
	]
	quest.35CEE133EBACDC43.quest_subtitle: "&7Glacial rapier chilling enemies to the marrow"
	quest.35CEE133EBACDC43.title: "&bFrostfall"
	quest.35DF9FE05B86F77B.quest_desc: [
		"&fIn a &bSmithing Table&f, combine a &dRunic Tablet&f (template), an &eEmpowered Remnant&f (base), and a &8Netherite Ingot&f (addition) to forge a potent &4Netherfused Gem&f."
		""
		"&fNetherfused gems tap into volatile underworld powers such as &cBerserk&f, &cOnslaught&f, &cRadiance&f, &cEcho&f, &cNullification&f, or beast summons. Insert it into a Netherfused socket to grant your weapon devastating supplementary attacks."
	]
	quest.35DF9FE05B86F77B.quest_subtitle: "&7Infernal jewel rolled with aggressive combat arts"
	quest.35DF9FE05B86F77B.title: "&4Netherfused Gem"
	quest.35DFCEF6E4C41D8B.quest_desc: [
		"&fAt the highest spire of the palace hovers the &bSnow Queen&f, suspended upon a floating disc of solid ice."
		""
		"&bThe Encounter:&f"
		"&f• She commands swirling ice minions that absorb attacks; shatter them before targeting her."
		"&f• She repeatedly flies upward and attempts to drop down to crush the player. Dodge aside when she falls!"
		"&f• While she floats horizontally, unleash ranged attacks directly into her crown."
		""
		"&aVictory rewards the Snow Queen Trophy&f along with legendary magical bows: the &eTriple Bow&f (firing 3 arrows at once) or the &eSeeker Bow&f (firing homing arrows)!"
	]
	quest.35DFCEF6E4C41D8B.quest_subtitle: "&7Ruler of the Aurora Palace summit"
	quest.35DFCEF6E4C41D8B.title: "&bSovereign of the Sleet: Snow Queen"
	quest.366EB16F508EBAD7.quest_desc: [
		"&fA carved bone emblem consecrated to frontline duelists."
		""
		"&fProc mechanic: Landing any critical strike temporarily increases your &bCritical Strike Damage&f for consecutive follow-up strikes."
		""
		"&fIncentivizes relentless offensive pressure, turning weapon attack combos into devastating execution chains."
	]
	quest.366EB16F508EBAD7.quest_subtitle: "&bMomentum Carnage"
	quest.366EB16F508EBAD7.title: "&fLesser Executioner's Sigil"
	quest.36826CA9D17F379E.quest_desc: [
		"&fBuild an &eImbuement Chamber&f and obtain a &eSource Gem&f. Place the recipe input into the chamber; the installed recipes accept materials such as amethyst or lapis."
		"&fBasic imbuing can progress without a Source network. Nearby stored Source speeds it up. Essence recipes may also require items on nearby Arcane Pedestals."
		"&7Use the notebook's placement instructions and EMI for the exact recipe."
	]
	quest.36826CA9D17F379E.quest_subtitle: "&7Turn common crystals into magical material."
	quest.36826CA9D17F379E.title: "&aMake Source Gems"
	quest.36F77C65B1037604.quest_desc: [
		"&fForged from Dragonsteel and dragonbone handles, &4Dragonsteel Swords&f deal astronomical base damage, boast thousands of durability points, and inherit permanent elemental strike properties."
		""
		"&fA Fire Dragonsteel blade permanently scorches targets, an Ice Dragonsteel blade freezes enemies into ice cubes, and a Lightning Dragonsteel blade calls down destructive thunderbolts."
		""
		"&aNo mortal creature or monstrous titan can survive sustained combat against this blade.&f"
	]
	quest.36F77C65B1037604.quest_subtitle: "&7Weapons that split mountains"
	quest.36F77C65B1037604.title: "&4The Cataclysm Blade"
	quest.374846CF30213B4E.quest_desc: [
		"&fHostile creatures wander constantly beneath the dim stellar glow of the dimension."
		""
		"&fFortunately, the native wood of the &eTorreya&f tree holds natural protective properties. Crafting and lighting a &eTorreya Campfire&f establishes a wide sanctuary perimeter that &bprevents hostile monster spawns&f entirely within its vicinity."
		""
		"&aSet up your primary outpost around a Torreya Campfire&f to guarantee a safe return point after dangerous expeditions."
	]
	quest.374846CF30213B4E.quest_subtitle: "&7Safe haven under a darkling sky"
	quest.374846CF30213B4E.title: "&aTwilight Sanctuary"
	quest.374B8A3511DBA63A.quest_desc: [
		"&fCatch &dLatios&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.374B8A3511DBA63A.quest_subtitle: "&7Catch Latios"
	quest.374B8A3511DBA63A.title: "&dLatios"
	quest.375001C6DBBE8A37.quest_desc: [
		"&fA massive runic warhammer. Combining the greathammer's innate armor sunder with raw elemental or runic impact."
		""
		"&fForged in a smithing table from a &eNetherite Greathammer&f using a &dRunic Tablet&f and a &bDiamond&f."
	]
	quest.375001C6DBBE8A37.quest_subtitle: "&7Armor-shattering crushing hammer infused with runes"
	quest.375001C6DBBE8A37.title: "&dRunic Greathammer"
	quest.37D2DEEE14F75458.quest_desc: [
		"&fExtended reach meets runic sorcery. Skewer enemies beyond their counterattack threshold while unleashing your rolled power."
	]
	quest.37D2DEEE14F75458.quest_subtitle: "&7Long-reach runic spear piercing enemy vanguard"
	quest.37D2DEEE14F75458.title: "&dRunic Spear"
	quest.380875CAACF51462.quest_desc: [
		"&fSearch the outer End islands for the &eObsidilith&f arena. Bring Eyes of Ender for its summoning arrangement and protect yourself from falls on the journey."
		"&fWhen the boss becomes protected, look for the arena's active rune blocks rather than continuing to attack an invulnerable target."
		"&aDefeat the boss; its advancement completes this quest.&f"
	]
	quest.380875CAACF51462.quest_subtitle: "&7A boss milestone, not an inventory checklist."
	quest.380875CAACF51462.title: "&bThe Obsidilith"
	quest.382C7217C7FDF203.quest_desc: [
		"&fCraft a &eCopper Expedition Board&f and open it. Select an available expedition and Pokémon, then inspect the displayed success chance and duration before sending them."
		"&fUse the &bActive&f tab to monitor progress and the &bRewards&f inbox to collect completed returns. Choose a suitable mode for the goal you want."
		"&fBoard ranks and upgrades unlock further options. The higher-tier recipes are expensive, so learn the copper board before spending blocks of rare materials."
		"&7This objective collects the board; it does not claim that an expedition has already finished."
	]
	quest.382C7217C7FDF203.quest_subtitle: "&7Choose Pokémon, inspect the odds and collect the return."
	quest.382C7217C7FDF203.title: "&6Send an Expedition"
	quest.38469EE5648A2BFA.quest_desc: [
		"&fAn active trinket pulsating with raw kinetic vigor."
		""
		"&fActive ability: When triggered via your &bTrinket / Curio keybind&f, grants a temporary surge of bonus &ePhysical Attack Damage&f."
		""
		"&aActivate right before unleashing your heaviest weapon combo or execution skill for a devastating burst window."
	]
	quest.38469EE5648A2BFA.quest_subtitle: "&bUnbridled Burst Strength"
	quest.38469EE5648A2BFA.title: "&fLesser Relic of Force"
	quest.3913EA646AB911F5.quest_desc: [
		"&fMastery over raw atmospheric fury:"
		""
		"• &eTempest:&f Chakram attaching elemental charges to targets, pulling them inward into a vortex of lightning."
		"• &eThunderbrand:&f Halberd that charges invulnerability and dashes through lines in a flash of chain lightning."
		""
		"&fAcquire both to complete your tempestuous armory!"
	]
	quest.3913EA646AB911F5.quest_subtitle: "&7The apex of storm chakrams and lightning halberds"
	quest.3913EA646AB911F5.title: "&eThe Living Storm"
	quest.392C34C6D335D789.quest_desc: [
		"&fA refined celestial relic vibrating with cosmic frequencies."
		""
		"&fProc effect: Damaging enemies with spells grants a chance to trigger a substantial &dArcane Power&f boost."
		""
		"&fPowers up arcane barrage, teleport strikes, and reality-warping spells into catastrophic strikes."
	]
	quest.392C34C6D335D789.quest_subtitle: "&dAstral Resonator"
	quest.392C34C6D335D789.title: "&bMedium Arcane Surge Relic"
	quest.393494DC7EEF2CA2.quest_desc: [
		"&fA crimson cutlass thirsting for vitality. Every slash draws scarlet lifeforce, healing the wielder while unleashing sanguinary shockwaves."
	]
	quest.393494DC7EEF2CA2.quest_subtitle: "&7Sanguine cutlass drinking the lifeforce of targets"
	quest.393494DC7EEF2CA2.title: "&4Bloodwake"
	quest.397C4ACB3BA3D384.quest_desc: [
		"&fObtain a &5Max Mushroom&f."
		""
		"&fMax Mushrooms are part of the recipe chain that leads into Max Soup and the Gigantamax side of the system."
	]
	quest.397C4ACB3BA3D384.quest_subtitle: "&7The ingredient behind Gigantamax preparation"
	quest.397C4ACB3BA3D384.title: "&5Max Mushrooms"
	quest.398404A249874E2E.quest_desc: [
		"&fDefeat a &etier-three raid&f after preparing a stronger team. Improve type coverage, held items and recovery rather than relying only on a higher level."
		"&7This is a later optional challenge. It does not unlock the Battle Tower, gyms or expeditions."
	]
	quest.398404A249874E2E.quest_subtitle: "&7An optional tier-three challenge."
	quest.398404A249874E2E.title: "&6A Stronger Raid Team"
	quest.39FE9D1261E5FD0D.quest_desc: [
		"&fTwo final esoteric mysteries await the inquisitive master:"
		""
		"• &eThe Crystalborn Catalyst&f: Powered by redstone and fueled by crystal shards, this miraculous apparatus spreads and harvests crystalline clusters automatically."
		"• &eEther Cleansing&f: Immerse a weathered &eShattered Sword&f into an Ether pool to chemically strip ancient corrosion, restoring the pristine &eShattered Sword Blade&f for reforging!"
	]
	quest.39FE9D1261E5FD0D.quest_subtitle: "&7Crystal proliferation and blade cleansing"
	quest.39FE9D1261E5FD0D.title: "&dCatalysts and Transmutations"
	quest.3A26D28C67BC754E.quest_desc: [
		"&fThe &eLongsword&f serves as the balanced cornerstone of standard martial weapons. Crafted from common iron, it trades a sliver of attack speed for extended reach and higher base damage than a vanilla iron sword."
		""
		"&fLongswords feature the &bDeflection&f implicit ability, granting a small chance on hit to deflect a portion of incoming damage. Forge your first blade to begin climbing the material tiers."
	]
	quest.3A26D28C67BC754E.quest_subtitle: "&7Balanced reach and steady iron guard"
	quest.3A26D28C67BC754E.title: "&fIron Tempering"
	quest.3A918BFE0CBC8AC7.quest_desc: [
		"&fCatch &dTapu Koko&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.3A918BFE0CBC8AC7.quest_subtitle: "&7Catch Tapu Koko"
	quest.3A918BFE0CBC8AC7.title: "&dTapu Koko"
	quest.3AED514A08C392D2.quest_desc: [
		"&fCatch &dVirizion&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.3AED514A08C392D2.quest_subtitle: "&7Catch Virizion"
	quest.3AED514A08C392D2.title: "&dVirizion"
	quest.3B78E292884EFC50.quest_desc: [
		"&fCatch &dType: Null&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.3B78E292884EFC50.quest_subtitle: "&7Catch Type: Null"
	quest.3B78E292884EFC50.title: "&dType: Null"
	quest.3B8731113575B5DF.quest_desc: [
		"&fThe preferred blade of buccaneers and seafaring adventurers. Broad, curved, and fast in close quarters."
		""
		"&fFeatures the &bPlunder&f implicit: striking down monsters with a cutlass grants a chance to roll additional loot drops!"
	]
	quest.3B8731113575B5DF.quest_subtitle: "&7Swashbuckling sabre that plunders bonus loot"
	quest.3B8731113575B5DF.title: "&fDiamond Cutlass"
	quest.3B878CBDBE369E99.quest_desc: [
		"&fObtain &5Max Soup&f."
		""
		"&fIt is the central consumable in the Gigantamax preparation chain for compatible Pokémon."
	]
	quest.3B878CBDBE369E99.quest_subtitle: "&7Prepare the meal used for Gigantamax progression"
	quest.3B878CBDBE369E99.title: "&5Max Soup"
	quest.3B8FAA1837F8A88B.quest_desc: [
		"&fA silver duelist's brooch blessed by master duelists."
		""
		"&fPerk mechanic: Successfully evading an incoming strike empowers your next attack with lethal &bBonus Counter-Damage&f."
		""
		"&fTransforms evasion from a purely defensive evasion tool into a high-octane offensive weapon."
	]
	quest.3B8FAA1837F8A88B.quest_subtitle: "&bTurn Defense into Retaliation"
	quest.3B8FAA1837F8A88B.title: "&dGreater Perk: Riposte"
	quest.3B996485D29AF54F.quest_desc: [
		"&fAn elegant frozen blade humming with arctic whispers. Encases targets in solid ice blocks on critical strikes."
	]
	quest.3B996485D29AF54F.quest_subtitle: "&7Arctic steel freezing foes in solid ice blocks"
	quest.3B996485D29AF54F.title: "&bIcewhisper"
	quest.3B9B9E87D4F40AE2.quest_desc: [
		"&fA phantom polearm that stalks the wounded. Marks targets for spiritual severance, granting invisibility and lethal burst strikes."
	]
	quest.3B9B9E87D4F40AE2.quest_subtitle: "&7Phantom polearm stalking prey through the mist"
	quest.3B9B9E87D4F40AE2.title: "&3Soulstalker"
	quest.3BD896016246C264.quest_desc: [
		"&bResonarium&f is an extraordinary vibrational mineral crystal found embedded in the deep stone veins of The Otherside."
		""
		"&fWhen struck, it resonates at a pure sonic pitch that destabilizes kinetic energy, making it an incredible material for armor plating and specialized electronics."
	]
	quest.3BD896016246C264.quest_subtitle: "&7Mine the crystal of the Otherside"
	quest.3BD896016246C264.title: "&bResonarium"
	quest.3C7BCACC111ACEAD.quest_desc: [
		"&fScattered across high plateaus are stunning &6Golden Oak Trees&f adorned with brilliant golden leaves."
		""
		"&fThese ancient trees produce dense sapwood. When you chop a Golden Oak Log using a &dZanite Axe&f or better, crystalline drops of &6Golden Amber&f will break free!"
		""
		"&aGolden Amber is essential for manufacturing Golden Darts and advanced celestial equipment."
	]
	quest.3C7BCACC111ACEAD.quest_subtitle: "&7Amber Droplets from Autumnal Canopies"
	quest.3C7BCACC111ACEAD.title: "&6Sap of the Golden Tree"
	quest.3CABC511B07F9290.quest_desc: [
		"&fWhen a &3Sculk Shrieker&f is triggered four times, the monstrous &cWarden&f emerges from the deep floor."
		""
		"&fBoasting 500 health and devastating sonic shrieks that bypass barriers, facing the Warden requires thorough preparation: high-tier ranged weapons, strength potions, and vertical terrain advantage."
		""
		"&fUpon defeat, the beast sheds &eWarden Carapace&f—a fireproof, rock-hard chitinous plate that forms the basis of all endgame abyssal smithing."
	]
	quest.3CABC511B07F9290.quest_subtitle: "&7Defeat the guardian of the Deep Dark"
	quest.3CABC511B07F9290.title: "&cWarden Carapace"
	quest.3CF05B98E615CAC8.quest_desc: [
		"&fComplete Cataclysm's &eall-bosses advancement&f by defeating the eight major bosses shown above."
		"&fThis is the optional final challenge. You do not need to finish it to use the equipment earned from individual encounters."
		"&aYour reward supports the next expedition rather than replacing a boss's unique equipment.&f"
	]
	quest.3CF05B98E615CAC8.quest_subtitle: "&7Complete all eight major boss encounters."
	quest.3CF05B98E615CAC8.title: "&bMaster of the Hunts"
	quest.3D4CBF374EB93EFF.quest_desc: [
		"&fA pocket chronometer humming with unstable arcane rhythm."
		""
		"&fProc effect: Spell impacts have a chance to trigger a massive boost to &bSpell Haste&f."
		""
		"&fTurns casting sequences into a seamless, rapid-fire stream of spells without downtime."
	]
	quest.3D4CBF374EB93EFF.quest_subtitle: "&dSwift Sorcery"
	quest.3D4CBF374EB93EFF.title: "&bMedium Channeller's Relic"
	quest.3E106D44040F5F68.quest_desc: [
		"&fExcavated from deep within the subterranean mining tunnels of Sinnoh's Grand Underground:"
		""
		"&e• Skull Fossil&f: The thickened domed skull of &bCranidos&f, a ferocious pachycephalosaur that evolves into &cRampardos&f, boasting one of the highest Attack stats in existence!"
		"&e• Armor Fossil&f: The impenetrable facial collar of &bShieldon&f, a sturdy ceratopsian that evolves into &bBastiodon&f, an unyielding steel-faced fortress."
		""
		"&aThe ultimate clash of unstoppable force versus immovable object.&f"
	]
	quest.3E106D44040F5F68.quest_subtitle: "&7Skull and Armor Fossils"
	quest.3E106D44040F5F68.title: "&6Sinnoh Titans: The Ram and Shield"
	quest.3E1A639B0ED6FD45.quest_desc: [
		"&fThe Aether introduces the &eGloves&f accessory slot to Minecraft."
		""
		"&fCrafted from leather, iron, gold, diamond, zanite, or gravitite, gloves enhance barehanded attack strength and provide additional armor rating."
		""
		"&bCrucial Mechanic:&f Many legendary Aether armor sets (such as Gravitite, Valkyrie, and Phoenix) &conly activate their complete passive set bonuses&f when matching gloves are equipped alongside the four armor pieces!"
	]
	quest.3E1A639B0ED6FD45.quest_subtitle: "&7Punch Damage and Armor Set Synergy"
	quest.3E1A639B0ED6FD45.title: "&eHeavenly Gloves"
	quest.3E1B95B309A4644A.quest_desc: [
		"&fHaunting the cursed swamplands and overgrown ruins are the &cTangled Husks&f—restless corpses bound in suffocating briars."
		""
		"&fExtinguish their misery to harvest &bSoul Dew&f (formerly known as Trapped Soul). This ethereal, pulsating essence represents the pure spiritual quintessence required to bind dissimilar metals together into true perfection."
	]
	quest.3E1B95B309A4644A.quest_subtitle: "&7Extracting the spiritual catalyst"
	quest.3E1B95B309A4644A.title: "&9Trapped Souls: Soul Dew"
	quest.3E1DBF46D0804473.quest_desc: [
		"&fOne slip off an island precipice will send you plummeting down into the Overworld void."
		""
		"&fCraft a &bCold Parachute&f from Cold Aerclouds. When falling into empty space, activating a parachute immediately halts vertical velocity and glides you gently downward."
		""
		"&eNote:&f A Cold Parachute dissolves after a single deployment. Upgrading it to a &6Golden Parachute&f with Golden Aerclouds yields twenty safe deployments before breaking!"
	]
	quest.3E1DBF46D0804473.quest_subtitle: "&7Surviving Catastrophic Island Falls"
	quest.3E1DBF46D0804473.title: "&bDescent Insurance"
	quest.3E1E90E95C3C00A1.quest_desc: [
		"&fBrushing suspicious gravel across ancient ruins reveals five distinct Cobblemon pottery sherds:"
		""
		"&e• Bygone Sherd&f: Depicts primordial titans of the earth."
		"&e• Dome Sherd&f: Etched with the curved carapace of ancient Kabuto."
		"&e• Helix Sherd&f: Inscribed with the sacred spiral of Lord Helix."
		"&e• Nostalgic Sherd&f: Commemorates the earliest pioneer trainers."
		"&e• Suspicious Sherd&f: Bears the mysterious silhouette of an impostor."
		""
		"&fCombine four sherds around a crafting table to fire an ornate &6Decorated Pot&f!&f"
	]
	quest.3E1E90E95C3C00A1.quest_subtitle: "&7The Artistry of Forgotten Eras"
	quest.3E1E90E95C3C00A1.title: "&6Prehistoric Glazes: Ancient Pottery Sherds"
	quest.3E2619DF9C7DF396.quest_desc: [
		"&fWhen you first arrive in the Aether, the sun never sets—an eternal, blinding noon blankets the skylands."
		""
		"&fVanquishing the &6Sun Spirit&f breaks this ancient cosmic lock, allowing the dimension to experience nocturnal starlight and dawn."
		""
		"&fFurthermore, you can claim the &eSun Altar&f from his chamber. Placing and interacting with the Sun Altar allows you to freely manipulate the time of day, commanding the rising and setting of the sun at your whim!"
	]
	quest.3E2619DF9C7DF396.quest_subtitle: "&7Breaking Eternal Daylight"
	quest.3E2619DF9C7DF396.title: "&eHarnessing the Dawn"
	quest.3E7E8674FD12EE06.quest_desc: [
		"&fSurface roosts host &eStage 3 Dragons&f. While smaller than cave-dwelling behemoths, their aerial bombardment can wipe out unprepared warriors."
		""
		"&aTactical Guide for Slayers:&f"
		"&f1. Drink a &eFire Resistance Potion&f if confronting a Fire Dragon."
		"&f2. Keep behind high terrain or build barricades from obsidian or dragon bone blocks."
		"&f3. Shoot heavy arrows at its wings to force the dragon down to the earth."
		""
		"&fOnce slain, the dragon collapses into a massive skeleton. Harvest its remains by right-clicking with an empty hand to gather &eDragon Bones&f."
	]
	quest.3E7E8674FD12EE06.quest_subtitle: "&7Your first victorious dragon hunt"
	quest.3E7E8674FD12EE06.title: "&4Felling the Sky Beast"
	quest.3E8A0000000BD325.quest_desc: [
		"&fComplete the 3 quests before this one to obtain all craftable poke balls."
	]
	quest.3E8A0000000BD325.quest_subtitle: "&7Obtain all craftable poke balls"
	quest.3E8A0000000BD325.title: "&cSpecialized Poké Balls"
	quest.3E8A00000014C51A.quest_desc: [
		"&fUse &amints&f to change pokemon natures to increase your best stats."
	]
	quest.3E8A00000014C51A.quest_subtitle: "Obtain all mints"
	quest.3E8A00000014C51A.title: "&aNatures"
	quest.3E8A00000015BA45.quest_desc: [
		"&aPower items&f increase EV gains."
	]
	quest.3E8A00000015BA45.quest_subtitle: "Obtain all EV increasing items"
	quest.3E8A00000015BA45.title: "&eEVs"
	quest.3E8A00000017F80D.quest_desc: [
		"&fAn &bAbility Capsule&f changes your pokemons ability to its alternate ability. An &bAbility Patch&f changes your pokemons ability to its hidden ability."
	]
	quest.3E8A00000017F80D.quest_subtitle: "Obtain all ability changing items"
	quest.3E8A00000017F80D.title: "&dAbilities"
	quest.3E8A0000001C702B.quest_desc: [
		"&aTM's&f teach a pokemon new moves."
		""
	]
	quest.3E8A0000001C702B.quest_subtitle: "&7Craft a TM machine."
	quest.3E8A0000001C702B.title: "&bTMs"
	quest.3E8F7FF7B7E21F67.quest_desc: [
		"&fA dual-aspected crystal crackling with violet sparks and flame."
		""
		"&fProc mechanic: Dealing spell damage has a chance to trigger a synergistic burst of both &dArcane&f and &6Fire&f magic."
		""
		"&fMagnifies the destruction of hybrid elemental mages who weave fireballs with arcane bursts in their spell rotation."
	]
	quest.3E8F7FF7B7E21F67.quest_subtitle: "&bPyric Arcana Synergy"
	quest.3E8F7FF7B7E21F67.title: "&fLesser Spellweaver's Catalyst"
	quest.3E98DDC80562D539.quest_desc: [
		"&fA hybrid polearm combining axe-head chopping with spear thrusting. Slower than a spear, but hits noticeably harder across wide sweeps."
		""
		"&fInnate &bLaceration&f implicit causes foes caught in its wide perimeter to hemorrhage health."
	]
	quest.3E98DDC80562D539.quest_subtitle: "&7Heavy poleaxe delivering wide bleeding swings"
	quest.3E98DDC80562D539.title: "&fDiamond Halberd"
	quest.3ED1C14CD3070B66.quest_desc: [
		"&fUse &b/sethome&f and &b/home&f for your base, &b/spawn&f for the hub, and &b/tpa&f to meet another player."
		"&fUse &b/rtp&f to find fresh Overworld terrain."
	]
	quest.3ED1C14CD3070B66.quest_subtitle: "Set your home and teleport all over the place!"
	quest.3ED1C14CD3070B66.title: "&bHomes and Server Travel"
	quest.3EE1115397604E19.quest_desc: [
		"&fA miniature polished tower shield forged from hardened alloy."
		""
		"&fProc effect: Receiving damage has a chance to proc a heavy &9Defense / Armor&f boost."
		""
		"&fActs as an automated reactive shield, softening dangerous multi-hit attacks from mob swarms."
	]
	quest.3EE1115397604E19.quest_subtitle: "&9Bulwark Response"
	quest.3EE1115397604E19.title: "&bMedium Aegis Relic"
	quest.3F4D20241B0FF398.quest_desc: [
		"&fIn a &bSmithing Table&f, combine a &dRunic Tablet&f (template), an &eEmpowered Remnant&f (base), and &5Crying Obsidian&f (addition) to create a &dRunefused Gem&f."
		""
		"&fWhen created, the gem rolls an ability from the Runic Power pool (such as &bZephyr&f, &bFrost Ward&f, &bMomentum&f, or &bDancing Blades&f). Hold &bAlt&f on any compatible weapon to view its available sockets."
		""
		"&fTo socket, either click the gem directly onto the weapon in your inventory or insert both into the &eRunic Forge&f!"
	]
	quest.3F4D20241B0FF398.quest_subtitle: "&7Socketable runic jewel rolled with utility or warding"
	quest.3F4D20241B0FF398.title: "&dRunefused Gem"
	quest.3FA86A17C313E0F1.quest_desc: [
		"&fUpgrade standard &eIron Armor&f in a Smithing Table using Resonarium Plates and the Resonarium Template to create this astonishing defensive set."
		""
		"&bAbsolute Protection:&f Each worn piece reduces incoming damage by &a25%&f. Wearing the complete set &lcompletely negates 100% of all incoming damage&f!"
		""
		"&cThe Catch:&f The armor absorbs the entire blow into its structural integrity, losing durability rapidly when struck (similar to Wolf Armor). It cannot accept Protection or Mending, but can be repaired at an anvil using raw &bResonarium&f."
	]
	quest.3FA86A17C313E0F1.quest_subtitle: "&7Forge a complete defensive set"
	quest.3FA86A17C313E0F1.title: "&bResonarium Armor"
	quest.3FD54C6D176262FA.quest_desc: [
		"&fLost relics of ancient starlight travelers grant miraculous mobility:"
		""
		"• &eEtheric Eye&f: Channel this mystical talisman deep within dark abysses to instantly &bteleport directly up to the world surface&f, escaping subterranean traps effortlessly."
		"• &eWand of Teleportation&f: Casts localized short-range blink spells, phasing you through hazardous terrain and dodging incoming attacks."
	]
	quest.3FD54C6D176262FA.quest_subtitle: "&7Planar teleportation and blink wands"
	quest.3FD54C6D176262FA.title: "&6Relics of Translocation"
	quest.402291AC55774BAC.quest_desc: [
		"&fBy bonding a &dDragon Summoning Crystal&f to your dragon, you forge a permanent quantum tether to its consciousness."
		""
		"&bRecall Function:&f Should your dragon become trapped in a distant dimension, fall through the world, or wander away while exploring, using the crystal instantly summons it straight to your current coordinates."
		""
		"&aA mandatory safety precaution for any master traveling across treacherous modded dimensions.&f"
	]
	quest.402291AC55774BAC.quest_subtitle: "&7Never lose your bonded companion"
	quest.402291AC55774BAC.title: "&dBound Across Realities: Summoning Crystal"
	quest.4025EE4781ED7965.quest_desc: [
		"&fCatch &dHo-Oh&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.4025EE4781ED7965.quest_subtitle: "&7Catch Ho-Oh"
	quest.4025EE4781ED7965.title: "&dHo-Oh"
	quest.4038AF3B605A0C69.quest_desc: [
		"&fAt the lowest floor of the Bronze Labyrinth sits &4The Slider&f, a titanic animated cube of living dungeon stone."
		""
		"&cCRITICAL STRATEGY:&f Swords and bows deal virtually zero damage to The Slider! Because his body is composed of enchanted granite, he is &cvulnerable ONLY to Pickaxes&f! Use a Zanite or Gravitite Pickaxe."
		""
		"&bMechanics:&f When struck, his glowing eyes cycle from calm blue to enraged red. He will slide rapidly across the arena, smashing into walls. Dodge his charges and hammer him with pickaxe blows until he shatters!"
	]
	quest.4038AF3B605A0C69.quest_subtitle: "&7Boss: The Slider"
	quest.4038AF3B605A0C69.title: "&4Heavyweight Collision"
	quest.405CACEC877409A9.quest_desc: [
		"&fA humming chronomantic chime that bends local magical flow."
		""
		"&fActive ability: Provides a rapid surge of &bSpell Haste&f, slashing cast times and channeling tick delays for a brief period."
		""
		"&fEssential for spellcasters who need to cast long-charge elemental spells before getting interrupted by fast monsters."
	]
	quest.405CACEC877409A9.quest_subtitle: "&bRapid Incantations"
	quest.405CACEC877409A9.title: "&fLesser Relic of Quickening"
	quest.406FC814C58C5AEE.quest_desc: [
		"&fCatch &dCosmog&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.406FC814C58C5AEE.quest_subtitle: "&7Catch Cosmog"
	quest.406FC814C58C5AEE.title: "&dCosmog"
	quest.40D6F3A05B2C75E3.quest_desc: [
		"&fThe &cStorage Controller&f transforms individual containers into a single, cohesive warehouse network."
		""
		"&bCore Abilities&f:"
		"&f• Scans and connects all touching Sophisticated Storage chests, barrels, and limited barrels."
		"&f• &bDouble Right-Click&f the controller face with any item, and it automatically deposits all matching items from your inventory into the correct designated containers across the entire room!"
		"&f• Serves as the central connection hub for external pipes, hoppers, and logistics systems."
		""
		"&aPlace this in the center of your storage wall for one-click inventory unloading.&f"
	]
	quest.40D6F3A05B2C75E3.quest_subtitle: "&7The unified nerve center of the warehouse"
	quest.40D6F3A05B2C75E3.title: "&cThe Storage Controller"
	quest.40FFED4044CE7C93.quest_desc: [
		"&fCatch &dDialga&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.40FFED4044CE7C93.quest_subtitle: "&7Catch Dialga"
	quest.40FFED4044CE7C93.title: "&dDialga"
	quest.418F05270C45F9B5.quest_desc: [
		"&fYour dragon is powerful, but wild dragons, wither bosses, and archers can still inflict severe damage during chaotic aerial dogfights."
		""
		"&fProtect your mount by crafting four pieces of specialized &bDragon Armor&f: Head, Neck, Body, and Tail."
		""
		"&fAvailable in copper, silver, iron, gold, diamond, and netherite tiers, barding transforms your mount into an unkillable flying dreadnought."
	]
	quest.418F05270C45F9B5.quest_subtitle: "&7Forging draconic barding"
	quest.418F05270C45F9B5.title: "&bArmor for an Emperor"
	quest.41EF28B842F50CE8.quest_desc: [
		"&fReforging the Decaying Relic into a sword produces the &bMagiblade&f. Infused with arcane brilliance, its slashes channel concentrated spell power."
	]
	quest.41EF28B842F50CE8.quest_subtitle: "&7Arcane spellblade evolved from the decaying relic"
	quest.41EF28B842F50CE8.title: "&bMagiblade"
	quest.420A71C77A6115E7.quest_desc: [
		"&fCatch &dYveltal&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.420A71C77A6115E7.quest_subtitle: "&7Catch Yveltal"
	quest.420A71C77A6115E7.title: "&dYveltal"
	quest.4282843FFC05F885.quest_desc: [
		"&fUpgrade Netherite tools with Reinforced Echo Shards to forge the &1Warden Arsenal&f."
		""
		"&fBoasting &e2,519 Durability&f, a blinding &b10.0 Mining Speed&f, high enchantability, and devastating base attack damage, they will outlast and outperform any tool in existence."
	]
	quest.4282843FFC05F885.quest_subtitle: "&7Unmatched speed and raw damage"
	quest.4282843FFC05F885.title: "&1The Monarch's Arsenal"
	quest.42B4DC9DC48227D3.quest_desc: [
		"&fA grand ceremonial greatsword decorated with crimson battle ribbons. Delivers punishing cleaving blows that grant bursts of resilience and damage resistance."
	]
	quest.42B4DC9DC48227D3.quest_subtitle: "&7Ceremonial cleaver building unyielding battle resilience"
	quest.42B4DC9DC48227D3.title: "&cRibboncleaver"
	quest.42DC2C9E77BE225E.quest_desc: [
		"&fCatch &dAzelf&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.42DC2C9E77BE225E.quest_subtitle: "&7Catch Azelf"
	quest.42DC2C9E77BE225E.title: "&dAzelf"
	quest.42E042FE6ACE3DB3.quest_desc: [
		"&fEntering the sanctum summons six &7Knight Phantoms&f, ghostly suits of armor wielding spectral broadswords and axes."
		""
		"&bCombat:&f The phantoms phase freely through the walls and floor, circling the room before charging. Time your swings as they materialize, or use wide sweeping weapons to hit multiple phantoms simultaneously."
		""
		"&aRewards:&f Defeating the council grants &eKnightmetal Ingots&f, Phantom Armor, and the Knight Phantom Trophy, permanently deactivating the dark shielding surrounding the towering Dark Tower!"
	]
	quest.42E042FE6ACE3DB3.quest_subtitle: "&7Restless specters in floating armor"
	quest.42E042FE6ACE3DB3.title: "&7Phantoms of the Round: Knight Phantom"
	quest.435B22D803E6A51A.quest_desc: [
		"&fCataclysm bosses occupy their own structures. Use the matching &eEye&f locator listed in each entry and check its recipe in EMI before travelling."
		"&fBring repaired armor, healing, a dependable melee weapon and a way to retreat. Establish a return route outside the arena before starting the fight."
		"&fThe four labeled pairs organize destinations. You can choose any encounter you are prepared for; one unrelated boss does not unlock another."
		"&7Boss tasks use the mod's defeat advancements. Finding a structure or collecting someone else's drop does not replace the fight."
	]
	quest.435B22D803E6A51A.quest_subtitle: "&7Independent expeditions, not a forced boss ladder."
	quest.435B22D803E6A51A.title: "&bBefore the Hunt"
	quest.4361DCD028612E8E.quest_desc: [
		"&fCatch &dThundurus&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.4361DCD028612E8E.quest_subtitle: "&7Catch Thundurus"
	quest.4361DCD028612E8E.title: "&dThundurus"
	quest.43BCE73F938D8E47.quest_desc: [
		"&fWhen travelling far from your home hearth, the &eSkillet&f serves as your portable field kitchen."
		""
		"&fHolding a skillet in hand while standing near a fire, magma block, or stove allows you to fry foods directly in the field. Alternatively, sneak-place the skillet on top of any heat source to use it as a stationary searing station."
		""
		"&aTip:&f Skillets also function as heavy defensive implements, dealing heavy knockback in emergencies."
	]
	quest.43BCE73F938D8E47.quest_subtitle: "&7Searing dishes on the trail"
	quest.43BCE73F938D8E47.title: "&eField Cooking: The Skillet"
	quest.4420B323B9EF1D40.quest_desc: [
		"&fCatch &dUxie&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.4420B323B9EF1D40.quest_subtitle: "&7Catch Uxie"
	quest.4420B323B9EF1D40.title: "&dUxie"
	quest.44249DA3F558DA42.quest_desc: [
		"&fThe dimension is vast, rugged, and disorienting without celestial navigation. The &eSeeking Eye&f is your indispensable navigational compass."
		""
		"&bRight-click the Seeking Eye&f to open the celestial &dStar Map&f. Select a target structure—such as the &eGolem Forge&f or the &eCursed Garden&f—and the eye will manifest in the world, floating alongside you and pointing directly toward your destination!"
		""
		"&aInteract with the hovering eye at any time to recall it back into your inventory."
	]
	quest.44249DA3F558DA42.quest_subtitle: "&7The Seeking Eye and the Star Map"
	quest.44249DA3F558DA42.title: "&dChart the Constellations"
	quest.444407B640A0F672.quest_desc: [
		"&fBy elevating the Dormant Relic to &bLevel 4&f under the clear light of day, solar power floods the core, transforming it into the &eRighteous Relic&f."
		""
		"&fBestows the &bRighteous Standard&f ability: strikes heal your wounds and bolster allies with solar vitality."
	]
	quest.444407B640A0F672.quest_subtitle: "&7Consecrated at dawn at Awakening Level 4"
	quest.444407B640A0F672.title: "&eRighteous Relic"
	quest.44445CE4DFB6CE7F.quest_desc: [
		"&fIn the shadowy skies above the deepest abyssal canyons drift &cSeekers&f—sinister, floating cephalopod predators that dive upon unsuspecting wanderers."
		""
		"&fBring a dependable bow or crossbow to shoot them down from the heavens. Defeated Seekers drop flexible, barbed &eSeeker Tentacles&f."
	]
	quest.44445CE4DFB6CE7F.quest_subtitle: "&7Hunting Seekers in the dark abyss"
	quest.44445CE4DFB6CE7F.title: "&3Terrors of the Deep Void"
	quest.4446F3DF604F4730.quest_desc: [
		"&fDeep underground between Y-level 30 and the bedrock layer, massive hollowed caverns generate with vast mounds of gold piles, silver piles, and treasure chests."
		""
		"&fCurled in the center of the hoard sleeps a &cStage 4 or 5 Dragon&f. These behemoths possess hundreds of hit points and breath attacks that disintegrate entire stone caverns in seconds."
		""
		"&eTargeting the Egg:&f Only &bFemale Dragons&f drop &eDragon Eggs&f. Verify the wings: if they are smooth and unpatterned with curved horns, she carries the seed of the next generation!"
	]
	quest.4446F3DF604F4730.quest_subtitle: "&7Where ancient mothers sleep upon gold"
	quest.4446F3DF604F4730.title: "&cSubterranean Dens: Tier 4 and 5"
	quest.444CE22D5A5657FD.quest_desc: [
		"&fThe &dRunic Tablet&f is an ancient stone cipher discovered throughout dungeon chests, bastion remnants, ancient cities, and structure loot across the dimensions."
		""
		"&fThis artifact serves three vital purposes:"
		"&b1.&f Serves as the smithing template to forge &eRunic Weapons&f."
		"&b2.&f Feeds the &eRunic Forge&f to awaken dormant unique weapons."
		"&b3.&f Functions as the sacrificial repair material for built-in unique blades on an anvil."
		""
		"&cNotice:&f Safeguard every tablet you unearth; your endgame weaponry relies heavily on them!"
	]
	quest.444CE22D5A5657FD.quest_subtitle: "&7Ancient engravings brimming with forgotten sorcery"
	quest.444CE22D5A5657FD.title: "&d★ The Runic Tablet"
	quest.447C1C4CD5594BF5.quest_desc: [
		"&fConventional bows suffer from severe drop-off against aerial Aether foes like Zephyrs. &6Dart Shooters&f provide the answer."
		""
		"&fConstructed from Skyroot and Zanite or Golden Amber, Dart Shooters fire darts on a perfectly &bstraight trajectory&f with rapid velocity."
		""
		"&aCraft a Golden Dart Shooter and a quiver of darts to snipe high-altitude threats with pinpoint accuracy."
	]
	quest.447C1C4CD5594BF5.quest_subtitle: "&7Pinpoint Ballistics with Flat Trajectories"
	quest.447C1C4CD5594BF5.title: "&6Aether Sniping"
	quest.44985097C9FB67A6.quest_desc: [
		"&fThe Otherside's subterranean crust consists of two dominant geological formations:"
		""
		"&b• Sculk Stone:&f A teal-tinted bedrock alternative that blankets the upper caverns and hills."
		"&b• Gloomslate:&f An ultra-dense, pitch-black metamorphic stone forming immense monolithic columns and the lower foundation of the dimension."
		""
		"&fBoth can be smelted, polished, cut, and shaped into dark architectural blocks, tiles, and walls."
	]
	quest.44985097C9FB67A6.quest_subtitle: "&7Sculk Stone and Gloomslate"
	quest.44985097C9FB67A6.title: "&8Foundation of Shadows"
	quest.449B22795C6012B2.quest_desc: [
		"&fA mystical deep-violet figurine glowing with shimmering dusk light."
		""
		"&fAttuned to arcane sorcery, shadow arts, evasion, and rogue trickery."
		""
		"&fGrants uncanny awareness, empowering both illusion magic and lethal stealth strikes."
	]
	quest.449B22795C6012B2.quest_subtitle: "&dThe Shadowed Idol of the Void"
	quest.449B22795C6012B2.title: "&5Tanzanite Jewel Figurine"
	quest.44A8C4D8EA3022C1.quest_desc: [
		"&fFind a &eRaid Den&f and inspect its lobby. Check the tier and participation rules, prepare your Pokémon, then join the encounter."
		"&fHigher tiers are more demanding. Start with a low-tier raid and coordinate with other players rather than assuming your ordinary wild-battle team will cover every threat."
		"&7This first milestone records joining a raid. Victory is tracked separately below."
	]
	quest.44A8C4D8EA3022C1.quest_subtitle: "&7Read the lobby before committing your team."
	quest.44A8C4D8EA3022C1.title: "&6Enter a Raid"
	quest.44D19FF8528A1430.quest_desc: [
		"&fObtain &eBlank-Z&f."
		""
		"&fIt represents the unaligned stage of Z-Crystal progression before you move into type-based and signature crystals."
	]
	quest.44D19FF8528A1430.quest_subtitle: "&7The neutral crystal before Z-Power becomes specialized"
	quest.44D19FF8528A1430.title: "&eBlank-Z"
	quest.44E68F0292B94881.quest_desc: [
		"&fThese four bosses are independent discoveries. Read the entry for your destination, bring healing and protect your return route before starting."
		"&fTheir unique drops are ingredients for the mod's utility equipment. Inspect those uses in EMI after a victory instead of treating the drops as trophies to discard."
		"&7The quests detect boss-defeat advancements. No summoning block needs to be collected."
	]
	quest.44E68F0292B94881.quest_subtitle: "&7Pick the encounter that suits your journey."
	quest.44E68F0292B94881.title: "&bFour Dangerous Discoveries"
	quest.456B738EB8220023.quest_desc: [
		"&fAn ominous curved harvesting blade repurposed for battlefield slaughter. Sweeps across a wide forward arc."
		""
		"&fFeatures the &bExecution&f implicit: enemies who fall below a certain health threshold have a chance to be slain instantly!"
	]
	quest.456B738EB8220023.quest_subtitle: "&7Sweeping reaper blade executing weakened foes"
	quest.456B738EB8220023.title: "&fDiamond Scythe"
	quest.45993BD3633E4F2C.quest_desc: [
		"&fTraditional crops will not grow easily in Aether soil, but native flora flourishes in abundance:"
		""
		"&9• Blue Berries:&f Harvested directly from Berry Bushes. A fast snack to keep hunger satiated."
		"&d• Enchanted Berries:&f Transmuting Blue Berries on an Altar creates enchanted food that restores 8 hunger points and replenishes health."
		"&f• White Apples:&f Found on rare Crystal/Fruit canopies. Eating a White Apple immediately &ccures lethal Aether Poison&f!"
	]
	quest.45993BD3633E4F2C.quest_subtitle: "&7Foraging Sustenance in Thin Air"
	quest.45993BD3633E4F2C.title: "&aBounties of the Bush"
	quest.45A8D358B0904818.quest_desc: [
		"&fCatch &dKyogre&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.45A8D358B0904818.quest_subtitle: "&7Catch Kyogre"
	quest.45A8D358B0904818.title: "&dKyogre"
	quest.45DFC05D13751989.quest_desc: [
		"&fCraft a &eHolo Battle Tower&f using the Healing Machine, Monitor and PC recipe shown in EMI. Open it and read the &bGuide&f tab before selecting a format."
		"&fChoose your team mode and battle format before locking the team. Start with Singles if you want to learn one opposing threat at a time."
		"&fTower battles award &eBP&f for its shop. Review the current rules: options such as allowing legendaries can change rewards and leaderboard eligibility."
		"&7This quest detects your terminal. The tower tracks its own floors, streaks and records."
	]
	quest.45DFC05D13751989.quest_subtitle: "&7Build the terminal, then configure your run."
	quest.45DFC05D13751989.title: "&6The Battle Tower"
	quest.46165DB0C6A28661.quest_desc: [
		"&fThe ultimate flight upgrade in Minecraft. Fuses a vanilla &eElytra&f with a &dReinforced Echo Shard&f, a &bSoul Crystal&f, &eSoul Dust&f, and &eSculk Bones&f."
		""
		"&b• Enhanced Protection:&f Possesses 956 durability and provides 3 armor points."
		"&b• Built-in Jet Propulsion:&f Press the boost key while gliding to instantly surge forward at supersonic velocity—completely eliminating the need for Firework Rockets!"
		""
		"&aTip:&f Enchant it with Unbreaking III and Mending for perpetual, effortless aerial supremacy."
	]
	quest.46165DB0C6A28661.quest_subtitle: "&7Forge the Otherside flight upgrade"
	quest.46165DB0C6A28661.title: "&3Soul Elytra"
	quest.4620BB58A4FE738C.quest_desc: [
		"&fThe mystical resources of the Twilight Forest can be forged into supernatural kitchen hardware."
		""
		"&eFiery Cooking Pot:&f Forged with fiery ingots, this pot is self-heating! It requires no stove or campfire underneath and simmers Twilight Forest recipes noticeably faster than a standard pot."
		""
		"&eFiery Knife:&f Slices with searing flame, automatically cooking butchered meats and igniting enemies when wielded in self-defense."
	]
	quest.4620BB58A4FE738C.quest_subtitle: "&7Forging the enchanted kitchen"
	quest.4620BB58A4FE738C.title: "&2Twilight Metallurgy: Fiery Cookware"
	quest.46520224C935FD77.quest_desc: [
		"&fObtain a &bTera Orb&f."
		""
		"&fThis is the central Trainer-side item used to activate Terastallization in battle."
	]
	quest.46520224C935FD77.quest_subtitle: "&7The Trainer-side key item for Terastallization"
	quest.46520224C935FD77.title: "&bTera Orb"
	quest.466FD9A99B9395D9.quest_desc: [
		"&fCatch &dRegieleki&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.466FD9A99B9395D9.quest_subtitle: "&7Catch Regieleki"
	quest.466FD9A99B9395D9.title: "&dRegieleki"
	quest.4675B6328328B627.quest_desc: [
		"&fVanilla chests and barrels have served Minecraft well, but modern modpacks require far greater capacity and intelligence."
		""
		"&eSophisticated Storage&f reinvents base containers from the ground up:"
		"&f• &bIntegrated Search Bar&f: Highlight matching items instantly in the GUI."
		"&f• &bSorting and Memory Slots&f: Lock item slots so designated resources always return to the same position."
		"&f• &bUpgrade Sockets&f: Equip compacting, hoppers, magnets, and stack multipliers directly onto containers."
		""
		"&aBoth chests and barrels function identically in features—choose whichever aesthetic fits your build!&f"
	]
	quest.4675B6328328B627.quest_subtitle: "&7Chests and barrels re-engineered"
	quest.4675B6328328B627.title: "&fNext-Generation Crates"
	quest.467FFB8B41D8866E.quest_desc: [
		"&fCrafting a complete suit and tool arsenal from &5Enchanted Gravitite&f grants god-like kinetic abilities:"
		""
		"&b• Gravitite Tools:&f &bRight-clicking&f a block with a Gravitite tool will levitate the targeted block into the air, allowing you to lift ore veins or build structures effortlessly."
		"&a• Gravitite Armor:&f Wearing a full set of Gravitite Armor provides monumental diamond-equivalent defense, negates fall damage, and allows you to perform an &ehigh jump&f by pressing and holding the jump key!"
	]
	quest.467FFB8B41D8866E.quest_subtitle: "&7Soar with Unrivaled Kinetic Power"
	quest.467FFB8B41D8866E.title: "&dGravitational Mastery"
	quest.468F55C3E20B880C.quest_desc: [
		"&fDeserts are governed by predatory subterranean &6Death Worms&f. They burrow beneath the sand at startling speed before bursting through the surface to swallow prey whole."
		""
		"&fWorms come in yellow, white, and crimson varieties, scaling from small juvenile worms to colossal sandworms hundreds of blocks long."
		""
		"&fCollect &eDeath Worm Chitin&f to craft heavy desert armor that protects against heat and drowning in sand. Their severed &eDeath Worm Tongue&f crafts a multi-directional grappling &eDeath Worm Gauntlet&f."
	]
	quest.468F55C3E20B880C.quest_subtitle: "&7Vibrations in the shifting sands"
	quest.468F55C3E20B880C.title: "&6Dunes of Terror: Death Worm"
	quest.468F6C87C11855BF.quest_desc: [
		"&fDeep along the treacherous underbelly of floating islands rests the rarest natural mineral of the Aether: &dGravitite Ore&f."
		""
		"&cDanger:&f Gravitite is subject to negative gravitational attraction! If there is no solid block above it when updated or broken without care, it will fall &cupward&f into the open sky and be lost forever!"
		""
		"&fAlways place a solid ceiling over Gravitite before extracting it. You will require a &dZanite Pickaxe&f or stronger to break it."
	]
	quest.468F6C87C11855BF.quest_subtitle: "&7The Ore that Ascends into the Void"
	quest.468F6C87C11855BF.title: "&dDefying Gravity"
	quest.46911D0A86CD73E9.quest_desc: [
		"&fWith the &eOrb of Prophecy&f in your grasp, clear the choking vines away from the &eChiseled Voidstone&f frame of the portal ruins."
		""
		"&bRight-click the portal frame with the Orb of Prophecy&f to ignite the passage. A shimmering curtain of cosmic blue flame will tear open space, connecting your world directly to the Starlight Dimension."
		""
		"&cCaution:&f You can rebuild the portal anywhere later using &eChiseled Voidstone&f in the standard vertical portal frame structure, but make sure to anchor your initial arrival point safely!"
	]
	quest.46911D0A86CD73E9.quest_subtitle: "&7Step across the threshold of infinity"
	quest.46911D0A86CD73E9.title: "&bIgniting the Gateway"
	quest.46EEF3FD7CA12039.quest_desc: [
		"&fCatch &dOkidogi&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.46EEF3FD7CA12039.quest_subtitle: "&7Catch Okidogi"
	quest.46EEF3FD7CA12039.title: "&dOkidogi"
	quest.4703B6683F4CB946.quest_desc: [
		"&fHidden within fetid swamps and marsh caverns lies the ancient &2Hydra&f. It begins combat with three heads spewing acidic poison spit and caustic breath."
		""
		"&cThe Decapitation Trap:&f Severing a hydra's head causes TWO more heads to rapidly sprout in its place unless the wound is immediately cauterized with fire or explosive force!"
		""
		"&fDefeating the beast grants the invaluable &dHydra Heart&f. Simply keeping this pulsating organ in your hotbar grants passive, permanent health regeneration that scales stronger the lower your health drops."
	]
	quest.4703B6683F4CB946.quest_subtitle: "&7Cut off one head, two more shall rise"
	quest.4703B6683F4CB946.title: "&2The Multi-Headed Nightmare"
	quest.471B1035A6EB6B26.quest_desc: [
		"&fCatch &dCosmoem&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.471B1035A6EB6B26.quest_subtitle: "&7Catch Cosmoem"
	quest.471B1035A6EB6B26.title: "&dCosmoem"
	quest.47229389571AA876.quest_desc: [
		"&fAn ender-infused arrowhead wrapped in ethereal feathers."
		""
		"&fPerk mechanic: Ranged arrow hits have a chance to inflict &dLevitation&f on targets, launching them into the air."
		""
		"&fRemoves dangerous melee threats from the fight and subjects them to catastrophic fall damage."
	]
	quest.47229389571AA876.quest_subtitle: "&dUpward Flight"
	quest.47229389571AA876.title: "&dGreater Perk: Anti-Gravity Shot"
	quest.47BC0B64716CCDB0.quest_desc: [
		"&fForget tossing valuable loot on the ground when your inventory overflows. The &eSophisticated Backpack&f is a fully featured, wearable expansion of your personal storage."
		""
		"&bKey Features&f:"
		"&f• Wear it directly in your chest or Curios/Trinkets &bBack&f slot."
		"&f• Press the &bOpen Backpack keybind&f (check Controls) to view its contents without holding it."
		"&f• Can be placed in-world as a physical container and colored with dyes."
		"&f• Features an integrated search bar and sort buttons."
		""
		"&aEquip this rucksack and start outfitting it with specialized upgrade modules.&f"
	]
	quest.47BC0B64716CCDB0.quest_subtitle: "&7Your very first wearable inventory"
	quest.47BC0B64716CCDB0.title: "&fThe Wanderer's Rucksack"
	quest.47F50E803E8C8D08.quest_desc: [
		"&fEternal Starlight introduces unique tool accessories called &eStraps&f to enhance your culinary equipment via crafting recipes shown in &bEMI&f."
		""
		"&eStarfire Flower Strap:&f Attaches to your skillet to imbue prepared dishes with bonus saturation. &cNote:&f saturation-boosted foods stack separately from their unmodified versions."
		""
		"&eThermal Springblade Strap:&f Attaches to your kitchen knife to provide automatic smelting on broken blocks and instant culinary processing when cutting ingredients on the board."
	]
	quest.47F50E803E8C8D08.quest_subtitle: "&7Upgrading your kitchen tools"
	quest.47F50E803E8C8D08.title: "&9Culinary Straps and Modifications"
	quest.4805AF5B5A60F9AD.quest_desc: [
		"&fCatch &dHeatran&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.4805AF5B5A60F9AD.quest_subtitle: "&7Catch Heatran"
	quest.4805AF5B5A60F9AD.title: "&dHeatran"
	quest.480A38705E5CFDA6.quest_desc: [
		"&fMega Evolution is a temporary battle transformation available to compatible Pokémon. It requires a &dKeystone&f on the Trainer side and the correct species-specific &dMega Stone&f for the Pokémon."
		""
		"&fThis branch walks through the core equipment before asking you to perform a real Mega Evolution. The large stone collections are optional mastery goals, not progression walls."
	]
	quest.480A38705E5CFDA6.quest_subtitle: "&7A temporary evolution powered by a Trainer, a Keystone and a matching Mega Stone"
	quest.480A38705E5CFDA6.title: "&d✦ Mega Evolution"
	quest.482A4A00F13CAC13.quest_desc: [
		"&fAn intricately sculpted idol carved from warm golden citrine."
		""
		"&fResonates with lightning and holy powers, augmenting holy paladin spells, lightning incantations, and radiant vitality."
		""
		"&fEquip in your figurine slot to harmonize divine magic and righteous thunder strikes."
	]
	quest.482A4A00F13CAC13.quest_subtitle: "&6The Golden Idol of Thunder and Grace"
	quest.482A4A00F13CAC13.title: "&eCitrine Jewel Figurine"
	quest.4844EED3532CB9FA.quest_desc: [
		"&fRegister &e50 Ground-type Pokémon&r&f in your Pokédex."
		""
		"&7Dual-type Pokémon count when Ground is one of their types."
	]
	quest.4844EED3532CB9FA.quest_subtitle: "&7Register 50 Ground-type Pokémon"
	quest.4844EED3532CB9FA.title: "&6Ground Mastery&r"
	quest.487FBCE49BE1C48C.quest_desc: [
		"&fAmong the rarest rewards retrieved from boss encounters and secret dungeon vaults is the &dLife Shard&f."
		""
		"&fConsuming a Life Shard permanently increases your maximum health by &aone full heart&f (2 HP), persisting across deaths!"
		""
		"&fYou can consume up to 10 Life Shards in total, permanently doubling your health pool from 20 HP to a massive 40 HP."
		""
		"&bYou have mastered every stratum, beast, and sovereign of the Aether. The sky realm is yours."
	]
	quest.487FBCE49BE1C48C.quest_subtitle: "&7Permanent Expansion of the Soul"
	quest.487FBCE49BE1C48C.title: "&dHeart of the Heavens"
	quest.489FD318A06192E0.quest_desc: [
		"&fObtain a &5Dynamax Band&f."
		""
		"&fThis is the Trainer-side equipment used to access the Dynamax battle phenomenon."
	]
	quest.489FD318A06192E0.quest_subtitle: "&7The Trainer-side key item for Dynamax battles"
	quest.489FD318A06192E0.title: "&5Dynamax Band"
	quest.48B9FDE4DBA038F9.quest_desc: [
		"&fCatch &dReshiram&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.48B9FDE4DBA038F9.quest_subtitle: "&7Catch Reshiram"
	quest.48B9FDE4DBA038F9.title: "&dReshiram"
	quest.491B761E621DF5D5.quest_desc: [
		"&fUnlock the Silver Treasure Chest to obtain the most versatile relics in the entire mod:"
		""
		"&d• Valkyrie Armor and Cape:&f Wearing the complete set bestows &afull creative-style flight&f and extended gliding mobility!"
		"&e• Holy Sword:&f Deals devastating bonus holy damage against undead and nether fiends."
		"&a• Regeneration Stone:&f Passively restores health over time when equipped in your accessories."
		"&7• Invisibility Cloak:&f Renders the wearer completely imperceptible to monsters."
	]
	quest.491B761E621DF5D5.quest_subtitle: "&7Spoils of the Valkyrie Throne"
	quest.491B761E621DF5D5.title: "&fGifts of the Silver Vault"
	quest.494CDAD1A129E44C.quest_desc: [
		"&fThe Nether is inhospitable to mundane agriculture, but &bMy Nether's Delight&f introduces volcanic biology tailored to extreme heat."
		""
		"&eResurgent Soil&f is Nether farmland that rejects ordinary water. Instead, it seeks proximity to &blava and heat sources&f to maintain its hydration and support Nether crops."
		""
		"&eBullet Peppers&f represent the sharp, fiery seasonings cultivated from this volcanic soil. Check &bEMI&f to discover their use in spicy stews and roasting marinades."
	]
	quest.494CDAD1A129E44C.quest_subtitle: "&7Farming in volcanic heat"
	quest.494CDAD1A129E44C.title: "&4Nether Agriculture: Resurgent Soil"
	quest.499596B20FB04724.quest_desc: [
		"&fRunning back to your storage terminal every time you need building blocks gets old fast. The &dWireless Terminal&f untethers you from the wall."
		""
		"&bUsage&f:"
		"&f• Shift-right click the terminal on your placed &aCrafting Terminal&f or Storage Terminal to link them."
		"&f• Right-click in your hand to open your warehouse inventory anywhere within transmission range!"
		"&f• Range can be extended by placing a vanilla Beacon near the inventory connector."
		""
		"&aBuild around your base with continuous access to all your building materials.&f"
	]
	quest.499596B20FB04724.quest_subtitle: "&7Accessing base storage from across the yard"
	quest.499596B20FB04724.title: "&dAirborne Signals"
	quest.49A4AA72407D550F.quest_desc: [
		"&aExp Candy&f instantly increases your pokemons xp."
	]
	quest.49A4AA72407D550F.quest_subtitle: "Obtain one of every exp candy"
	quest.49A4AA72407D550F.title: "&dExp candy"
	quest.49AD4BFB420660F1.quest_desc: [
		"&fAn unmelting icicle radiating a biting aura of winter."
		""
		"&fProc effect: Frost spells have a chance to proc &bFrost Spell Power&f, freezing targets faster and dealing boosted cold damage."
		""
		"&fInvaluable for control wizards seeking to immobilize and shatter dungeon mobs."
	]
	quest.49AD4BFB420660F1.quest_subtitle: "&bFrozen Dominion"
	quest.49AD4BFB420660F1.title: "&bMedium Glacial Relic"
