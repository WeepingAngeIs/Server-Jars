	]
	quest.4B06D351390ED20E.quest_subtitle: "&7Catch Tornadus"
	quest.4B06D351390ED20E.title: "&dTornadus"
	quest.4B19DBFFFA7F1FE2.quest_desc: [
		"&fPrepare a healthy team before approaching an &cAlpha Pokemon&f. Look for the unusually large Pokemon with glowing red eyes."
		"&fRead this briefing, then &edefeat five Alpha Pokemon&f. Ordinary Pokemon do not count toward this objective."
		""
	]
	quest.4B19DBFFFA7F1FE2.quest_subtitle: "&7Giant Predators of the Wilderness"
	quest.4B19DBFFFA7F1FE2.title: "&cWild Dominance: Cobblemon Alphas"
	quest.4B1A9D2D0E307A21.quest_desc: [
		"&fWelcome to &eRelics (RPG Series)&f!"
		""
		"&fThroughout ancient dungeons, forgotten ruins, and boss hoards, you will discover powerful &dRelics&f."
		"&fThese artifacts equip directly into your &bTrinket or Curio accessory slots&f, granting passive attributes, dynamic combat procs, or active abilities."
		""
		"&fRelics span four progressive tiers:"
		"&f• &7Lesser&f: Early-game talismans offering passive stats, basic procs, and combat roll utility."
		"&f• &bMedium and Figurines&f: Mid-game jewels granting stacking battle procs and elemental alignments."
		"&f• &dGreater&f: Build-defining artifacts with game-changing perks, stuns, and battle trances."
		"&f• &6Superior&f: Apex team-wide tactical zone banners that turn the tide of severe raid battles."
		""
		"&aExplore dungeons, slay champions, and assemble your ultimate relic loadout!"
		""
		"&fRead a tier introduction, then browse the relics directly beneath it. The four collections are separated by &eLesser&f, &eMedium&f, &eGreater&f and &eSuperior&f."
		"&7The collection milestone at the bottom still requires the listed relic goals."
	]
	quest.4B1A9D2D0E307A21.quest_subtitle: "&eTrinkets, Curios, and Combat Enhancements"
	quest.4B1A9D2D0E307A21.title: "&6✦ The Relics of Adventure ✦"
	quest.4B22D3081C8EAEE9.quest_desc: [
		"&fAn ironclad combat medallion scarred by countless battles."
		""
		"&fProc effect: Melee attacks have a chance to proc a notable increase to &ePhysical Attack Damage&f."
		""
		"&fAllows melee warriors to naturally escalate their damage during prolonged duels against tanky elites and mini-bosses."
	]
	quest.4B22D3081C8EAEE9.quest_subtitle: "&cCrushing Blows"
	quest.4B22D3081C8EAEE9.title: "&bMedium Heavy Strike Relic"
	quest.4B2CB1500216AE27.quest_desc: [
		"&fIn the Galar region, palaeontologist Cara Liss disregarded conventional taxonomy entirely, combining mismatched top and bottom fossil halves:"
		""
		"&e• Bird + Drake&f -> &bDracozolt&f (Electric/Dragon)"
		"&e• Bird + Dino&f -> &bArctozolt&f (Electric/Ice)"
		"&e• Fish + Drake&f -> &cDracovish&f (Water/Dragon with the terrifying Fishious Rend)"
		"&e• Fish + Dino&f -> &bArctovish&f (Water/Ice)"
		""
		"&fCollect all four fossilized halves—&eBird&f, &eDino&f, &eDrake&f, and &eFish&f—and combine them in your restoration laboratory to resurrect these competitive legends!&f"
	]
	quest.4B2CB1500216AE27.quest_subtitle: "&7Cara Liss's Bizarre Hybrid Monsters"
	quest.4B2CB1500216AE27.title: "&dGalar Mismatches: The Four Chimera Halves"
	quest.4B4A1854ECA6852B.quest_desc: [
		"&fCatch &dTapu Fini&f to add this rare Pokémon to your legendary field record."
		"&7The capture task completes automatically."
	]
	quest.4B4A1854ECA6852B.quest_subtitle: "&7Catch Tapu Fini"
	quest.4B4A1854ECA6852B.title: "&dTapu Fini"
	quest.4B5619E058AC940F.quest_desc: [
		"&fDragonsteel Armor is the pinnacle of the Fire Dragon Forge branch. Each piece grants knockback resistance, while a complete set greatly reduces damage from dragon elements."
		"&fCraft the &eFire Dragonsteel Chestplate&f to anchor this endgame defensive loadout. It is powerful, but it does not grant total knockback, explosion or elemental immunity."
	]
	quest.4B5619E058AC940F.quest_subtitle: "&7Armor that laughs at cataclysms"
	quest.4B5619E058AC940F.title: "&6The Sovereign Aegis"
